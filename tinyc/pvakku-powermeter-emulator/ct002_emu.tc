// Marstek CT002 / CT003 emulator for Tasmota, UDP port 12345.
// Feeds a Venus / Jupiter / B2500 from the SML meter. Relay mode only.
// Docs: https://ottelo9.github.io/tasmota-sml-script/ct002/
// Needs ESP32, TinyC in slot 0, USE_SML.
//
// Frame:    SOH STX <total-len> |f1|..|fN ETX <xor-hex>
// Length:   whole packet incl. length digits and checksum
// Checksum: XOR over SOH..ETX, 2 lowercase hex chars
// Request:  |batt-type|batt-mac|ct-type|ct-mac|phase|power[|participate]
// Response: |ct-type|ct-mac|batt-type|batt-mac| 20 numbers (+4 on CT003)
// Protocol source: tomquist/AstraMeter, docs/ct002-ct003-protocol.md
//
// Not implemented: the app's MQTT frames (cd=1/cd=4). The HTTP cloud push was
// built and measured — accepted, but the app still showed "--", so it is gone.
// The app's live view comes over MQTT only; a fake CT there is always offline.

#define NSLOT     9        // consumer slots — the real CT keeps 9
#define RXMAX   320        // request buffer  (a request is ~55 B)
#define TXMAX   420        // response buffer (a response is ~140 B)

// char[] not #define: a #define stays an Identifier in the AST, which
// syscalls taking a const-pool string must not be handed.
char mk_host[] = "eu.hamedata.com";

// Online help, EN/DE switch on the page. Anchor appended per section:
// sprintf(buf, "...%s#ct'>i</a>", helpa)
char helpa[] = " <a class='i' target='_blank' href='https://ottelo9.github.io/tasmota-sml-script/ct002/";

// ─── Persistent settings ───────────────────────────────────────────────────
persist int  ct_kind;          // 0 = CT002 (HME-4), 1 = CT003 (HME-3)
persist int  ct_port;          // UDP listen port (12345)
persist int  ct_rssi;          // Wi-Fi RSSI reported to the batteries [dBm]
persist int  ct_ttl;           // consumer timeout [s], 0 = adaptive (~2 polls)
persist int  pwroffset;        // zero-feed offset [W]
persist int  ctrlopt;          // regulator shaping 0/1 (as in the .tas scripts)
persist int  ph3;              // 1 = per-phase values from smlGet(4/5/6)
persist char ct_mac[16];       // CT MAC, 12 hex lowercase. Empty = answer all
persist char mk_mail[64];      // Marstek account mail (registration only)
persist watch int sml_activ;   // SML enable (mirrors tasm_rule)
persist watch int meter_sel;   // SML descriptor picker
persist watch int rx_pin;      // SML serial RX (-1 = unset)
persist watch int tx_pin;      // SML serial TX (-1 = unset)
persist watch int smlfo;       // SML median filter 0/1

// ─── Consumer table (one row per battery, keyed by its MAC) ────────────────
char s_mac[NSLOT][16];
int  s_used[NSLOT];
int  s_ph[NSLOT];              // 0 = '0'/unassigned, 1=A, 2=B, 3=C, 4=D(combined)
int  s_pwr[NSLOT];             // last reported power [W], + = discharge
int  s_part[NSLOT];            // participate flag (field 7, default 1)
int  s_last[NSLOT];            // millis() of the last request
int  s_iv[NSLOT];              // measured poll interval [ms]

// ─── Runtime ───────────────────────────────────────────────────────────────
int  pa; int pb; int pc; int ptot;   // grid power reported to the batteries [W]
int  info_idx;                       // response index 0..255, wraps

// Filled by aggCalc(), read by the response builder.
int  g_nbA; int g_nbB; int g_nbC; int g_nbD; int g_live;
int  g_cx; int g_cA; int g_cB; int g_cC; int g_cD;    // charge    (< 0)
int  g_dx; int g_dA; int g_dB; int g_dC; int g_dD;    // discharge (> 0)
int  once_udp;                       // UDP socket bound once
int  rx_cnt; int tx_cnt; int bad_cnt;
char hexd[] = "0123456789abcdef";
char cttype[8];                      // "HME-4" or "HME-3"

char rxb[RXMAX];                     // UDP receive buffer
char txb[TXMAX];                     // outgoing frame
char innb[TXMAX];                    // frame body ("|f1|f2|...")

// Parsed request fields (globals, not locals — keeps the VM stack small)
char q_btype[16];                    // battery type, e.g. "HMG-50"
char q_bmac[16];                     // battery MAC
char q_cttype[16];                   // CT type the battery asks for
char q_ctmac[16];                    // CT MAC the battery asks for
char q_ph[8];                        // phase char
char q_pwr[16];                      // signed power
char q_part[8];                      // participate (optional field 7)

// ─── Marstek cloud registration ────────────────────────────────────────────
char mk_pass[64];                    // NOT persisted — cleared after use
char reg_msg[128];                   // status line shown in the web UI
char mk_tok[96];                     // session token
char umail[96];                      // url-encoded mailbox
char req[600];                       // request line + headers
char scanb[600];                     // scratch for parsing
char http_resp[2048];                // API response body
int  reg_req;                        // 0 idle, 1 = login+scan, 2 = create
int  reg_busy;
int  pass_ts;                        // millis() when the password was set
int  do_save; int do_clear;
int  allow_create;                   // safety checkbox for the cloud write

// ─── CT protocol ───────────────────────────────────────────────────────────

// Total frame length. The length digits count towards the length, so the
// digit count is resolved iteratively (as AstraMeter's compute_length).
int frameTotal(int innerlen) {
    int base = innerlen + 5;          // SOH + STX + ETX + 2 checksum chars
    if (base + 1 < 10)  return base + 1;
    if (base + 2 < 100) return base + 2;
    return base + 3;
}

// Wrap `innerbuf` (must start with '|') into a complete CT frame in `out`.
void ctFrame(char out[], char innerbuf[]) {
    int total = frameTotal(strlen(innerbuf));
    sprintf(out, "..%d%s", total, innerbuf);   // ".." reserves SOH/STX
    out[0] = 1;                                // SOH
    out[1] = 2;                                // STX
    int n = strlen(out);
    out[n] = 3;                                // ETX
    int x = 0;
    int i = 0;
    for (i = 0; i <= n; i = i + 1) {           // XOR over SOH..ETX inclusive
        x = x ^ out[i];
    }
    out[n + 1] = hexd[(x >> 4) & 15];
    out[n + 2] = hexd[x & 15];
    out[n + 3] = 0;
}

// Verify the request checksum. Real CTs emit uppercase hex and sometimes a
// leading space for small values, so the comparison stays tolerant.
int ctCheck(int n) {
    if (n < 8) return 0;
    if (rxb[n - 3] != 3) return 0;             // ETX where it belongs
    int x = 0;
    int i = 0;
    for (i = 0; i <= n - 3; i = i + 1) {
        x = x ^ rxb[i];
    }
    int hi = hexd[(x >> 4) & 15];
    int lo = hexd[x & 15];
    int ghi = rxb[n - 2];
    int glo = rxb[n - 1];
    if (ghi >= 65 && ghi <= 70) ghi = ghi + 32;   // 'A'-'F' -> lowercase
    if (glo >= 65 && glo <= 70) glo = glo + 32;
    if (glo != lo) return 0;
    if (ghi == hi) return 1;
    if (ghi == 32 && hi == 48) return 1;          // ' ' instead of '0'
    return 0;
}

// Copy token `n` (1-based, '|' separated) of the request into dst and cut it
// at the first control character — the last field carries the ETX + checksum.
int reqTok(char dst[], int n) {
    int l = strToken(dst, rxb, '|', n);
    int i = 0;
    for (i = 0; i < l; i = i + 1) {
        if (dst[i] < 32) {
            dst[i] = 0;
            return i;
        }
    }
    return l;
}

int slotFind(char macbuf[]) {
    int i = 0;
    for (i = 0; i < NSLOT; i = i + 1) {
        if (s_used[i] == 1) {
            if (strcmp(s_mac[i], macbuf) == 0) return i;
        }
    }
    return -1;
}

int slotAlloc(char macbuf[]) {
    int i = 0;
    for (i = 0; i < NSLOT; i = i + 1) {
        if (s_used[i] == 0) {
            s_used[i]  = 1;
            s_ph[i]    = 0;
            s_pwr[i]   = 0;
            s_part[i]  = 1;
            s_iv[i]    = 1000;
            s_last[i]  = millis();
            strcpy(s_mac[i], macbuf);
            addLog("CT002: slot %d new: %s", i, macbuf);
            return i;
        }
    }
    return -1;
}

// Drop consumers that stopped polling — the real CT evicts after ~1-2 cycles.
void slotAge() {
    int now = millis();
    int i = 0;
    for (i = 0; i < NSLOT; i = i + 1) {
        if (s_used[i] == 1) {
            int ttl = ct_ttl * 1000;
            if (ttl <= 0) {
                ttl = s_iv[i] * 2 + 500;
                if (ttl < 5000) ttl = 5000;
            }
            if (now - s_last[i] > ttl) {
                s_used[i] = 0;
                addLog("CT002: slot %d (%s) expired", i, s_mac[i]);
            }
        }
    }
}

// Build the buckets over all live, participating slots.
void aggCalc() {
    g_nbA = 0; g_nbB = 0; g_nbC = 0; g_nbD = 0; g_live = 0;
    g_cx = 0; g_cA = 0; g_cB = 0; g_cC = 0; g_cD = 0;
    g_dx = 0; g_dA = 0; g_dB = 0; g_dC = 0; g_dD = 0;
    int i = 0;
    for (i = 0; i < NSLOT; i = i + 1) {
        if (s_used[i] == 1) {
            g_live = g_live + 1;
            if (s_part[i] != 0) {
                int p = s_pwr[i];
                int f = s_ph[i];
                if (f == 1) {
                    g_nbA = g_nbA + 1;
                    if (p < 0) g_cA = g_cA + p; else g_dA = g_dA + p;
                } else if (f == 2) {
                    g_nbB = g_nbB + 1;
                    if (p < 0) g_cB = g_cB + p; else g_dB = g_dB + p;
                } else if (f == 3) {
                    g_nbC = g_nbC + 1;
                    if (p < 0) g_cC = g_cC + p; else g_dC = g_dC + p;
                } else if (f == 4) {
                    g_nbD = g_nbD + 1;
                    if (p < 0) g_cD = g_cD + p; else g_dD = g_dD + p;
                } else {
                    // '0'/unassigned: answered, but never aggregated into a
                    // committed phase — the battery is still detecting its phase.
                    if (p < 0) g_cx = g_cx + p; else g_dx = g_dx + p;
                }
            }
        }
    }
}

// Build the response for one requesting battery into txb.
void ctBuild(char btype[], char bmac[], char reqctmac[]) {
    aggCalc();

    // Identity: CT first, battery second — the reverse of the request order.
    if (strlen(ct_mac) == 12) {
        sprintf(innb, "|%s|%s", cttype, ct_mac);
    } else {
        sprintf(innb, "|%s|%s", cttype, reqctmac);
    }
    sprintfAppend(innb, "|%s|%s", btype, bmac);
    sprintfAppend(innb, "|%d|%d|%d|%d", pa, pb, pc, ptot);                  // 5..8
    sprintfAppend(innb, "|%d|%d|%d|%d", g_nbA, g_nbB, g_nbC, g_nbD);        // 9..12
    sprintfAppend(innb, "|%d|%d", ct_rssi, info_idx);                       // 13..14
    sprintfAppend(innb, "|%d|%d|%d|%d|%d", g_cx, g_cA, g_cB, g_cC, g_cD);   // 15..19
    sprintfAppend(innb, "|%d|%d|%d|%d|%d", g_dx, g_dA, g_dB, g_dC, g_dD);   // 20..24
    if (ct_kind == 1) {
        // CT003 only: 4 tariff registers, everything on the peak tariff.
        // Wh assumed - the exact scaling is unconfirmed.
        int ein  = (int)(smlGet(2) * 1000.0);
        int eout = (int)(smlGet(3) * 1000.0);
        sprintfAppend(innb, "|0|%d|0|%d", ein, eout);           // 25..28
    }
    ctFrame(txb, innb);
}

// Handle one received datagram (already in rxb, `n` bytes).
void ctHandle(int n) {
    if (n < 12)  return;
    if (rxb[0] != 1) return;                   // SOH
    if (rxb[1] != 2) return;                   // STX
    if (ctCheck(n) == 0) {
        bad_cnt = bad_cnt + 1;
        return;
    }

    reqTok(q_btype,  2);
    reqTok(q_bmac,   3);
    reqTok(q_cttype, 4);
    reqTok(q_ctmac,  5);
    reqTok(q_ph,     6);
    reqTok(q_pwr,    7);
    int havepart = reqTok(q_part, 8);

    if (strlen(q_bmac) < 6) return;

    // Only answer for our own CT MAC (or the wildcard) once one is configured.
    strToLower(q_ctmac);
    if (strlen(ct_mac) == 12) {
        if (strcmp(q_ctmac, ct_mac) != 0) {
            if (strcmp(q_ctmac, "000000000000") != 0) return;
        }
    }

    int f = 0;                                  // phase bucket
    int c = q_ph[0];
    if (c == 'A' || c == 'a') f = 1;
    if (c == 'B' || c == 'b') f = 2;
    if (c == 'C' || c == 'c') f = 3;
    if (c == 'D' || c == 'd') f = 4;            // D = combined (合相), not a 4th phase

    int idx = slotFind(q_bmac);
    if (idx < 0) idx = slotAlloc(q_bmac);
    if (idx < 0) return;                        // table full — real CT holds 9 too

    int now = millis();
    int dt  = now - s_last[idx];
    if (dt > 100 && dt < 30000) s_iv[idx] = dt;
    s_last[idx] = now;
    s_ph[idx]   = f;
    s_pwr[idx]  = strToInt(q_pwr);
    if (havepart > 0) {
        s_part[idx] = strToInt(q_part);
    } else {
        s_part[idx] = 1;                        // absent field means "participating"
    }

    info_idx = (info_idx + 1) & 255;
    ctBuild(q_btype, q_bmac, q_ctmac);
    udp(2, txb);                                // unicast back to the sender
    tx_cnt = tx_cnt + 1;
}

// ─── Meter ─────────────────────────────────────────────────────────────────

// Offset + optional regulator shaping — same law as the .tas emulators, and
// applied per phase for the same reason: each battery regulates its own phase.
int applyCtrl(float raw) {
    float off = (float)pwroffset;
    float v = raw - off;
    if (ctrlopt > 0) {
        if (raw > off) {
            v = v / 4.0;
        } else {
            v = v / 0.8;
        }
    }
    return (int)v;
}

void updPower() {
    if (ph3 == 1) {
        pa = applyCtrl(smlGet(4));
        pb = applyCtrl(smlGet(5));
        pc = applyCtrl(smlGet(6));
    } else {
        // Single-value meter: everything on L1, like the Shelly emulation.
        // Set every battery to phase A (or all to D, which reads the total).
        pa = applyCtrl(smlGet(1));
        pb = 0;
        pc = 0;
    }
    ptot = applyCtrl(smlGet(1));       // the saldierend total — phase D reads this
}

// ─── Marstek cloud registration (HTTPS via httpGet + md5) ──────────────────

void urlMail(char dst[], char src[]) {
    int n = strlen(src);
    int i = 0;
    int j = 0;
    for (i = 0; i < n; i = i + 1) {
        int c = src[i];
        if (c == '@') {
            dst[j] = '%'; dst[j + 1] = '4'; dst[j + 2] = '0'; j = j + 3;
        } else if (c == '+') {
            dst[j] = '%'; dst[j + 1] = '2'; dst[j + 2] = 'B'; j = j + 3;
        } else {
            dst[j] = c; j = j + 1;
        }
    }
    dst[j] = 0;
}

// GET /app/Solar/v2_get_device.php — returns a token plus the device list.
// Fills mk_tok and leaves the body in http_resp. Returns 1 on success.
int mkLogin() {
    if (strlen(mk_mail) < 5) { strcpy(reg_msg, "Mail missing"); return 0; }
    if (strlen(mk_pass) < 1) { strcpy(reg_msg, "Password missing"); return 0; }

    char dig[20];
    char dighex[40];
    if (md5(mk_pass, strlen(mk_pass), dig) != 1) {
        strcpy(reg_msg, "MD5 not available in this firmware");
        return 0;
    }
    bin2hex(dig, 16, dighex);
    urlMail(umail, mk_mail);

    // Short enough for httpGet's 256-char URL limit, and httpGet de-chunks
    // the reply for us — which the raw TLS path below would not.
    strcpy(req, "https://");
    strcat(req, mk_host);
    strcat(req, "/app/Solar/v2_get_device.php?mailbox=");
    strcat(req, umail);
    strcat(req, "&pwd=");
    strcat(req, dighex);

    int n = httpGet(req, http_resp);
    if (n <= 0) {
        sprintf(reg_msg, "No reply from Marstek (rc=%d)", n);
        return 0;
    }
    int p = strFind(http_resp, "\"token\":\"");
    if (p < 0) {
        // The API answers 200 with code=4 on a wrong password.
        if (strFind(http_resp, "\"code\":4") >= 0) {
            strcpy(reg_msg, "Login refused - wrong password?");
        } else {
            strcpy(reg_msg, "No token in reply - login failed");
        }
        return 0;
    }
    strSub(mk_tok, http_resp, p + 9, 0);
    int q = strFind(mk_tok, "\"");
    if (q > 0) mk_tok[q] = 0;
    return 1;
}

// Scan the device list for managed fake CTs (devid = mac = 02b250xxxxxx, the
// prefix AstraMeter uses). The scan is destructive — http_resp is scratch.
int mkScan() {
    int found = 0;
    int guard = 0;
    while (guard < 12) {
        int m = strFind(http_resp, "02b250");
        if (m < 0) break;
        strSub(scanb, http_resp, m, 12);
        if (strlen(scanb) == 12) {
            strToLower(scanb);
            // Never overwrite a CT MAC that is already set - with two fake
            // CTs in the account this would silently switch the device to the
            // other one, and the battery would talk to a CT the app never
            // selected.
            if (found == 0 && strlen(ct_mac) != 12) {
                strcpy(ct_mac, scanb);
                addLog("CT002: fake CT adopted: %s", scanb);
            } else {
                addLog("CT002: fake CT found: %s (not adopted)", scanb);
            }
            found = found + 1;
        }
        http_resp[m] = 'X';                 // don't match the same spot again
        guard = guard + 1;
    }
    return found;
}

void mkDoLogin() {
    strcpy(reg_msg, "Login running ...");
    if (mkLogin() == 0) return;
    int found = mkScan();
    if (found > 0) {
        saveVars();
        sprintf(reg_msg, "OK - %d fake CT(s) found, CT MAC = ", found);
        strcat(reg_msg, ct_mac);
    } else {
        strcpy(reg_msg, "Login OK, no fake CT yet - create one below");
    }
}

// GET /app/Solar/v2_add_device.php — creates the managed CT record.
void mkDoCreate() {
    if (allow_create == 0) {
        strcpy(reg_msg, "Tick 'allow create' first");
        return;
    }
    if (strlen(ct_mac) == 12) {
        strcpy(reg_msg, "CT MAC already set - clear it first");
        return;
    }
    strcpy(reg_msg, "Creating ...");
    if (mkLogin() == 0) return;
    if (mkScan() > 0) {
        saveVars();
        strcpy(reg_msg, "Fake CT already exists - adopted instead");
        return;
    }

    // devid = mac = 02b250 + 6 random hex, like AstraMeter's _generate_new_id
    char nm[16];
    char one[4];
    strcpy(nm, "02b250");
    int i = 0;
    for (i = 0; i < 6; i = i + 1) {
        int r = random(0, 16);
        if (r > 15) r = 15;            // guard: hexd[16] is the NUL terminator
        if (r < 0)  r = 0;
        one[0] = hexd[r];
        one[1] = 0;
        strcat(nm, one);
    }
    if (strlen(nm) != 12) {
        strcpy(reg_msg, "MAC generation failed");
        return;
    }
    char sfx[8];
    strSub(sfx, nm, -4, 4);

    // httpGet, not the raw TLS socket: tlsConnect() (BearSSL) fails against
    // this host on the ESP32-C3, while httpGet (mbedtls) reaches it - the
    // login above proves it. Price: httpGet cuts the URL at 256 chars, so
    // mandatory fields go first and the rest only while it fits.

    strcpy(req, "https://");
    strcat(req, mk_host);
    strcat(req, "/app/Solar/v2_add_device.php?mailbox=");
    strcat(req, umail);
    strcat(req, "&devid=");
    strcat(req, nm);
    strcat(req, "&mac=");
    strcat(req, nm);
    strcat(req, "&type=");
    strcat(req, cttype);
    strcat(req, "&token=");
    strcat(req, mk_tok);
    strcat(req, "&access=1&name=CT002&bluetooth_name=MST-SMR_");
    strcat(req, sfx);
    if (strlen(req) + 25 <= 250) strcat(req, "&timeZone=Europe%2FBerlin");
    if (strlen(req) + 12 <= 250) strcat(req, "&version=121");
    if (strlen(req) + 16 <= 250) strcat(req, "&position=%7B%7D");
    int ulen = strlen(req);
    addLog("CT002: add_device URL %d chars", ulen);
    if (ulen > 250) {
        sprintf(reg_msg, "URL too long (%d chars) - mail address too long?", ulen);
        return;
    }

    httpHeader("User-Agent", "Dart/2.19 (dart:io)");
    httpHeader("Accept", "application/json");
    httpHeader("token", mk_tok);

    int rn = httpGet(req, http_resp);
    if (rn <= 0) {
        sprintf(reg_msg, "No reply on create (rc=%d)", rn);
        return;
    }
    int good = 0;
    if (strFind(http_resp, "\"code\":1")   >= 0) good = 1;
    if (strFind(http_resp, "\"code\":2")   >= 0) good = 1;
    if (strFind(http_resp, "\"code\":\"1\"") >= 0) good = 1;
    if (strFind(http_resp, "\"code\":\"2\"") >= 0) good = 1;
    if (good == 0) {
        strcpy(reg_msg, "Create refused: ");
        strcat(reg_msg, http_resp);
        return;
    }
    strcpy(ct_mac, nm);
    saveVars();
    strcpy(mk_pass, "");            // done - drop the password now
    strcpy(reg_msg, "Fake CT created, CT MAC = ");
    strcat(reg_msg, ct_mac);
    addLog("CT002: fake CT created in Marstek cloud: %s (%s)", nm, cttype);
}

// ─── Callbacks ─────────────────────────────────────────────────────────────

// UDP polling. One datagram per iteration, a few per tick so a burst from
// several batteries drains without waiting 100 ms each.
void Every100ms() {
    if (once_udp == 0) return;
    int guard = 0;
    while (guard < 4) {
        int n = udp(1, rxb);
        if (n <= 0) return;
        rx_cnt = rx_cnt + 1;
        ctHandle(n);
        guard = guard + 1;
    }
}

void EverySecond() {
    // ── config changes (same handling as ecotracker_shelly_emu.tc) ──
    int meter_changed  = changed(meter_sel);
    int pins_changed   = changed(rx_pin) || changed(tx_pin);
    int filter_changed = changed(smlfo);
    int activ_changed  = changed(sml_activ);
    if (activ_changed) {
        tasm_rule = sml_activ;
        snapshot(sml_activ);
    }
    if (meter_changed || pins_changed || filter_changed || activ_changed) {
        if (rx_pin >= 0 || tx_pin >= 0) {
            smlApplyPins("/sml_meter.def", rx_pin, tx_pin, smlfo ? 16 : 0);
        }
        snapshot(rx_pin);
        snapshot(tx_pin);
        snapshot(smlfo);
        tasmCmd("Sensor53 r", scanb);
    }
    if (meter_changed) {
        snapshot(meter_sel);
        smlScripterLoad("/sml_meter.def");
    }

    // ── bind the CT port as soon as the network is up ──
    if (tasm_wifi == 1 && once_udp == 0) {
        if (ct_port < 1) ct_port = 12345;
        if (udp(0, ct_port) == 1) {
            // The firmware re-binds the socket after 60 s without a packet.
            // Harmless under load, noisy when idle - 300 s keeps recovery.
            udp(8, 1, 300);
            once_udp = 1;
            addLog("CT002: %s listening on UDP %d (CT MAC %s)", cttype, ct_port, ct_mac);
        }
    }

    updPower();
    slotAge();
    strToLower(ct_mac);          // the web field may have been typed in upper case

    // Drop the cached password once it is stale
    if (strlen(mk_pass) > 0 && reg_busy == 0) {
        if (millis() - pass_ts > 600000) {
            strcpy(mk_pass, "");
            addLog("CT002: cached Marstek password discarded after 10 min");
        }
    }

    // ── web buttons ──
    if (do_save > 0)  { do_save = 0;  saveVars(); }
    if (do_clear > 0) {
        do_clear = 0;
        strcpy(ct_mac, "");
        strcpy(reg_msg, "CT MAC cleared (cloud device remains)");
        saveVars();
    }
}

// Cloud calls block for seconds — they belong in the slot's own task, never
// in EverySecond (there they would stall the whole Tasmota main loop).
void TaskLoop() {
    if (reg_req > 0) {
        int what = reg_req;
        reg_req  = 0;
        reg_busy = 1;
        if (what == 1) {
            mkDoLogin();
        } else {
            mkDoCreate();
        }
        // Password stays in RAM for step 2 (both steps need a token) and is
        // dropped on success or by timeout in EverySecond. Never on flash.

        reg_busy = 0;
    }
    delay(200);
}

void WebCall() {
    sprintf(scanb, "{s}Emulation{m}%s{e}", cttype);
    webSend(scanb);
    if (strlen(ct_mac) == 12) {
        sprintf(scanb, "{s}CT MAC{m}%s{e}", ct_mac);
    } else {
        strcpy(scanb, "{s}CT MAC{m}(any){e}");
    }
    webSend(scanb);
    sprintf(scanb, "{s}Grid L1/L2/L3{m}%d / %d / %d W{e}", pa, pb, pc);
    webSend(scanb);
    sprintf(scanb, "{s}Grid total{m}%d W{e}", ptot);
    webSend(scanb);

    int i = 0;
    int live = 0;
    char pn[4];
    for (i = 0; i < NSLOT; i = i + 1) {
        if (s_used[i] == 1) {
            live = live + 1;
            strcpy(pn, "x");
            if (s_ph[i] == 1) strcpy(pn, "A");
            if (s_ph[i] == 2) strcpy(pn, "B");
            if (s_ph[i] == 3) strcpy(pn, "C");
            if (s_ph[i] == 4) strcpy(pn, "D");
            sprintf(scanb, "{s}Battery %s{m}", s_mac[i]);
            sprintfAppend(scanb, "Ph %s &middot; %d W", pn, s_pwr[i]);
            if (s_part[i] == 0) strcat(scanb, " (passive)");
            sprintfAppend(scanb, " &middot; %d ms{e}", s_iv[i]);
            webSend(scanb);
        }
    }
    sprintf(scanb, "{s}Batteries{m}%d{e}", live);
    webSend(scanb);
    sprintf(scanb, "{s}UDP rx/tx/bad{m}%d / %d / ", rx_cnt, tx_cnt);
    sprintfAppend(scanb, "%d{e}", bad_cnt);
    webSend(scanb);
}

void WebUI() {
    int page = webPage();

    if (page == 0) {
        webSend("<style>.ct-p{max-width:340px;margin:12px auto;background:#f0f0f0;color:#000;padding:18px;border:2px solid #ccc;border-radius:6px;text-align:left}.ct-p h3{margin:0 0 8px;font-size:15px}.ct-p hr{border:0;border-top:1px solid #bbb;margin:14px 0}.ct-p b{display:inline-block;margin-bottom:4px;font-size:13px}.ct-p div{margin:6px 0}.ct-p input[type=checkbox]{transform:scale(1.3);margin-left:6px}.ct-p button{padding:6px 10px;border-radius:4px}.ct-p a.i{text-decoration:none;margin-left:6px}</style>");
        webSend("<div class='ct-p'>");
        webSend("<h3>&#x1F50C; Marstek CT emulator</h3>");

        sprintf(scanb, "<b>&#x2699;&#xFE0F; CT</b>%s#ct'>&#x2139;&#xFE0F;</a>", helpa);
        webSend(scanb);
        webPulldown(ct_kind, "Type (restart)", "CT002 (HME-4)|CT003 (HME-3)");
        webText(ct_mac, 16, "CT MAC");
        webNumber(ct_port, 1024, 65535, "UDP port");
        webNumber(ct_rssi, -90, -20, "RSSI [dBm]");
        webNumber(ct_ttl, 0, 300, "Battery timeout [s]");

        webSend("<hr>");
        sprintf(scanb, "<b>&#x1F50B; Battery</b>%s#battery'>&#x2139;&#xFE0F;</a>", helpa);
        webSend(scanb);
        webNumber(pwroffset, -200, 200, "Offset [W]");
        webCheckbox(ctrlopt, "Regulator tweak");
        webCheckbox(ph3, "3 phases");

        webSend("<hr>");
        sprintf(scanb, "<b>&#x26A1; Meter</b>%s#meter'>&#x2139;&#xFE0F;</a>", helpa);
        webSend(scanb);
        webCheckbox(sml_activ, "SML active");
        webSend("&#x1F4DD; <a href='/ufse?file=/sml_meter.def'>Edit descriptor</a>");
        webRepoPulldown(meter_sel, "Descriptor",
                        "https://raw.githubusercontent.com/ottelo9/tasmota-sml-script/main/script-list-menu/meters/smartmeter.json",
                        "smartmeter",
                        "/sml_meter.def");
        webPulldown(rx_pin, "RX pin", "@getfreepins");
        webPulldown(tx_pin, "TX pin", "@getfreepins");
        webCheckbox(smlfo, "Median filter");

        webSend("<hr>");
        webButton(do_save, "Save|saved");
        webSend("</div>");
        return;
    }

    if (page == 1) {
        webSend("<style>.ct-p{max-width:340px;margin:12px auto;background:#f0f0f0;color:#000;padding:18px;border:2px solid #ccc;border-radius:6px;text-align:left}.ct-p h3{margin:0 0 8px;font-size:15px}.ct-p hr{border:0;border-top:1px solid #bbb;margin:14px 0}.ct-p b{display:inline-block;margin-bottom:4px;font-size:13px}.ct-p .note{font-size:12px;color:#444;line-height:1.35}.ct-p a.i{text-decoration:none;margin-left:6px}</style>");
        webSend("<div class='ct-p'>");
        sprintf(scanb, "<h3>&#x2601;&#xFE0F; Marstek account</h3>%s#marstek'>&#x2139;&#xFE0F; help</a>", helpa);
        webSend(scanb);
        // Not webText: the firmware writes sv= strings to globals[idx] while
        // webText reports the heap handle index for any char[] > 16, so the
        // text lands in foreign variables. Own page /ctreg instead.

        sprintf(scanb, "<div class='note'>Account: <b>%s</b></div>", mk_mail);
        webSend(scanb);
        webSend("<div><a href='/ctreg'><button type='button'>&#x1F511; Set up account</button></a></div>");
        webSend("<hr>");
        sprintf(scanb, "<b>Status</b><div class='note'>%s</div>", reg_msg);
        webSend(scanb);
        webButton(do_clear, "Clear CT MAC|cleared");
        webSend("</div>");
        return;
    }
}

// ─── /ctreg — own page for the Marstek login ──────────────────────────────
// Not in WebUI: that block re-renders every 2 s and wipes input, and the
// sv= string write path is broken in the firmware. webArg() instead, and
// POST keeps the password out of the URL and browser history.

//
// webOn endpoints only work in slot 0.
void WebOn() {
    if (webHandler() != 4) return;

    char a[96];

    // Poller status query: text only, no side effects.
    // Format "<status>|<ct-mac>|<busy>"
    if (webArg("st", a) > 0) {
        strcpy(scanb, reg_msg);
        strcat(scanb, "|");
        if (strlen(ct_mac) == 12) {
            strcat(scanb, ct_mac);
        } else {
            strcat(scanb, "(noch keine)");
        }
        if (reg_busy == 1) {
            strcat(scanb, "|1");
        } else {
            strcat(scanb, "|0");
        }
        webSend(scanb);
        return;
    }

    int act = 0;
    if (webArg("do", a) > 0) {
        if (strcmp(a, "login")  == 0) act = 1;
        if (strcmp(a, "create") == 0) act = 2;
    }
    if (webArg("mail", a) > 0) {
        strcpy(mk_mail, a);
        saveVars();
    }
    // An empty field keeps the cached password, so step 2 does not need it
    // typed again.
    if (webArg("pw", a) > 0) {
        strcpy(mk_pass, a);
        pass_ts = millis();
    }
    if (webArg("ok", a) > 0) {
        allow_create = 1;
    } else {
        allow_create = 0;
    }
    if (act > 0) {
        if (reg_busy == 1) {
            strcpy(reg_msg, "Another job is running");
        } else {
            reg_req = act;
            strcpy(reg_msg, "requested, running ...");
        }
        // Post/Redirect/Get - without it every reload asks to resubmit the
        // form and keeps showing the stale answer.
        webSend("<html><head><meta charset='utf-8'></head><body><script>location.replace('/ctreg');</script></body></html>");
        return;
    }

    webSend("<html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Marstek account</title>");
    webSend("<style>body{font-family:sans-serif;background:#252525;color:#eaeaea;margin:0;padding:16px}");
    webSend(".p{max-width:360px;margin:0 auto;background:#f0f0f0;color:#000;padding:18px;border:2px solid #ccc;border-radius:6px}");
    webSend("h3{margin:0 0 10px;font-size:16px}label{display:block;margin:10px 0 4px;font-size:13px}");
    webSend("input[type=text],input[type=password]{width:100%;box-sizing:border-box;padding:6px}");
    webSend("button{padding:8px 12px;border-radius:4px;margin:8px 0;width:100%}");
    webSend(".n{font-size:12px;color:#444;line-height:1.35;margin:8px 0}.w{font-size:12px;color:#a00;line-height:1.35;margin:8px 0}");
    webSend("a.i{text-decoration:none;margin-left:6px}");
    webSend(".s{background:#fff;border:1px solid #bbb;padding:8px;font-size:13px;margin-top:10px}</style></head><body><div class='p'>");
    sprintf(scanb, "<h3>&#x2601;&#xFE0F; Marstek account</h3>%s#marstek'>&#x2139;&#xFE0F; help</a>", helpa);
    webSend(scanb);
    webSend("<div class='n'>The battery only talks to a CT that exists in your Marstek account.</div>");

    webSend("<form method='post' action='/ctreg'>");
    sprintf(scanb, "<label>Mail</label><input type='text' name='mail' value='%s'>", mk_mail);
    webSend(scanb);
    webSend("<label>Password</label><input type='password' name='pw' value=''>");
    if (strlen(mk_pass) > 0) {
        webSend("<div class='n'>Password held in RAM for 10 min. Leave empty to reuse it.</div>");
    }
    webSend("<div class='w'>&#x26A0;&#xFE0F; Sent in the clear over your LAN. Never stored on flash.</div>");
    webSend("<button type='submit' name='do' value='login'>1. Log in + check account</button>");
    webSend("<label><input type='checkbox' name='ok' value='1'> Allow create</label>");
    webSend("<button type='submit' name='do' value='create'>2. Create fake CT</button>");
    webSend("</form>");

    sprintf(scanb, "<div class='s'><b>Status:</b> <span id='st'>%s</span></div>", reg_msg);
    webSend(scanb);
    if (strlen(ct_mac) == 12) {
        sprintf(scanb, "<div class='s'><b>CT MAC:</b> <span id='mc'>%s</span></div>", ct_mac);
    } else {
        strcpy(scanb, "<div class='s'><b>CT MAC:</b> <span id='mc'>(none yet)</span></div>");
    }
    webSend(scanb);
    webSend("<div><a href='/'><button type='button'>&#x2B05;&#xFE0F; Main menu</button></a></div>");
    // The cloud call runs in TaskLoop and is unfinished when this renders.
    // Chained setTimeout, not setInterval, so slow answers cannot stack.
    webSend("<script>function pl(){fetch('/ctreg?st=1',{cache:'no-store'}).then(function(r){return r.text();}).then(function(t){var p=t.split('|');");
    webSend("document.getElementById('st').textContent=p[0];document.getElementById('mc').textContent=p[1];})");
    webSend(".catch(function(){}).then(function(){setTimeout(pl,1500);});}setTimeout(pl,800);</script>");
    webSend("</div></body></html>");
}

void Command(char cmd[]) {
    if (strcmp(cmd, "STAT") == 0) {
        sprintf(scanb, "rx=%d tx=%d bad=%d idx=%d", rx_cnt, tx_cnt, bad_cnt, info_idx);
        responseCmnd(scanb);
        int i = 0;
        for (i = 0; i < NSLOT; i = i + 1) {
            if (s_used[i] == 1) {
                addLog("CT002: slot %d %s ph=%d p=%d part=%d iv=%d",
                       i, s_mac[i], s_ph[i], s_pwr[i], s_part[i], s_iv[i]);
            }
        }
    } else if (strcmp(cmd, "CLR") == 0) {
        int i = 0;
        for (i = 0; i < NSLOT; i = i + 1) {
            s_used[i] = 0;
        }
        responseCmnd("slots cleared");
    } else if (strStartsWith(cmd, "MAC ") == 1) {
        strSub(scanb, cmd, 4, 0);
        strTrim(scanb);
        strToLower(scanb);
        if (strlen(scanb) == 12 || strlen(scanb) == 0) {
            strcpy(ct_mac, scanb);
            saveVars();
            responseCmnd(ct_mac);
        } else {
            responseCmnd("12 hex chars expected (or empty for any)");
        }
    } else if (strStartsWith(cmd, "MAIL ") == 1) {
        strSub(scanb, cmd, 5, 0);
        strcpy(mk_mail, scanb);
        saveVars();
        responseCmnd(mk_mail);
    } else if (strStartsWith(cmd, "PASS ") == 1) {
        strSub(scanb, cmd, 5, 0);
        strcpy(mk_pass, scanb);
        responseCmnd("password set (not stored)");
    } else if (strcmp(cmd, "LOGIN") == 0) {
        reg_req = 1;
        responseCmnd("login requested");
    } else if (strcmp(cmd, "CREATE JA") == 0) {
        allow_create = 1;
        reg_req = 2;
        responseCmnd("create requested");
    } else {
        responseCmnd("CTSTAT | CTCLR | CTMAC <hex12> | CTMAIL <adr> | CTPASS <pw> | CTLOGIN | CTCREATE JA");
    }
}

void JsonCall() {
    int live = 0;
    int i = 0;
    for (i = 0; i < NSLOT; i = i + 1) {
        if (s_used[i] == 1) live = live + 1;
    }
    sprintf(scanb, ",\"CT002\":{\"L1\":%d,\"L2\":%d,\"L3\":%d", pa, pb, pc);
    sprintfAppend(scanb, ",\"Total\":%d,\"Slaves\":%d}", ptot, live);
    responseAppend(scanb);
}

int main() {
    once_udp = 0;
    info_idx = 0;
    rx_cnt   = 0;
    tx_cnt   = 0;
    bad_cnt  = 0;
    reg_req  = 0;
    reg_busy = 0;
    do_save = 0; do_clear = 0;
    allow_create = 0;
    strcpy(mk_pass, "");
    strcpy(reg_msg, "ready");

    int i = 0;
    for (i = 0; i < NSLOT; i = i + 1) {
        s_used[i] = 0;
        s_ph[i]   = 0;
        s_pwr[i]  = 0;
        s_part[i] = 1;
        s_iv[i]   = 1000;
        s_last[i] = 0;
        strcpy(s_mac[i], "");
    }

    aggCalc();

    if (ct_port < 1)   ct_port = 12345;
    if (ct_rssi == 0)  ct_rssi = -50;
    if (ct_rssi > 0)   ct_rssi = 0 - ct_rssi;
    if (ct_kind == 1) {
        strcpy(cttype, "HME-3");
    } else {
        strcpy(cttype, "HME-4");
    }
    strToLower(ct_mac);

    // First-run pin-picker defaults (persist 0 is a real GPIO; -1 = unset)
    if (rx_pin == 0 && tx_pin == 0) { rx_pin = -1; tx_pin = -1; }
    if (sml_activ != tasm_rule) tasm_rule = sml_activ;

    addCommand("CT");
    webPageLabel(0, "CT emulator");
    webPageLabel(1, "Marstek account");
    webOn(4, "/ctreg");         // own page, see WebOn() - slot 0 only

    smlScripterLoad("/sml_meter.def");

    addLog("CT002: started, type %s, port %d, CT MAC '%s', 3ph=%d",
           cttype, ct_port, ct_mac, ph3);
    return 0;
}
