// sml_descriptor.tc — the meter setup every program of the family shares:
// descriptor, pins, filter, driver rows, restart. Defines no callbacks.
//
// The including program calls:
//   sml_descriptor_apply()        every second - change detect + re-apply
//   sml_render_settings_panel()   from WebUI; opens the panel div and
//                                 leaves it open for the caller to fill

#include "ui_common.tc"

// ── Persisted descriptor settings ───────────────────────────────────────────
persist watch int sml_meter_sel;
persist watch int sml_rx_pin;
persist watch int sml_tx_pin;
persist watch int sml_filter;   // 0 = raw, 1 = on → smlf=16 in descriptor
persist watch int sml_activ;    // mirrors tasm_rule bit 0
persist watch int sml_drvrows;  // 1 = also show the SML driver's own rows
persist watch int sml_ph3;      // 1 = meter delivers per-phase power in 4/5/6

// ── Edit buffer ────────────────────────────────────────────────────────────
// The widgets write here, Save copies it onto the settings above. Before this
// the widgets wrote the persist variables directly: leaving without saving
// then left a changed pin or meter in the device - inactive, but stored.
int sml_e_meter_sel; int sml_e_rx_pin; int sml_e_tx_pin;
int sml_e_filter;    int sml_e_activ;  int sml_e_drvrows;
int sml_e_ph3;

void smlDescCommit() {
    sml_meter_sel = sml_e_meter_sel;
    sml_rx_pin    = sml_e_rx_pin;
    sml_tx_pin    = sml_e_tx_pin;
    sml_filter    = sml_e_filter;
    sml_activ     = sml_e_activ;
    sml_drvrows   = sml_e_drvrows;
    sml_ph3       = sml_e_ph3;
    tcOptSet(2, sml_meter_sel);
    tcOptSet(3, sml_rx_pin);
    tcOptSet(4, sml_tx_pin);
    tcOptSet(5, sml_filter);
    tcOptSet(6, sml_activ);
    tcOptSet(7, sml_drvrows);
    tcOptSet(8, sml_ph3);
}
void smlDescEditLoad() {
    sml_e_meter_sel = sml_meter_sel;
    sml_e_rx_pin    = sml_rx_pin;
    sml_e_tx_pin    = sml_tx_pin;
    sml_e_filter    = sml_filter;
    sml_e_activ     = sml_activ;
    sml_e_drvrows   = sml_drvrows;
    sml_e_ph3       = sml_ph3;
}

// ── Shared sprintf scratch (also used by chart/totals renderers) ────────────
byte sml_buf[160];
byte sml_ftopic[96];       // full MQTT topic - mqttPublish takes it at runtime
int  sml_pub_rc;           // last mqttPublish result, logged when it changes
int  sml_pub_seen;
int  sml_drv_init;              // 0 until the display option was applied once

// Sanity check for "3 phases". The option only makes sense if the descriptor
// really carries the per-phase power in values 4/5/6 - the family's convention.
// Nothing enforces that convention: the Elster AS1440 descriptor, for one, has
// Total_NT (kWh) at 4 and the two directional powers at 5/6, so switching the
// option on would put a meter reading into an "L1" watt row and send it to the
// battery as a phase value.
//
// Checked ONCE when the option is switched on, not continuously: a permanent
// heuristic would also have to be right about every unusual but legitimate
// meter, and "sum of phases equals total" is a rule with real exceptions. At
// the moment of switching on it is a question the user just answered wrongly
// or rightly, and telling them is better than either guessing or staying mute.
int  sml_ph3_arm;               // 1 = validate as soon as the meter has data
int  sml_ph3_bad;               // 1 = last attempt rejected, hint shown
int  sml_ph3_was;               // previous sml_ph3, to spot the 0 -> 1 edge

// ============================================================================
// Change-detect + re-apply: descriptor / pins / filter / activ.
// Idempotent: zero file IO when nothing changed; smlApplyPins itself
// only rewrites /sml_meter.def when a substituted value differs.
// ============================================================================
// Driver rows on/off. Bit 2 drops the driver's own sensor block (it puts the
// meter name in front of every value), bit 0 keeps the SENSOR JSON. The
// script renders the values itself.
void sml_apply_drvrows() {
    if (sml_drvrows > 0) {
        smlSetOptions(0x101);       // 0x100 = write-enable, bit 0 = JSON
    } else {
        smlSetOptions(0x105);       // + bit 2 = no driver rows
    }
}

void sml_descriptor_apply() {
    // Once at startup: the driver's default is to show its own rows.
    if (sml_drv_init == 0) {
        sml_drv_init = 1;
        // Shared file first, so a program change finds the meter, the pins and
        // the filter again - the .def keeps working either way (main() loads
        // it unconditionally), but sml_meter_sel is not recorded in it and
        // could not be recovered from the descriptor at all.
        sml_meter_sel = tcOptGet(2, sml_meter_sel);
        sml_rx_pin    = tcOptGet(3, sml_rx_pin);
        sml_tx_pin    = tcOptGet(4, sml_tx_pin);
        sml_filter    = tcOptGet(5, sml_filter);
        sml_activ     = tcOptGet(6, sml_activ);
        sml_drvrows   = tcOptGet(7, sml_drvrows);
        sml_ph3       = tcOptGet(8, sml_ph3);
        tcOptSet(2, sml_meter_sel);
        tcOptSet(3, sml_rx_pin);
        tcOptSet(4, sml_tx_pin);
        tcOptSet(5, sml_filter);
        tcOptSet(6, sml_activ);
        tcOptSet(7, sml_drvrows);
        tcOptSet(8, sml_ph3);
        sml_ph3_was = sml_ph3;      // only a real 0 -> 1 edge arms the check,
                                    // an option that was already on stays on
        smlDescEditLoad();          // widgets start from what is in effect
        sml_apply_drvrows();
        snapshot(sml_drvrows);
    }
    if (ui_reloading) smlDescEditLoad();   // drop unsaved edits on a fresh page

    // Runs outside the Save gate: the meter may not have delivered anything
    // yet when the option is switched on, so this waits for the first reading.
    if (sml_ph3_arm == 1 && smlGet(2) > 0.0) {
        sml_ph3_arm = 0;
        float p1 = smlGet(4);
        float p2 = smlGet(5);
        float p3 = smlGet(6);
        float sum = p1 + p2 + p3;
        float tot = smlGet(1);
        float dev = sum - tot;
        if (dev < 0.0) dev = 0.0 - dev;
        // Generous band: the phases ARE the total, so a real meter agrees
        // closely. 100 W or 10 % catches a descriptor whose 4/5/6 hold
        // something else entirely without tripping over rounding, an offset
        // or two readings taken one telegram apart.
        float band = 100.0;
        float mag = tot;
        if (mag < 0.0) mag = 0.0 - mag;
        if (mag * 0.1 > band) band = mag * 0.1;
        int empty = 0;
        if (p1 == 0.0 && p2 == 0.0 && p3 == 0.0) empty = 1;
        if (empty == 1 || dev > band) {
            sml_ph3 = 0;
            sml_e_ph3 = 0;
            sml_ph3_bad = 1;
            sml_ph3_was = 0;
            tcOptSet(8, sml_ph3);
            if (empty == 1) {
                addLog("sml: 3 phases off - values 4/5/6 are all zero, descriptor has no phases");
            } else {
                addLog("sml: 3 phases off - L1+L2+L3 = %.0f W does not match total %.0f W", sum, tot);
            }
            saveVars();
        } else {
            addLog("sml: 3 phases confirmed - L1+L2+L3 = %.0f W, total %.0f W", sum, tot);
        }
    }

    if (ui_applying == 0) return;   // everything below waits for Save
    smlDescCommit();                // widgets wrote the edit buffer, not these

    // Arm the check on the 0 -> 1 edge. Switching it off clears the hint.
    if (sml_ph3 == 1 && sml_ph3_was == 0) {
        sml_ph3_arm = 1;
        sml_ph3_bad = 0;
    }
    if (sml_ph3 == 0) sml_ph3_bad = 0;
    sml_ph3_was = sml_ph3;

    if (changed(sml_drvrows)) {
        sml_apply_drvrows();
        snapshot(sml_drvrows);
    }

    int meter_changed  = changed(sml_meter_sel);
    int pins_changed   = changed(sml_rx_pin) || changed(sml_tx_pin);
    int filter_changed = changed(sml_filter);
    int activ_changed  = changed(sml_activ);

    if (activ_changed) {
        tasm_rule = sml_activ;
        snapshot(sml_activ);
    }
    // The repo pulldown downloads client-side, straight past the VM, so it
    // stages into /sml_meter.new. Swap it in first - the pins below have to be
    // substituted into the NEW file.
    if (meter_changed) {
        int h = fileOpen("/sml_meter.new", "r");
        if (h >= 0) {
            fileClose(h);
            fileDelete("/sml_meter.def");
            fileRename("/sml_meter.new", "/sml_meter.def");
        }
        snapshot(sml_meter_sel);
    }
    if (meter_changed || pins_changed || filter_changed || activ_changed) {
        if (sml_rx_pin >= 0 || sml_tx_pin >= 0) {
            int filter_val = sml_filter ? 16 : 0;
            smlApplyPins("/sml_meter.def", sml_rx_pin, sml_tx_pin, filter_val);
        }
        snapshot(sml_rx_pin);
        snapshot(sml_tx_pin);
        snapshot(sml_filter);
        tasmCmd("Sensor53 r", sml_buf);
        // A driver restart resets sml_options to its default, so the display
        // choice has to be applied again afterwards.
        sml_apply_drvrows();
    }
    if (meter_changed) {
        smlScripterLoad("/sml_meter.def");
    }
    // Save always writes: TinyC only auto-saves persist vars at slot-stop, and
    // a main()-only slot stops right after main() - a change made while it runs
    // would otherwise never reach flash.
    saveVars();
}

// Opens the styled panel frame: the shared stylesheet plus <div class='sml-p'>
// and a heading. Factored out because a second settings page needs the same
// frame without the meter section - the CT emulator moved its own controls
// onto one, they had outgrown the main page.
// The caller closes the div, normally through the version footer.
void sml_panel_open(char icon[], char en[], char de[]) {
    webSend("<style>body>div{width:480px;max-width:96vw;box-sizing:border-box}.sml-p{max-width:100%;box-sizing:border-box;margin:12px auto;background:#f0f0f0;color:#000;padding:16px;border:2px solid #ccc;border-radius:6px;text-align:left}.sml-p h3{margin:0 0 8px}.sml-p hr{border:0;border-top:1px solid #bbb;margin:12px 0}.sml-p b{display:inline-block;margin-bottom:4px;font-size:13px}.sml-p div{margin:6px 0}.sml-p .hint{font-size:9px;color:#555;line-height:1.4}</style>");
    if (ui_de) sprintf(sml_buf, "<div class='sml-p'><h3>%s %s</h3>", icon, de);
    else       sprintf(sml_buf, "<div class='sml-p'><h3>%s %s</h3>", icon, en);
    webSend(sml_buf);
}

// ============================================================================
// Settings panel — uptime + descriptor picker + pin pulldowns + filter
// toggle + edit-descriptor link. The styled <div class='sml-p'> is opened
// here and LEFT OPEN — callers add their own buttons / footer / sections
// then close the div with `</div>` themselves.
// ============================================================================
void sml_render_settings_panel() {
    // Tasmota's wrapper is an inline-block with min-width:340px, so it grows
    // with its widest child - pinning it is what widens the page. Same value
    // as the /tc slot page uses. 96vw keeps it inside a phone screen.
    sml_panel_open("&#x26A1;", "Settings", "Einstellungen");
    uiLang();                       // topmost - it relabels everything below

    // Meter active, descriptor and pins belong together - one section, one
    // heading, so it is clear which settings describe the meter itself.
    uiHead("&#x1F50C;", "Meter settings", "Zähler-Einstellungen", "sml/#meter");
    if (ui_de) {
        webCheckbox(sml_e_activ, "Zähler aktiv");
        webCheckbox(sml_e_ph3, "3 Phasen");
        if (sml_ph3_bad == 1) webSend("<div style='font-size:11px;color:#a00;margin:2px 0'>&#9888; Abgeschaltet: Werte 4/5/6 des Descriptors sind keine Phasenleistungen. Siehe Konsole.</div>");
        uiCheckI(sml_e_drvrows, varIdx(sml_e_drvrows), "Zusätzliche Anzeige (via SML-Treiber)", "sml/#display");
        uiCheckI(sml_e_filter, varIdx(sml_e_filter), "SML Median Filter", "sml/#filter");
        webSend("&#x1F4DD; <a href='/ufse?file=/sml_meter.def'>Descriptor bearbeiten</a>");
        webRepoPulldown(sml_e_meter_sel, "Aus Repo",
                        "https://raw.githubusercontent.com/ottelo9/tasmota-sml-script/main/script-list-menu/meters/smartmeter.json",
                        "smartmeter",
                        "/sml_meter.new");
        webPulldown(sml_e_rx_pin, "RX-Pin", "@getfreepins");
        webPulldown(sml_e_tx_pin, "TX-Pin", "@getfreepins");
    } else {
        webCheckbox(sml_e_activ, "Meter active");
        webCheckbox(sml_e_ph3, "3 phases");
        if (sml_ph3_bad == 1) webSend("<div style='font-size:11px;color:#a00;margin:2px 0'>&#9888; Switched off: descriptor values 4/5/6 are not per-phase power. See console.</div>");
        uiCheckI(sml_e_drvrows, varIdx(sml_e_drvrows), "Additional display (via SML driver)", "sml/#display");
        uiCheckI(sml_e_filter, varIdx(sml_e_filter), "SML Median Filter", "sml/#filter");
        webSend("&#x1F4DD; <a href='/ufse?file=/sml_meter.def'>Edit descriptor</a>");
        webRepoPulldown(sml_e_meter_sel, "From repo",
                        "https://raw.githubusercontent.com/ottelo9/tasmota-sml-script/main/script-list-menu/meters/smartmeter.json",
                        "smartmeter",
                        "/sml_meter.new");
        webPulldown(sml_e_rx_pin, "RX pin", "@getfreepins");
        webPulldown(sml_e_tx_pin, "TX pin", "@getfreepins");
    }
    webSend("<div class='hint'>RX=3 TX=1: Hichi, Stromleser, LesekopfV32, Wattwächter<br>RX=5 TX=4: bitShake</div>");
}

// Publish at log level 3 - silent until weblog 3. Reports a changed result
// once: 0 = sent, -1 = bad topic, -2 = MQTT off (SetOption3). Without this a
// device with MQTT disabled would drop every value without a word.
// byte[] parameters, because every caller now hands it packed buffers.
// ⚠️ Mixing matters here: TinyC decides the packing from the DECLARED
// parameter type at compile time, so a byte[] reaching a char[] parameter
// is only safe as long as the callee never indexes it. This one just
// forwards, but keeping the types aligned removes the trap.
void smlPublish(byte topic[], byte payload[]) {
    int rc = mqttPublish(topic, payload, 3);
    if (sml_pub_seen == 0 || rc != sml_pub_rc) {
        sml_pub_seen = 1;
        sml_pub_rc = rc;
        addLog("SML: mqttPublish rc=%d topic=%s", rc, topic);
    }
}

// Per-phase meter values, right below Power/Import/Export. Only when the meter
// actually delivers them (values 4/5/6 in the descriptor) - otherwise the SML
// driver returns 0 for all three and three empty rows would be a lie.
void sml_phase_rows() {
    if (sml_ph3 == 0) return;
    sprintf(sml_buf, "{s}L1 / L2 / L3{m}%.0f / %.0f / %.0f W{e}", smlGet(4), smlGet(5), smlGet(6));
    webSend(sml_buf);
}
