// eco_shelly_common.tc — EcoTracker / Shelly Pro 3EM emulator as a building
// block. Defines no callbacks; the including program owns them and calls the
// functions below. Meter setup comes from sml_descriptor.tc, telemetry from
// the base program.
//
// Two dialects, one program - the battery picks the one it speaks:
//   EcoTracker  mDNS "ecotracker-<mac>",  HTTP /v1/json
//   Shelly 3EM  mDNS "shellypro3em-<mac>", HTTP /rpc/*, UDP 1010 or 2220

#include "ui_common.tc"

// ─── Settings ──────────────────────────────────────────────────────────────
persist int es_mode;        // 0 = EcoTracker, 1 = Pro 3EM, 2 = Pro EM50, 3 = EM Gen3
persist int es_port;        // 0 = UDP 1010, 1 = UDP 2220 (B2500)
persist int es_offset;      // zero-feed offset [W]
persist int es_tweak;       // regulator shaping 0/1
persist int es_force;       // Shelly: push UDP even without a request
persist int es_throttle;    // update rate [s]

// ─── Edit buffer ───────────────────────────────────────────────────────────
// The panel writes here; Save copies it onto the settings above.
int es_e_mode; int es_e_port; int es_e_offset;
int es_e_tweak; int es_e_force; int es_e_throttle;

// Save. Mode and port decide what is announced on the network, and both the
// mDNS registration and the UDP bind run ONCE, guarded by es_once_*. Without
// clearing those guards a mode switch only took effect after a slot restart -
// and the half-applied state in between was the confusing part: the UDP port
// bound (its guard was still 0, never having run in EcoTracker mode) while
// mDNS kept announcing the old service. A device advertising _shelly._tcp
// under an ecotracker- hostname is exactly that state seen from outside.
void esCommit() {
    int mode_was = es_mode;
    int port_was = es_port;
    es_mode = es_e_mode;
    es_port = es_e_port;
    es_offset = es_e_offset;
    es_tweak = es_e_tweak;
    es_force = es_e_force;
    es_throttle = es_e_throttle;
    if (es_throttle < 1) es_throttle = 1;
    tcOptSet(13, es_mode);
    tcOptSet(14, es_port);
    tcOptSet(15, es_offset);
    tcOptSet(16, es_tweak);
    tcOptSet(17, es_force);
    tcOptSet(18, es_throttle);

    if (es_mode != mode_was) {
        es_once_mdns = 0;               // announce the new service type
        es_once_udp  = 0;               // Shelly needs the socket, EcoTracker does not
        es_last_api  = 0;               // no stale replay from the other mode
        addLog("eco_shelly: mode changed - re-announcing");
    } else if (es_port != port_was) {
        es_once_udp = 0;                // udp(0, port) rebinds, it stops the old socket
        addLog("eco_shelly: UDP port changed - rebinding");
    }
}
void esEditLoad() {
    es_e_mode = es_mode;
    es_e_port = es_port;
    es_e_offset = es_offset;
    es_e_tweak = es_tweak;
    es_e_force = es_force;
    es_e_throttle = es_throttle;
}

// ─── Runtime ───────────────────────────────────────────────────────────────
float es_cpwr;              // power handed to the battery [W]
float es_pa; float es_pb; float es_pc;   // per-phase, sml_ph3 only
float es_avg;               // heavily smoothed (EcoTracker powerAvg)
int   es_once_mdns;
int   es_once_udp;
int   es_bound;             // UDP port actually bound
int   es_last_api;          // 0 none, 1 EM.GetStatus, 2 Shelly.GetStatus, 3 EM1
int   es_last_upd;          // tasm_uptime of the last regulation step
int   es_w1; int es_w2; int es_w3; int es_w4;   // webOn handler numbers
int   es_w5;                                    // Gen3 adds EMData.GetStatus

byte  es_mac[32];
char  es_rxb[256];
byte  es_body[640];
char  es_wrap[768];
byte  es_hdr[160];


// Offset and regulator shaping, applied per phase exactly as CT002 does it.
float esCtrl(float raw) {
    float off  = (float)es_offset;
    float base = raw - off;
    if (es_tweak > 0) {
        if (raw > off) return base / 4.0;
        return base / 0.8;
    }
    return base;
}
// ─── Payload builders ──────────────────────────────────────────────────────

// Decimal places copied from a REAL Shelly Pro 3EM's Shelly.GetStatus, not
// guessed and not taken from AstraMeter's "decimal_point_enforcer" (which nudges
// integral values by 0.001 - a real device needs no such trick):
//
//   a_act_power           126.1        1 place, per phase
//   total_act_power       188.026      3 places
//   a_total_act_energy    179376.03    2 places, Wh
//   c_total_act_ret_energy      0.00   an exact zero is written plainly
//
// The total is not the sum of the rounded phases - 126.1 + 41.5 + 20.4 is 188.0
// while the device says 188.026 - because it adds up the unrounded values. Ours
// does the same: es_cpwr comes from smlGet(1), not from adding es_pa..es_pc.

void esBuildEco() {
    float ein  = smlGet(2) * 1000.0;      // kWh -> Wh
    float eout = smlGet(3) * 1000.0;
    sprintf(es_body, "{\"power\":%.0f,\"powerAvg\":%.0f,\"agePower\":1000,\"powerPhase1\":%.0f,\"powerPhase2\":%.0f,\"powerPhase3\":%.0f,\"energyCounterIn\":%.0f,\"energyCounterOut\":%.0f}", es_cpwr, es_avg, es_pa, es_pb, es_pc, ein, eout);
}

void esBuildEm() {
    sprintf(es_body, "{\"id\":0,\"a_act_power\":%.1f,\"b_act_power\":%.1f,\"c_act_power\":%.1f,\"total_act_power\":%.3f}", es_pa, es_pb, es_pc, es_cpwr);
}

// Shelly Pro EM50 is single-channel: one number, no phases. It gets the
// per-phase precision (1 place) - act_power is a direct measurement there, not
// a sum, so the 3 places the 3EM uses for its total would be invented.
void esBuildEm1() {
    sprintf(es_body, "{\"act_power\":%.1f}", es_cpwr);
}

// Full status in EM50 mode. A real Pro EM50 reports em1:0 / em1data:0 where the
// 3EM has em:0 / emdata:0. EXTRAPOLATED from the device shape - EM1.GetStatus
// above is the call AstraMeter actually implements and the one a battery polls.
void esBuildFullEm1() {
    float e1 = smlGet(2) * 1000.0;
    float e2 = smlGet(3) * 1000.0;
    sprintf(es_body, "{\"em1:0\":{\"id\":0,\"act_power\":%.1f},\"em1data:0\":{\"id\":0,\"total_act_energy\":%.2f,\"total_act_ret_energy\":%.2f}}", es_cpwr, e1, e2);
}

void esBuildFull() {
    float ein  = smlGet(2) * 1000.0;
    float eout = smlGet(3) * 1000.0;
    sprintf(es_body, "{\"em:0\":{\"id\":0,\"a_act_power\":%.1f,\"b_act_power\":%.1f,\"c_act_power\":%.1f,\"total_act_power\":%.3f},\"emdata:0\":{\"id\":0,\"a_total_act_energy\":%.2f,\"a_total_act_ret_energy\":%.2f,\"b_total_act_energy\":0.00,\"b_total_act_ret_energy\":0.00,\"c_total_act_energy\":0.00,\"c_total_act_ret_energy\":0.00,\"total_act\":%.2f,\"total_act_ret\":%.2f}}", es_pa, es_pb, es_pc, es_cpwr, ein, eout, ein, eout);
}

// ─── Shelly EM Gen3 ────────────────────────────────────────────────────────
// Modelled on the Scripter emulation in discussion #76, which is in the field
// and works with the Marstek app. The Gen3 answers a richer EM.GetStatus than
// the Pro 3EM - current, voltage, power factor and frequency per phase - and
// three RPCs the other two do not have at all.
//
// Voltage 230, power factor 1 and 50 Hz are fixed: an SML meter reports none of
// them, and the reference emulation states them the same way. The current is
// derived, power over 230 V, so the three per-phase values stay consistent with
// the powers next to them instead of being zero.
void esBuildEmG3() {
    float ia = es_pa / 230.0; if (ia < 0.0) ia = 0.0 - ia;
    float ib = es_pb / 230.0; if (ib < 0.0) ib = 0.0 - ib;
    float ic = es_pc / 230.0; if (ic < 0.0) ic = 0.0 - ic;
    sprintf(es_body, "{\"id\":0,\"a_current\":%.3f,\"a_voltage\":230.0,\"a_act_power\":%.1f,\"a_aprt_power\":%.1f,\"a_pf\":1.00,\"a_freq\":50.0,", ia, es_pa, es_pa);
    sprintfAppend(es_body, "\"b_current\":%.3f,\"b_voltage\":230.0,\"b_act_power\":%.1f,\"b_aprt_power\":%.1f,\"b_pf\":1.00,\"b_freq\":50.0,", ib, es_pb, es_pb);
    sprintfAppend(es_body, "\"c_current\":%.3f,\"c_voltage\":230.0,\"c_act_power\":%.1f,\"c_aprt_power\":%.1f,\"c_pf\":1.00,\"c_freq\":50.0,", ic, es_pc, es_pc);
    sprintfAppend(es_body, "\"n_current\":null,\"total_current\":%.3f,\"total_act_power\":%.3f,\"total_aprt_power\":%.3f}", ia + ib + ic, es_cpwr, es_cpwr);
}

// EMData.GetStatus - the energy counters on their own. Wh, like the 3EM path.
void esBuildEmData() {
    float ein  = smlGet(2) * 1000.0;
    float eout = smlGet(3) * 1000.0;
    sprintf(es_body, "{\"id\":0,\"a_total_act_energy\":%.2f,\"a_total_act_ret_energy\":%.2f}", ein, eout);
}

// Shelly.GetDeviceInfo and EM.GetConfig were served here as well - the
// Scripter emulation in discussion #76 answers them. They are gone again:
// AstraMeter's Shelly emulation replies to EM.GetStatus and EM1.GetStatus and
// to NOTHING else, and works with the Marstek app, so neither call appears to
// be required. Both were static strings, so nothing is lost that a meter
// reading depends on. Git remembers them if a client turns out to ask.

// NOT one sprintf. A variadic sprintf is split into segments of "literal + one
// value", and each segment goes through a 256-byte buffer twice in the firmware
// (SYS_SPRINTF_STR_CAT: tc_ref_to_cstr into srcbuf[256], then snprintf into
// tmp[256]). Feeding the ~310-character Shelly.GetStatus body through a `%s`
// therefore cut the reply at 296 bytes - valid-looking JSON with the tail
// missing, which the Marstek app silently rejects, so the device never showed
// up. EM.GetStatus (~80 chars) fit and worked, which is what made it look like
// a discovery problem. strcat copies element by element with no such buffer.
void esWrapUdp() {
    if (es_mode == 2)      sprintf(es_wrap, "{\"id\":0,\"src\":\"shellyproem50-%s\",\"result\":", es_mac);
    else if (es_mode == 3) sprintf(es_wrap, "{\"id\":0,\"src\":\"shellyemg3-%s\",\"result\":", es_mac);
    else                   sprintf(es_wrap, "{\"id\":0,\"src\":\"shellypro3em-%s\",\"result\":", es_mac);
    strcat(es_wrap, es_body);
    strcat(es_wrap, "}");
}

// ─── Building-block API ────────────────────────────────────────────────────

// From main(). w1/w2/w3 are the webOn handler numbers for /v1/json,
// /rpc/EM.GetStatus and /rpc/Shelly.GetStatus.
void esInit(int w1, int w2, int w3, int w4, int w5) {
    es_once_mdns = 0;
    es_once_udp  = 0;
    es_last_api  = 0;
    es_last_upd  = 0;
    es_cpwr = 0.0;
    es_avg  = 0.0;
    if (es_throttle < 1) es_throttle = 1;

    esEditLoad();
    tasmInfo(1, es_mac);        // hex without colons - but UPPERCASE, while a
    strToLower(es_mac);         // real Shelly reports its src in lowercase
    es_w1 = w1; es_w2 = w2; es_w3 = w3; es_w4 = w4;
    es_w5 = w5;
    webOn(w1, "/v1/json");
    webOn(w2, "/rpc/EM.GetStatus");
    webOn(w3, "/rpc/Shelly.GetStatus");
    webOn(w4, "/rpc/EM1.GetStatus");
    webOn(w5, "/rpc/EMData.GetStatus");       // Gen3
}

// From Every100ms(). Shelly mode answers RPC over UDP as well.
void esPoll() {
    if (es_mode == 0 || es_once_udp == 0) return;

    int n = udp(1, es_rxb);
    int served = 0;
    if (n > 0) {
        // EM1 first for readability - the three method names do not overlap as
        // substrings, so the order is not load-bearing.
        if (strFind(es_rxb, "EM1.GetStatus") >= 0) {
            esBuildEm1();
            esWrapUdp();
            udp(2, es_wrap);
            es_last_api = 3;
            served = 1;
        } else if (strFind(es_rxb, "EMData.GetStatus") >= 0) {
            esBuildEmData();
            esWrapUdp();
            udp(2, es_wrap);
            served = 1;            // static-ish, never replayed by force-send
        } else if (strFind(es_rxb, "EM.GetStatus") >= 0) {
            if (es_mode == 3) esBuildEmG3();
            else              esBuildEm();
            esWrapUdp();
            udp(2, es_wrap);
            es_last_api = 1;
            served = 1;
        } else if (strFind(es_rxb, "Shelly.GetStatus") >= 0) {
            if (es_mode == 2) esBuildFullEm1();
            else              esBuildFull();
            esWrapUdp();
            udp(2, es_wrap);
            es_last_api = 2;
            served = 1;
        }
    }
    // Some firmwares regulate better when the value keeps coming without a
    // request - repeat the last answered call.
    if (served == 0 && es_force > 0 && es_last_api > 0) {
        if (es_last_api == 1) {
            if (es_mode == 3) esBuildEmG3();
            else              esBuildEm();
        } else if (es_last_api == 3) {
            esBuildEm1();
        } else if (es_mode == 2) {
            esBuildFullEm1();
        } else {
            esBuildFull();
        }
        esWrapUdp();
        udp(2, es_wrap);
    }
}

// From EverySecond().
void esTick() {
    if (tc_opt_first == 1) {
        es_mode     = tcOptGet(13, es_mode);
        es_port     = tcOptGet(14, es_port);
        es_offset   = tcOptGet(15, es_offset);
        es_tweak    = tcOptGet(16, es_tweak);
        es_force    = tcOptGet(17, es_force);
        es_throttle = tcOptGet(18, es_throttle);
        tcOptSet(13, es_mode);
        tcOptSet(14, es_port);
        tcOptSet(15, es_offset);
        tcOptSet(16, es_tweak);
        tcOptSet(17, es_force);
        tcOptSet(18, es_throttle);
        esEditLoad();
    }
    if (ui_reloading) esEditLoad();
    if (ui_applying) esCommit();
    if (tasm_wifi == 1) {
        // Register once and ignore the result: mdnsRegister returns -1 while
        // Tasmota's own discovery holds the responder, and retrying every
        // second would block the VM.
        if (es_once_mdns == 0) {
            if (es_mode == 1) {
                mdnsRegister("shellypro3em-", "-", "shelly");
            } else if (es_mode == 2) {
                mdnsRegister("shellyproem50-", "-", "shelly");
            } else if (es_mode == 3) {
                mdnsRegister("shellyemg3-", "-", "shelly");
            } else {
                mdnsRegister("ecotracker-", "-", "everhome");
            }
            es_once_mdns = 1;
        }
        if (es_mode != 0 && es_once_udp == 0) {
            es_bound = 1010;
            if (es_port == 1) es_bound = 2220;
            if (es_mode == 2) es_bound = 2223;   // EM50 has one port, no choice
            if (es_mode == 3) es_bound = 2222;   // EM Gen3 likewise
            if (udp(0, es_bound) == 1) {
                es_once_udp = 1;
                addLog("eco_shelly: Shelly UDP on port %d", es_bound);
            }
        }
    }

    if (es_throttle < 1) es_throttle = 1;
    if (tasm_uptime - es_last_upd < es_throttle) return;
    es_last_upd = tasm_uptime;

    es_cpwr = esCtrl(smlGet(1));      // saldierend total, as before
    if (sml_ph3 == 1) {
        es_pa = esCtrl(smlGet(4));
        es_pb = esCtrl(smlGet(5));
        es_pc = esCtrl(smlGet(6));
    } else {
        es_pa = es_cpwr;              // single-value meter: all on L1
        es_pb = 0.0;
        es_pc = 0.0;
    }
    es_avg = (0.9 * es_avg) + (0.1 * es_cpwr);
}

// From WebOn(). Returns 1 when the request was ours.
int esWebOn(int h) {
    if (h == es_w1) {
        // Raw mode + keep-alive: some battery firmwares (Jackery, NOAH)
        // reject Tasmota's chunked wrapper. Emit exactly what a real
        // EcoTracker sends.
        webRawMode();
        esBuildEco();
        int blen = strlen(es_body);
        sprintf(es_hdr, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: %d\r\n\r\n", blen);
        webRawWrite(es_hdr);
        webRawWrite(es_body);
        webKeepAlive();
        return 1;
    }
    if (h == es_w2) {
        if (es_mode == 3) esBuildEmG3();
        else              esBuildEm();
        webSend(es_body);
        return 1;
    }
    if (h == es_w3) {
        if (es_mode == 2) esBuildFullEm1();
        else              esBuildFull();
        webSend(es_body);
        return 1;
    }
    if (h == es_w4) {
        esBuildEm1();
        webSend(es_body);
        return 1;
    }
    if (h == es_w5) {
        esBuildEmData();
        webSend(es_body);
        return 1;
    }
    return 0;
}

// From WebCall(): rows for the main sensor page.
void esRows() {
    if (es_mode != 0) {
        if (es_mode == 2)      sprintf(es_body, "{s}Emulation{m}Shelly Pro EM50 (UDP %d){e}", es_bound);
        else if (es_mode == 3) sprintf(es_body, "{s}Emulation{m}Shelly EM Gen3 (UDP %d){e}", es_bound);
        else                   sprintf(es_body, "{s}Emulation{m}Shelly Pro 3EM (UDP %d){e}", es_bound);
    } else {
        strcpy(es_body, "{s}Emulation{m}EcoTracker{e}");
    }
    webSend(es_body);
    if (ui_de) sprintf(es_body, "{s}An den Akku{m}%.0f W{e}", es_cpwr);
    else       sprintf(es_body, "{s}To battery{m}%.0f W{e}", es_cpwr);
    webSend(es_body);
}

// A port row that cannot be changed: same markup the webPulldown widget emits
// (<div><label><b>..</b> <select>..</select></label></div>), only with the
// select disabled, so the browser greys it out and it still lines up with the
// rows around it.
void esPortFixed(char label[], char text[]) {
    sprintf(es_body, "<div><label><b>%s</b> <select disabled><option>%s</option></select></label></div>", label, text);
    webSend(es_body);
}

// From WebUI(): emitted inside an already-open settings panel.
void esPanel() {
    webSend("<style>a.i{text-decoration:none;margin-left:6px}</style>");

    uiHead("&#x1F50C;", "Emulation", "Emulation", "eco_shelly/#mode");
    if (ui_de) {
        webPulldown(es_e_mode, "Modus", "EcoTracker|Shelly Pro 3EM|Shelly Pro EM50|Shelly EM Gen3");
        if (es_e_mode == 1)      webPulldown(es_e_port, "UDP-Port", "1010|2220 (B2500)");
        else if (es_e_mode == 2) esPortFixed("UDP-Port", "2223 (fest)");
        else if (es_e_mode == 3) esPortFixed("UDP-Port", "2222 (fest)");
        else                     esPortFixed("UDP-Port", "kein UDP");
    } else {
        webPulldown(es_e_mode, "Mode", "EcoTracker|Shelly Pro 3EM|Shelly Pro EM50|Shelly EM Gen3");
        if (es_e_mode == 1)      webPulldown(es_e_port, "UDP port", "1010|2220 (B2500)");
        else if (es_e_mode == 2) esPortFixed("UDP port", "2223 (fixed)");
        else if (es_e_mode == 3) esPortFixed("UDP port", "2222 (fixed)");
        else                     esPortFixed("UDP port", "no UDP");
    }
    // The port row is drawn in EVERY mode, greyed out where there is nothing to
    // pick. While it was drawn only for the Pro 3EM it had to APPEAR when the
    // mode pulldown changed, and that never reached the screen: the widget
    // carries onfocusin='pr(0)', which stops the 2 s refresh while the select
    // has focus, and the innerHTML swap that would have brought the row in
    // destroys the focused element before onfocusout can start it again.
    // A row that is always present cannot fail to show up.
    //
    // A mode switch takes effect at once - esCommit() clears the once-flags, and
    // since firmware 1.6.65 mdnsRegister() removes the old services before it
    // adds the new ones. Before that the device answered under BOTH
    // _shelly._tcp and _everhome._tcp until it was restarted; measured with a
    // PTR query, both TXT sets live. On 1.6.64 that leftover is still there.

    uiHead("&#x1F50B;", "Battery", "Akku", "eco_shelly/#battery");
    if (ui_de) {
        webNumber(es_e_offset, -200, 200, "Offset [W]");
        webCheckbox(es_e_tweak, "Regleroptimierung");
        webNumber(es_e_throttle, 1, 60, "Update-Rate [s]");
        if (es_e_mode != 0) webCheckbox(es_e_force, "Senden erzwingen");
    } else {
        webNumber(es_e_offset, -200, 200, "Offset [W]");
        webCheckbox(es_e_tweak, "Regulator tweak");
        webNumber(es_e_throttle, 1, 60, "Update rate [s]");
        if (es_e_mode != 0) webCheckbox(es_e_force, "Force sending");
    }
}

// From JsonCall(): appended to the SENSOR telemetry.
// These are NOT the meter's phases - MT175.L1/L2/L3 come straight from the
// descriptor. es_pa/pb/pc are what the battery is actually told, offset and
// regulator shaping applied, so the two differ as soon as an offset is set.
// Only emitted with a three-phase meter: without one esTick() puts the total
// on es_pa and zeroes the rest, and publishing that would invent two phases.
void esJson() {
    sprintf(es_body, ",\"PVEmu\":{\"Power\":%.0f", es_cpwr);
    sprintfAppend(es_body, ",\"Avg\":%.0f", es_avg);
    if (sml_ph3 == 1) {
        sprintfAppend(es_body, ",\"L1\":%.0f,\"L2\":%.0f,\"L3\":%.0f", es_pa, es_pb, es_pc);
    }
    sprintfAppend(es_body, ",\"Mode\":%d}", es_mode);
    responseAppend(es_body);
}
