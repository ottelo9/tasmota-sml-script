// sml_chart_common.tc — chart engine for the SML family: rolling 4 h / 24 h
// power charts plus daily, monthly and yearly totals, both directions.
// Consumption side first, feed-in side after the separator further down.
//
// The including program owns the callbacks and calls, per side:
//   sml_chart_load()      / sml_chart_pv_load()       once from main()
//   sml_chart_5s_tick()   / sml_chart_pv_5s_tick()    every 5 s
//   sml_chart_60s_tick()  / sml_chart_pv_60s_tick()   every 60 s
//   sml_chart_init_baselines/_init_columns/_save()    and their _pv_ twins
//   sml_chart_render_totals/_4h/_24h/_days/_months()  the charts
//   sml_chart_pv_render_dayprod/_render_months_dual() the PV charts
//   sml_chart_data_panel()                            the two reset buttons
// Exception: CleanUp() and OnExit() are defined here, both only saveVars().
//
// Chart state ~8 KB: s4h 481 + s24h 1441 + dcon 31 + mcon 12 + dprod 31 +
// mprod 12 floats.

#include "sml_descriptor.tc"

// ── Energy baselines (delta against current SML kWh counter) ────────────────
persist float sml_dval;         // daily zero point
persist float sml_mval;         // monthly zero point
persist float sml_yval;         // yearly zero point
persist int   sml_da;           // last seen day-of-month (month-wrap detector)

// ── Rolling-power chart arrays — head index in a separate cursor ────────────
// MUST be float arrays — WebChart memcpy's each int32 slot into a float
// (vm.h SYS_WEB_CHART: `memcpy(&fval, &arr[idx], sizeof(float))`). Int
// arrays render as garbage values (bit-cast).
persist float sml_s4h[481];     // 4 h chart, 30 s per slot
persist float sml_s24h[1441];   // 24 h chart, 60 s per slot
persist int   sml_s4h_pos;
persist int   sml_s24h_pos;

// ── Daily / monthly columnar totals — 0-based indexing matching WebChart's
// ring-buffer walk (pos-count+i, mod count). Day 1 = index 0, Month 1 = 0.
persist float sml_dcon[31];
persist float sml_mcon[12];

// ── Runtime state — moving filter rings + tick counters ─────────────────────
int sml_s4hf[6];                // 6×5s = 30s average window for 4 h chart
int sml_s24hf[12];              // 12×5s = 60s average window for 24 h chart
int sml_f4_pos;
int sml_f24_pos;
int sml_t1;                     // 5s downcounter
int sml_t2;                     // 60s downcounter
int sml_hr_last;                // last seen tasm_hour (midnight edge detect)
// sml_buf is declared in sml_descriptor.tc and shared by both modules

// ── Storage ────────────────────────────────────────────────────────────────
// Arrays and baselines both live in the slot's .pvs, so a backup is that one
// file: copy it away, copy it back, restart the slot. Keeping the arrays in a
// separate .bin used to lose the baselines, and the next 60 s tick then wrote
// the whole meter reading into today's bar.
//
// Needs firmware >= 1.6.42: only there do heap persist arrays survive a reload
// and is the .pvs name-based. Older firmware returns the arrays as zeros.
// ============================================================================

// ── One-time import of the old /sml_chart.bin ──────────────────────────────
// Read once, written into the .pvs, then renamed to /sml_chart.bin.done. The
// renamed file is both the backup and the "already imported" marker.
// Same path for a .bin from sml_chart_editor.html: upload it as
// /sml_chart.bin and restart the slot.
#ifndef CHART_CSV_DEC
#define CHART_CSV_DEC 3
#endif

char sml_mtopic[64];        // device topic - Publish never expands %topic%

void sml_chart_load() {
    tasmInfo(0, sml_mtopic);
    int h = fileOpen("/sml_chart.bin", "r");
    if (h < 0) return;                          // nothing to import
    fileReadBin(h, sml_s4h,  481);
    fileReadBin(h, sml_s24h, 1441);
    fileReadBin(h, sml_dcon, 31);
    fileReadBin(h, sml_mcon, 12);
    fileClose(h);
    saveVars();                                 // the .pvs rules from here on
    if (fileRename("/sml_chart.bin", "/sml_chart.bin.done") < 0) {
        // Target exists from an earlier import. Drop it and retry, or the .bin
        // would be re-read on every start and overwrite newer data.
        fileDelete("/sml_chart.bin.done");
        fileRename("/sml_chart.bin", "/sml_chart.bin.done");
    }
    addLog("sml_chart: imported .bin into .pvs, renamed to /sml_chart.bin.done");
}

// Writing the persist vars covers arrays and baselines in one go.
void sml_chart_save() {
    saveVars();
}

// Readable export for backup and spreadsheets. Not the storage path.
// Baselines go in line 1 on purpose - a backup without them was the old bug.
void sml_chart_export_csv() {
    int h = fileOpen("/sml_chart.csv", "w");
    if (h < 0) {
        addLog("sml_chart_export_csv: fileOpen failed");
        return;
    }
    char kopf[96];
    sprintf(kopf, "%.3f\t%.3f\t%.3f\t%d\n", sml_dval, sml_mval, sml_yval, sml_da);
    fileWrite(h, kopf, strlen(kopf));
    fileWriteArray(sml_s4h,  h, 481,  0, CHART_CSV_DEC);
    fileWriteArray(sml_s24h, h, 1441, 0, CHART_CSV_DEC);
    fileWriteArray(sml_dcon, h, 31,   0, CHART_CSV_DEC);
    fileWriteArray(sml_mcon, h, 12,   0, CHART_CSV_DEC);
    fileClose(h);
    addLog("sml_chart: wrote /sml_chart.csv (baselines in line 1)");
}

// Save on shutdown: CleanUp() = device restart / OTA, OnExit() = this slot
// stopped. The firmware saves at TinyCStop anyway; these cover the OTA path.
void CleanUp() {
    saveVars();
}
void OnExit() {
    saveVars();
}

// ============================================================================
// Init helpers — reset baselines from current meter, reset chart arrays
// ============================================================================
void sml_chart_init_baselines() {
    float ein = smlGet(2);
    sml_dval = ein;
    sml_mval = ein;
    sml_yval = ein;
    sml_s4h_pos  = 0;
    sml_s24h_pos = 0;
    int i = 0;
    while (i < 481)  { sml_s4h[i]  = 0.0; i = i + 1; }
    i = 0;
    while (i < 1441) { sml_s24h[i] = 0.0; i = i + 1; }
    sml_chart_save();
    addLog("sml_chart: baselines set from meter, power charts cleared");
}

void sml_chart_init_columns() {
    int i = 0;
    while (i < 31) { sml_dcon[i] = 0.0; i = i + 1; }
    i = 0;
    while (i < 12) { sml_mcon[i] = 0.0; i = i + 1; }
    sml_chart_save();
    addLog("sml_chart: daily + monthly column charts cleared");
}

// 5-s tick: feed the moving-average filters, push to the rolling arrays.
void sml_chart_5s_tick() {
    int p = (int)smlGet(1);             // current power in W (int filter ring)
    sml_s4hf[sml_f4_pos] = p;
    sml_f4_pos = (sml_f4_pos + 1) % 6;
    sml_s24hf[sml_f24_pos] = p;
    sml_f24_pos = (sml_f24_pos + 1) % 12;

    int sum = 0;
    int i = 0;
    while (i < 6) { sum = sum + sml_s4hf[i]; i = i + 1; }
    float s4h_avg = (float)sum / 6.0;

    sum = 0;
    i = 0;
    while (i < 12) { sum = sum + sml_s24hf[i]; i = i + 1; }
    float s24h_avg = (float)sum / 12.0;

    // 240-slot ring at 1 min/slot = the last 4 h, sliding. Two fixes vs the old
    // ((hour-4)%24)*120 mapping: (1) that only produced idx4 < 480 for hours
    // 4..7, so outside 04:00-08:00 nothing was stored and the chart was empty;
    // (2) 1-min slots match the WebChart x-axis interval=1, so 240 points span a
    // real 4 h axis — the previous 480 30-s points were drawn over an 8 h axis.
    int idx4  = (tasm_hour * 60 + tasm_minute) % 240;
    int idx24 = tasm_hour * 60 + tasm_minute;
    if (idx4 >= 0 && idx4 < 240) {
        sml_s4h[idx4] = s4h_avg;
        sml_s4h_pos = idx4;
    }
    if (idx24 >= 0 && idx24 < 1440) {
        sml_s24h[idx24] = s24h_avg;
        sml_s24h_pos = idx24;
    }
}

// 60-s tick: daily / monthly counters + midnight rollover.
void sml_chart_60s_tick() {
    float ein = smlGet(2);
    int   d   = tasm_day;        // 1..31
    int   m   = tasm_month;      // 1..12

    if (d >= 1 && d <= 31) sml_dcon[d - 1] = ein - sml_dval;
    if (m >= 1 && m <= 12) sml_mcon[m - 1] = ein - sml_mval;

    int hr = tasm_hour;
    if (sml_hr_last != hr && hr == 0) {
        if (d > 1) {
            sml_da = d;
        } else {
            // Month-wrap — zero out days past the previous month's length.
            // sml_da still holds last-seen 1..31; zero indices [sml_da..30].
            int i = sml_da;
            while (i < 31) { sml_dcon[i] = 0.0; i = i + 1; }
            sml_mval = ein;
            sml_da = 1;
        }
        if (d == 1 && m == 1) sml_yval = ein;
        sml_dval = ein;
        sml_chart_save();
    }
    sml_hr_last = hr;
}

// ============================================================================
// Render helpers — chart + table blocks for the WebUI main page
// ============================================================================
void sml_chart_render_totals() {
    // The live meter values, so the driver's own rows can be switched off -
    // they prefix every value with the meter name, which reads badly.
    if (ui_de) {
        sprintf(sml_buf, "{s}Leistung{m}%.0f W{e}", smlGet(1));      webSend(sml_buf);
        sprintf(sml_buf, "{s}Bezug{m}%.3f kWh{e}", smlGet(2));       webSend(sml_buf);
        sprintf(sml_buf, "{s}Einspeisung{m}%.3f kWh{e}", smlGet(3)); webSend(sml_buf);
    } else {
        sprintf(sml_buf, "{s}Power{m}%.0f W{e}", smlGet(1));         webSend(sml_buf);
        sprintf(sml_buf, "{s}Import{m}%.3f kWh{e}", smlGet(2));      webSend(sml_buf);
        sprintf(sml_buf, "{s}Export{m}%.3f kWh{e}", smlGet(3));      webSend(sml_buf);
    }

    // Date + uptime, wanted on the main page
    if (ui_de) sprintf(sml_buf, "{s}Datum{m}%02d.%02d.%04d %02d:%02d{e}", tasm_day, tasm_month, tasm_year, tasm_hour, tasm_minute);
    else       sprintf(sml_buf, "{s}Date{m}%02d.%02d.%04d %02d:%02d{e}", tasm_day, tasm_month, tasm_year, tasm_hour, tasm_minute);
    webSend(sml_buf);
    int up_d = tasm_uptime / 86400;
    int up_h = (tasm_uptime / 3600) % 24;
    int up_m = (tasm_uptime / 60) % 60;
    sprintf(sml_buf, "{s}Uptime{m}%d d %d h %d min{e}", up_d, up_h, up_m); webSend(sml_buf);

    float ein = smlGet(2);
    if (ui_de) {
        sprintf(sml_buf, "{s}Tagesverbrauch{m}%.2f kWh{e}",  ein - sml_dval); webSend(sml_buf);
        sprintf(sml_buf, "{s}Monatsverbrauch{m}%.2f kWh{e}", ein - sml_mval); webSend(sml_buf);
        sprintf(sml_buf, "{s}Jahresverbrauch{m}%.2f kWh{e}", ein - sml_yval); webSend(sml_buf);
    } else {
        sprintf(sml_buf, "{s}Import day{m}%.2f kWh{e}",   ein - sml_dval); webSend(sml_buf);
        sprintf(sml_buf, "{s}Import month{m}%.2f kWh{e}", ein - sml_mval); webSend(sml_buf);
        sprintf(sml_buf, "{s}Import year{m}%.2f kWh{e}",  ein - sml_yval); webSend(sml_buf);
    }
}

// Script JS hook applied to both rolling charts: filled area (better
// readability) + DE date in the tooltip (dd.MM.yyyy), independent of the
// browser locale. WebChartJS runs in the chart's draw scope (dt/o/el) and
// o.done=1 takes over the draw so it renders as an AreaChart.
char sml_chart_js[224];   // must hold the full snippet incl. trailing o.done=1

void sml_chart_area_de() {
    strcpy(sml_chart_js,
        "var f=new google.visualization.DateFormat({pattern:'dd.MM.yyyy HH:mm'});f.format(dt,0);o.areaOpacity=0.3;new google.visualization.AreaChart(el).draw(dt,o);o.done=1");
    WebChartJS(sml_chart_js);
}

void sml_chart_render_4h() {
    WebChartSize(600, 280);
    // 240 points at interval=1 min = a 4 h x-axis (matches the 240-slot 1-min
    // ring). Filled area + DE date via the hook.
    if (ui_de) WebChart(0, "Verbrauch 4 Stunden [Watt]", "W", 0x3498db, sml_s4h_pos, 240, sml_s4h, 0, 1, 0.0, 0.0);
    else       WebChart(0, "Power 4 hours [Watt]", "W", 0x3498db, sml_s4h_pos, 240, sml_s4h, 0, 1, 0.0, 0.0);
    sml_chart_area_de();
}

void sml_chart_render_24h() {
    WebChartSize(600, 280);
    if (ui_de) WebChart(0, "Verbrauch 24 Stunden [Watt]", "W", 0x3498db, sml_s24h_pos, 1440, sml_s24h, 0, 1, 0.0, 0.0);
    else       WebChart(0, "Power 24 hours [Watt]", "W", 0x3498db, sml_s24h_pos, 1440, sml_s24h, 0, 1, 0.0, 0.0);
    sml_chart_area_de();
}

// ── Direct Google Charts emit — per-bar tri-color (past=green / today=red /
//    future=blue) and day-of-month x-axis. WebChart's built-in axis
//    formatter shows DD.MM. for >7 column points and doesn't support
//    per-bar styles, so we bypass it for the column charts. Loader is
//    already on the page from the WebChart line-chart calls above.
// The two destructive data buttons, identical in every chart wiring - so they
// live here once. Pass the already-resolved widget indices:
//     sml_chart_data_panel(varIdx(do_init), varIdx(do_init2));
void sml_chart_data_panel(int idx_init, int idx_init2) {
    uiHead("&#x1F4BE;", "Data", "Daten", "sml/#data");
    uiText("<div style='font-size:11px;color:#a00;margin:4px 0'>&#9888; Both actions overwrite history.</div>",
           "<div style='font-size:11px;color:#a00;margin:4px 0'>&#9888; Beide Aktionen überschreiben Verlaufsdaten.</div>");

    if (ui_de) {
        webSend("<div><button style='width:100%' data-a='erledigt' onclick='if(confirm(\"Nullpunkte neu vom Zählerstand setzen und 4h/24h-Charts leeren?\"))tcbtn(this,1,");
        sprintf(sml_buf, "%d)'>Nullpunkte setzen + Power-Charts leeren</button></div>", idx_init);
    } else {
        webSend("<div><button style='width:100%' data-a='done' onclick='if(confirm(\"Reset the day/month/year baselines from the meter and clear the 4h/24h charts?\"))tcbtn(this,1,");
        sprintf(sml_buf, "%d)'>Reset baselines + clear power charts</button></div>", idx_init);
    }
    webSend(sml_buf);

    if (ui_de) {
        webSend("<div><button style='width:100%' data-a='erledigt' onclick='if(confirm(\"ALLE Tages- und Monatsbalken loeschen?\"))tcbtn(this,1,");
        sprintf(sml_buf, "%d)'>Balkendiagramme zurücksetzen</button></div>", idx_init2);
    } else {
        webSend("<div><button style='width:100%' data-a='done' onclick='if(confirm(\"Delete ALL day and month bars?\"))tcbtn(this,1,");
        sprintf(sml_buf, "%d)'>Reset bar charts</button></div>", idx_init2);
    }
    webSend(sml_buf);
}

void sml_chart_render_days() {
    int today = tasm_day;
    if (today < 1) today = 1;
    webSend("<div id='sml_dch' style='text-align:center;width:600px;height:280px'></div>");
    if (ui_de) webSend("<script>function _smlDD(){var d=google.visualization.arrayToDataTable([['Tag','Energie [kWh]',{role:'style'}]");
    else       webSend("<script>function _smlDD(){var d=google.visualization.arrayToDataTable([['Day','Energy [kWh]',{role:'style'}]");
    int i = 1;
    while (i <= 31) {
        if (i < today)        sprintf(sml_buf, ",[%d,%.2f,'green']", i, sml_dcon[i - 1]);
        else if (i == today)  sprintf(sml_buf, ",[%d,%.2f,'red']",   i, sml_dcon[i - 1]);
        else                  sprintf(sml_buf, ",[%d,%.2f,'blue']",  i, sml_dcon[i - 1]);
        webSend(sml_buf);
        i = i + 1;
    }
    // Split instead of sprintf: the block contains '75%' and '# kWh', which a
    // format string would eat. webSend concatenates, so three calls are fine.
    webSend("]);new google.visualization.ColumnChart(document.getElementById('sml_dch')).draw(d,{chartArea:{left:50,right:20,height:'75%',backgroundColor:'#f0f2f5'},legend:'none',title:'");
    if (ui_de) {
        webSend("Tagesverbraeuche Monatsansicht',vAxis:{format:'# kWh'},hAxis:{title:'Tag',ticks:[1,5,10,15,20,25,30]}});}google.charts.setOnLoadCallback(_smlDD);</script>");
    } else {
        webSend("Import per day',vAxis:{format:'# kWh'},hAxis:{title:'Day',ticks:[1,5,10,15,20,25,30]}});}google.charts.setOnLoadCallback(_smlDD);</script>");
    }
}

void sml_chart_render_months() {
    int thismon = tasm_month;
    if (thismon < 1) thismon = 1;
    // strToken needs the source as a resolvable char[] variable — string
    // literals fall through tc_resolve_ref and return empty (the earlier
    // version produced ['',12.3,...] with no month names on the x-axis).
    char mn_names[64];
    if (ui_de) strcpy(mn_names, "Jan|Feb|Mär|Apr|Mai|Jun|Jul|Aug|Sep|Okt|Nov|Dez");
    else       strcpy(mn_names, "Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec");
    char mn[6];
    webSend("<div id='sml_mch' style='text-align:center;width:600px;height:280px'></div>");
    if (ui_de) webSend("<script>function _smlDM(){var d=google.visualization.arrayToDataTable([['Monat','Verbrauch [kWh]',{role:'style'}]");
    else       webSend("<script>function _smlDM(){var d=google.visualization.arrayToDataTable([['Month','Import [kWh]',{role:'style'}]");
    int i = 1;
    while (i <= 12) {
        strToken(mn, mn_names, '|', i);
        if (i < thismon)        sprintf(sml_buf, ",['%s',%.2f,'green']", mn, sml_mcon[i - 1]);
        else if (i == thismon)  sprintf(sml_buf, ",['%s',%.2f,'red']",   mn, sml_mcon[i - 1]);
        else                    sprintf(sml_buf, ",['%s',%.2f,'blue']",  mn, sml_mcon[i - 1]);
        webSend(sml_buf);
        i = i + 1;
    }
    webSend("]);new google.visualization.ColumnChart(document.getElementById('sml_mch')).draw(d,{chartArea:{left:50,right:30,top:30,height:'70%',backgroundColor:'#f0f2f5'},legend:'none',title:'");
    if (ui_de) {
        webSend("Monatsverbraeuche Jahresansicht',vAxis:{format:'# kWh'},hAxis:{slantedText:false,showTextEvery:1}});}google.charts.setOnLoadCallback(_smlDM);</script>");
    } else {
        webSend("Import per month',vAxis:{format:'# kWh'},hAxis:{slantedText:false,showTextEvery:1}});}google.charts.setOnLoadCallback(_smlDM);</script>");
    }
}

// Settings panel renderer is in sml_descriptor.tc as
// `sml_render_settings_panel()` — including modules call that directly.

// ════ Feed-in side ═════════════════════════════════════════════════════════

// ── Production-side persist state ──────────────────────────────────────────
persist float sml_dval2;             // daily zero point for energy-out (kWh)
persist float sml_mval2;             // monthly zero point
persist float sml_yval2;             // yearly zero point
persist float sml_dprod[31];         // 31 days of production totals
persist float sml_mprod[12];         // 12 months of production totals

persist watch int sml_sndpwr;        // 1 = publish smoothed power via MQTT

// ── Runtime state ──────────────────────────────────────────────────────────
float sml_power2;                    // exponentially-smoothed power [W]
int   sml_pv_hr_last;                // PV-side midnight edge detector
char  sml_pv_resp[64];               // tasmCmd response buffer

#ifdef SML_CHART_DEMO
void sml_chart_pv_demo_fill() {
    // Match the consumption-side demo curves so the multi-chart page
    // shows recognisable shapes before any live meter data lands.
    int i = 0;
    while (i < 480) {
        float x = ((float)i - 240.0) / 60.0;
        float bell = cos(x * 0.5);
        if (bell < 0.0) bell = 0.0;
        sml_s4h[i] = bell * bell * 5000.0 + 200.0;
        i = i + 1;
    }
    sml_s4h_pos = 240;

    i = 0;
    while (i < 1440) {
        float t = (float)i;
        float solar = 0.0;
        if (t > 360.0 && t < 1080.0) {
            float phase = (t - 360.0) / 720.0;
            solar = sin(phase * 3.14159);
            solar = solar * solar * 4500.0;
        }
        sml_s24h[i] = solar + 150.0;
        i = i + 1;
    }
    sml_s24h_pos = 720;

    i = 0;
    while (i < 31) {
        float ph = (float)i / 31.0 * 6.28318;
        sml_dcon[i]  = 15.0 + 10.0 * cos(ph);          // consumption 5..25 kWh
        sml_dprod[i] =  9.0 +  7.0 * cos(ph + 1.57);   // production phase-shifted
        i = i + 1;
    }
    i = 0;
    while (i < 12) {
        float ph = (float)i / 12.0 * 6.28318;
        sml_mcon[i]  = 325.0 + 125.0 * cos(ph);
        sml_mprod[i] = 180.0 + 100.0 * cos(ph + 3.14); // anti-phase to consumption
        i = i + 1;
    }
    addLog("sml_chart_pv: demo data loaded into all six chart blocks");
}
#endif

// Arrays and baselines go into the slot's .pvs, same as the consumption side.
void sml_chart_pv_save() {
    saveVars();
}

// One-time import of the old /sml_chart_pv.bin, then renamed. Each file
// carries its own rename, so the order of the two load() calls is free.
void sml_chart_pv_load() {
    int h = fileOpen("/sml_chart_pv.bin", "r");
    if (h < 0) return;
    fileReadBin(h, sml_dprod, 31);
    fileReadBin(h, sml_mprod, 12);
    fileClose(h);
    saveVars();
    if (fileRename("/sml_chart_pv.bin", "/sml_chart_pv.bin.done") < 0) {
        fileDelete("/sml_chart_pv.bin.done");
        fileRename("/sml_chart_pv.bin", "/sml_chart_pv.bin.done");
    }
    addLog("sml_chart_pv: imported .bin into .pvs, renamed to /sml_chart_pv.bin.done");
}

// Readable export incl. baselines, see sml_chart_export_csv.
void sml_chart_pv_export_csv() {
    int h = fileOpen("/sml_chart_pv.csv", "w");
    if (h < 0) {
        addLog("sml_chart_pv_export_csv: fileOpen failed");
        return;
    }
    char kopf[96];
    sprintf(kopf, "%.3f\t%.3f\t%.3f\n", sml_dval2, sml_mval2, sml_yval2);
    fileWrite(h, kopf, strlen(kopf));
    fileWriteArray(sml_dprod, h, 31, 0, CHART_CSV_DEC);
    fileWriteArray(sml_mprod, h, 12, 0, CHART_CSV_DEC);
    fileClose(h);
    addLog("sml_chart_pv: wrote /sml_chart_pv.csv (baselines in line 1)");
}

void sml_chart_pv_init_baselines() {
    float eout = smlGet(3);
    sml_dval2 = eout;
    sml_mval2 = eout;
    sml_yval2 = eout;
    sml_chart_pv_save();
    addLog("sml_chart_pv: production baselines set from meter");
}

void sml_chart_pv_init_columns() {
    int i = 0;
    while (i < 31) { sml_dprod[i] = 0.0; i = i + 1; }
    i = 0;
    while (i < 12) { sml_mprod[i] = 0.0; i = i + 1; }
    sml_chart_pv_save();
}

// 5-s smoothing — first-order EMA on smlGet(1) with α=0.1 (heavy smoothing).
// MQTT-publishes the smoothed value when sml_sndpwr is enabled.
void sml_chart_pv_5s_tick() {
    sml_power2 = 0.9 * sml_power2 + 0.1 * smlGet(1);
    if (sml_sndpwr) {
        sprintf(sml_buf, "publish stat/%s/script/power2 %d", sml_mtopic, (int)sml_power2);
        tasmCmd(sml_buf, sml_pv_resp);
    }
}

// 60-s tick: production counters + midnight rollover of the PV baselines.
void sml_chart_pv_60s_tick() {
    float eout = smlGet(3);
    int   d    = tasm_day;
    int   m    = tasm_month;

    if (d >= 1 && d <= 31) sml_dprod[d - 1] = eout - sml_dval2;
    if (m >= 1 && m <= 12) sml_mprod[m - 1] = eout - sml_mval2;

    int hr = tasm_hour;
    if (sml_pv_hr_last != hr && hr == 0) {
        if (d == 1) {
            // Month-wrap — zero days past previous month's length.
            int i = sml_da;
            while (i < 31) { sml_dprod[i] = 0.0; i = i + 1; }
            sml_mval2 = eout;
        }
        if (d == 1 && m == 1) sml_yval2 = eout;
        sml_dval2 = eout;
        sml_chart_pv_save();
    }
    sml_pv_hr_last = hr;
}

// ── Renderers. The 4 h / 24 h line charts and the consumption day chart
//    come from sml_chart_common. ─────────────────────────────────────────────

void sml_chart_pv_render_dayprod() {
    int today = tasm_day;
    if (today < 1) today = 1;
    webSend("<div id='sml_dpch' style='text-align:center;width:600px;height:280px'></div>");
    if (ui_de) webSend("<script>function _smlDP(){var d=google.visualization.arrayToDataTable([['Tag','Einspeisung [kWh]',{role:'style'}]");
    else       webSend("<script>function _smlDP(){var d=google.visualization.arrayToDataTable([['Day','Export [kWh]',{role:'style'}]");
    int i = 1;
    while (i <= 31) {
        if (i < today)        sprintf(sml_buf, ",[%d,%.2f,'green']", i, sml_dprod[i - 1]);
        else if (i == today)  sprintf(sml_buf, ",[%d,%.2f,'red']",   i, sml_dprod[i - 1]);
        else                  sprintf(sml_buf, ",[%d,%.2f,'blue']",  i, sml_dprod[i - 1]);
        webSend(sml_buf);
        i = i + 1;
    }
    webSend("]);new google.visualization.ColumnChart(document.getElementById('sml_dpch')).draw(d,{chartArea:{left:50,right:20,height:'75%',backgroundColor:'#f0f2f5'},legend:'none',title:'");
    if (ui_de) {
        webSend("Tageseinspeisungen Monatsansicht',vAxis:{format:'# kWh'},hAxis:{title:'Tag',ticks:[1,5,10,15,20,25,30]}});}google.charts.setOnLoadCallback(_smlDP);</script>");
    } else {
        webSend("Export per day',vAxis:{format:'# kWh'},hAxis:{title:'Day',ticks:[1,5,10,15,20,25,30]}});}google.charts.setOnLoadCallback(_smlDP);</script>");
    }
}

// Dual-series month chart, replaces sml_chart_common's single-series one:
// consumption and feed-in side by side, two y-axes so both ranges scale.
void sml_chart_pv_render_months_dual() {
    char mn_names[64];
    if (ui_de) strcpy(mn_names, "Jan|Feb|Mär|Apr|Mai|Jun|Jul|Aug|Sep|Okt|Nov|Dez");
    else       strcpy(mn_names, "Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec");
    char mn[6];
    webSend("<div id='sml_mch2' style='text-align:center;width:600px;height:280px'></div>");
    if (ui_de) webSend("<script>function _smlDM2(){var d=google.visualization.arrayToDataTable([['Monat','Verbrauch [kWh]','Einspeisung [kWh]']");
    else       webSend("<script>function _smlDM2(){var d=google.visualization.arrayToDataTable([['Month','Import [kWh]','Export [kWh]']");
    int i = 1;
    while (i <= 12) {
        strToken(mn, mn_names, '|', i);
        sprintf(sml_buf, ",['%s',%.2f,%.2f]", mn, sml_mcon[i - 1], sml_mprod[i - 1]);
        webSend(sml_buf);
        i = i + 1;
    }
    webSend("]);new google.visualization.ColumnChart(document.getElementById('sml_mch2')).draw(d,{chartArea:{left:60,right:60,top:30,height:'70%',backgroundColor:'#f0f2f5'},legend:{position:'top'},title:'");
    if (ui_de) {
        webSend("Monatsverbraeuche / -einspeisungen Jahresansicht");
    } else {
        webSend("Import / export per month");
    }
    webSend("',series:{0:{color:'#27ae60',targetAxisIndex:0},1:{color:'#f39c12',targetAxisIndex:1}},vAxes:{0:{format:'# kWh'},1:{format:'# kWh'}},hAxis:{slantedText:false,showTextEvery:1}});}google.charts.setOnLoadCallback(_smlDM2);</script>");
}
