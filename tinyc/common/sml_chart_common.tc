// sml_chart_common.tc — chart engine for the SML family: rolling 4 h / 24 h
// power charts plus daily, monthly and yearly totals, both directions.
// Consumption side first, feed-in side after the separator further down.
//
// The including program owns the callbacks and calls, per side:
//   sml_chart_load()      / sml_chart_pv_load()       once from main()
//   sml_chart_5s_tick()   / sml_chart_pv_5s_tick()    every 5 s
//   sml_chart_60s_tick()  / sml_chart_pv_60s_tick()   every 60 s
//   sml_chart_init_baselines/_clear_power/_init_columns/_save() + _pv_ twins
//   sml_chart_render_totals/_st/_24h/_days/_weeks/_months()  the charts
//   sml_chart_pv_render_dayprod/_render_months_dual() the PV charts
//   sml_chart_pv_render_totals()                      the export rows
//   sml_chart_week_opt()                              every second, week baselines <-> cfg
//   sml_chart_var()                                   the chart names for smlVars() (/pwr?v=)
//   sml_chart_data_panel()                            the three reset buttons
// Defines no callbacks - the firmware saves the .pvs on restart and slot stop.
//
// Chart state ~4.5 KB: s4h 481 + s24h 1441 as PACKED int16 (3.7 KB as floats,
// 1.9 packed), plus dcon 31 + mcon 12 + wcon 53 and the same three for the
// export side as floats (0.8 KB). Needs firmware ABI 27 for the packed rings.

#define SML_CHART 1            // smlVars() also asks sml_chart_var()
#include "sml_descriptor.tc"

// ── Energy baselines (delta against current SML kWh counter) ────────────────
persist float sml_dval;         // daily zero point
persist float sml_mval;         // monthly zero point
persist float sml_yval;         // yearly zero point
persist float sml_wval;         // weekly zero point, taken Monday 00:00
persist int   sml_da;           // last seen day-of-month (month-wrap detector)

// ── Rolling-power chart arrays — head index in a separate cursor ────────────
// PACKED int16: two samples per int32 slot, so these two rings cost 3.7 KB
// instead of 7.5 — and on a C3 the chart rings are the largest single heap
// item, claimed as ONE contiguous block at load time.
//
// Whole watts, and nothing is lost by that: both charts render with
// decimals=0 (see sml_chart_render_st/_24h), so the fractional part of the
// moving average was never drawn. int16 covers +-32767 W, which is why byte[]
// was NOT the answer here — at +-20 kW a byte quantises to 160 W steps and a
// fridge draws 100.
//
// ⚠️ `int[]` still may NOT be used: WebChart memcpy's each int32 slot into a
// float (bit-cast garbage). int16[]/uint16[] are read as integers instead —
// that is new in ABI 27, and this file now requires it.
persist int16 sml_s4h[481];     // 4 h chart, 1 min per slot
persist int16 sml_s24h[1441];   // 24 h chart, 1 min per slot
persist int   sml_s4h_pos;
persist int   sml_s24h_pos;

// ── Short-term chart: selectable time range ─────────────────────────────────
// Stored in MINUTES, not as a pulldown index: the value ends up in
// tc_options.cfg, which is meant to be edited by hand, and 240 says what it
// means where a 4 would not. 0 = never set, which main() turns into 4 h.
persist int sml_stmin;          // 15 | 30 | 60 | 120 | 240
persist int sml_chmain;         // 1 = charts on the settings page, not page 2

int sml_e_stmin;                // edit buffer, pulldown INDEX 0..4
int sml_e_chmain;
int sml_st_acc;                 // sum of the 5 s samples in the current slot
int sml_st_n;                   // how many are in it

// Seconds per slot. The 5 s tick is the finest source there is, so the
// shortest range stores every tick with no averaging at all.
int sml_st_step() {
    if (sml_stmin == 15)  return 5;
    if (sml_stmin == 30)  return 10;
    if (sml_stmin == 60)  return 15;
    if (sml_stmin == 120) return 30;
    return 60;
}

// Slots = minutes * 60 / step: 180, 180, 240, 240, 240 - every one of them
// inside the 481 the ring already has, so the range costs no extra RAM.
int sml_st_count() {
    if (sml_stmin == 15) return 180;
    if (sml_stmin == 30) return 180;
    return 240;
}

int sml_st_idx() {
    if (sml_stmin == 15)  return 0;
    if (sml_stmin == 30)  return 1;
    if (sml_stmin == 60)  return 2;
    if (sml_stmin == 120) return 3;
    return 4;
}

int sml_st_mins(int idx) {
    if (idx == 0) return 15;
    if (idx == 1) return 30;
    if (idx == 2) return 60;
    if (idx == 3) return 120;
    return 240;
}

// ── Daily / monthly columnar totals — 0-based indexing matching WebChart's
// ring-buffer walk (pos-count+i, mod count). Day 1 = index 0, Month 1 = 0.
persist float sml_dcon[31];
persist float sml_mcon[12];
// ISO calendar weeks 1..53 at index 0..52. Never cleared at the new year: the
// weeks still ahead keep last year's figures until they come round again, so
// the chart always shows the last twelve months - drawn faded, see the chart.
persist float sml_wcon[53];

// ── Runtime state — moving filter rings + tick counters ─────────────────────
// The 4 h chart had its own 30 s filter ring here. The short-term chart
// averages over the WHOLE slot instead (the box filter in sml_chart_5s_tick),
// which is simpler and more honest - the old one threw half of every minute away.
int sml_s24hf[12];              // 12×5s = 60s average window for 24 h chart
int sml_f24_pos;
int sml_t1;                     // 5s downcounter
int sml_t2;                     // 60s downcounter
int sml_hr_last;                // last seen tasm_hour (midnight edge detect)
// sml_buf is declared in sml_descriptor.tc and shared by both modules

// ── Storage ────────────────────────────────────────────────────────────────
// Arrays and baselines both live in the slot's .pvs, so a backup is that one
// file: copy it away, copy it back, restart the slot. Keeping the arrays in a
// separate .bin used to lose the baselines, and the next 60 s tick then wrote
// the whole meter reading into today's bar.
//
// Needs firmware >= 1.6.42: only there do heap persist arrays survive a reload
// and is the .pvs name-based. Older firmware returns the arrays as zeros.
// ============================================================================

// ── One-time import of /sml_chart.bin ──────────────────────────────────────
// Read once, written into the .pvs, then DELETED - the file being gone is the
// "already imported" marker. Same path for a .bin from the editor or from
// script_charts_to_tinyc_pvs.html: upload it as /sml_chart.bin, restart the
// slot. The .pvs is the backup from then on; tinyc_chart_editor.html reads and
// writes it directly.
//
// Layout, raw float32 little-endian, no header:
//   s4h 481 | s24h 1441 | dcon 31 | mcon 12          = 1965  (as before)
//   + dval | mval | yval | da                        = 1969  (optional)
//   + wval | wcon 53                                 = 2023  (optional)
// and for the feed-in file:
//   dprod 31 | mprod 12                              =   43  (as before)
//   + dval2 | mval2 | yval2                          =   46  (optional)
//   + wval2 | wprod 53                               =  100  (optional)
// Each block is read only if it is actually there, so a 1965-value file from
// an older editor still imports exactly as it used to. The week block sits
// behind the baselines and needs them: the converter writes it for
// 2_SML_Chart_PV3.tas, the only Scripter script with weekly bars.
#ifndef CHART_CSV_DEC
#define CHART_CSV_DEC 3
#endif

byte sml_mtopic[64];        // device topic - Publish never expands %topic%

// Import a run of `n` FLOATS from the open handle into a packed int16 ring.
// The .bin predates the packing and still holds one float per sample, so the
// values have to be converted on the way in — fileReadBin moves raw storage,
// it does not convert types.
// Chunked through a small scratch on purpose: a full-size float buffer would
// cost the 5.6 KB the packing just saved, and it would cost it at load time,
// which is exactly when the heap is claimed as one contiguous block.
void sml_chart_imp16(int h, int16 ziel[], int n) {
    float puf[32];
    int i = 0;
    while (i < n) {
        int m = n - i;
        if (m > 32) { m = 32; }
        if (fileReadBin(h, puf, m) != m) { return; }   // file ended early
        int k = 0;
        while (k < m) { ziel[i + k] = sml_chart_w16(puf[k]); k = k + 1; }
        i = i + m;
    }
}

void sml_chart_load() {
    tasmInfo(0, sml_mtopic);
    int h = fileOpen("/sml_chart.bin", "r");
    if (h < 0) return;                          // nothing to import
    sml_chart_imp16(h, sml_s4h,  481);
    sml_chart_imp16(h, sml_s24h, 1441);
    fileReadBin(h, sml_dcon, 31);               // still float rings
    fileReadBin(h, sml_mcon, 12);
    // Optional baseline block, four more floats. Without them sml_dval keeps
    // whatever the .pvs held - 0 on a fresh install - and the next 60 s tick
    // writes the WHOLE meter reading into today's bar, which flattens every
    // imported bar beside it. A file that ends after 1965 values reads short
    // here and nothing is assigned, so every older .bin stays valid.
    float base[4];
    if (fileReadBin(h, base, 4) == 4) {
        sml_dval = base[0];
        sml_mval = base[1];
        sml_yval = base[2];
        sml_da   = (int)base[3];
        if (fileReadBin(h, base, 1) == 1) {     // optional week block
            sml_wval = base[0];
            fileReadBin(h, sml_wcon, 53);
        }
    }
    fileClose(h);
    saveVars();                                 // the .pvs rules from here on
    // Delete, not rename. The values are in the .pvs now, and the file being
    // GONE is what stops a re-import on the next start - a kept copy would only
    // be an older duplicate of what the .pvs already holds. The .bin.done from
    // earlier versions goes too, so the filesystem does not collect leftovers.
    fileDelete("/sml_chart.bin");
    fileDelete("/sml_chart.bin.done");
    addLog("chart: .bin imported");
}

// Writing the persist vars covers arrays and baselines in one go.
void sml_chart_save() {
    saveVars();
}

// Readable export for backup and spreadsheets. Not the storage path.
// Every line names itself in column 1, so the file stays readable without
// this source at hand. Baselines go in line 1 on purpose - a backup without
// them was the old bug.
void sml_chart_export_csv() {
    int h = fileOpen("/sml_chart.csv", "w");
    if (h < 0) {
        addLog("chart: csv failed");
        return;
    }
    byte kopf[96];
    sprintf(kopf, "baselines\t%.3f\t%.3f\t%.3f\t%d\t%.3f\n", sml_dval, sml_mval, sml_yval, sml_da, sml_wval);
    fileWrite(h, kopf, strlen(kopf));
    strcpy(kopf, "power_4h_30s\t");
    fileWrite(h, kopf, strlen(kopf));
    fileWriteArray(sml_s4h,  h, 481,  0, CHART_CSV_DEC);
    strcpy(kopf, "power_24h_60s\t");
    fileWrite(h, kopf, strlen(kopf));
    fileWriteArray(sml_s24h, h, 1441, 0, CHART_CSV_DEC);
    strcpy(kopf, "import_day_1_31\t");
    fileWrite(h, kopf, strlen(kopf));
    fileWriteArray(sml_dcon, h, 31,   0, CHART_CSV_DEC);
    strcpy(kopf, "import_month_1_12\t");
    fileWrite(h, kopf, strlen(kopf));
    fileWriteArray(sml_mcon, h, 12,   0, CHART_CSV_DEC);
    strcpy(kopf, "import_week_1_53\t");
    fileWrite(h, kopf, strlen(kopf));
    fileWriteArray(sml_wcon, h, 53,   0, CHART_CSV_DEC);
    fileClose(h);
    addLog("chart: csv ok");
}

// No CleanUp()/OnExit() saving here. The firmware writes the .pvs itself on a
// restart or OTA (FUNC_SAVE_BEFORE_RESTART) and when the slot stops
// (TinyCStopVM), each time right after calling these callbacks - a saveVars()
// in them was a second flash write of the same file.

// ============================================================================
// Init helpers — reset baselines from current meter, reset chart arrays
// ============================================================================
// Baselines only: day, month and year restart from the current meter reading.
// The charts keep their history - clearing them is a separate button.
void sml_chart_init_baselines() {
    float ein = smlGet(2);
    sml_dval = ein;
    sml_mval = ein;
    sml_yval = ein;
    sml_wval = ein;
    sml_chart_save();
    addLog("chart: reset");
}

// The two rolling power charts, emptied. Baselines and bars are untouched.
void sml_chart_clear_power() {
    sml_s4h_pos  = 0;
    sml_s24h_pos = 0;
    int i = 0;
    while (i < 481)  { sml_s4h[i]  = 0; i = i + 1; }
    i = 0;
    while (i < 1441) { sml_s24h[i] = 0; i = i + 1; }
    sml_chart_save();
    addLog("chart: history cleared");
}

// Only the short-term ring: a changed time range makes its stored slots mean
// a different span, but leaves the 24 h ring alone.
void sml_chart_clear_st() {
    int i = 0;
    while (i < 481) { sml_s4h[i] = 0; i = i + 1; }
    sml_s4h_pos = 0;
    sml_st_acc  = 0;
    sml_st_n    = 0;
    sml_chart_save();
}

void sml_chart_init_columns() {
    int i = 0;
    while (i < 31) { sml_dcon[i] = 0.0; i = i + 1; }
    i = 0;
    while (i < 12) { sml_mcon[i] = 0.0; i = i + 1; }
    i = 0;
    while (i < 53) { sml_wcon[i] = 0.0; i = i + 1; }
    sml_chart_save();
    addLog("chart: bars cleared");
}

// Watts as they go into a packed int16 ring: rounded, and CLAMPED.
// ⚠️ The clamp is not decoration. A packed store keeps the low 16 bits and
// throws the rest away, it does not saturate — 40000 W would land as -25536 W,
// a plausible-looking wrong value in the middle of the chart rather than an
// obvious spike off the top. Same trap as `h_temp[i] = 300` storing 44 on a
// byte[]. +-32000 leaves headroom below the type's own limit so the reading
// pins visibly at the edge instead of silently wrapping.
int sml_chart_w16(float w) {
    if (w >  32000.0) return  32000;
    if (w < -32000.0) return -32000;
    if (w >= 0.0) return (int)(w + 0.5);
    return (int)(w - 0.5);
}

// 5-s tick: feed the moving-average filters, push to the rolling arrays.
// 5-s tick: feed the 24 h filter, accumulate and push the short-term ring.
void sml_chart_5s_tick() {
    int p = (int)smlGet(1);             // current power in W (int filter ring)
    sml_s24hf[sml_f24_pos] = p;
    sml_f24_pos = (sml_f24_pos + 1) % 12;

    int sum = 0;
    int i = 0;
    while (i < 12) { sum = sum + sml_s24hf[i]; i = i + 1; }
    float s24h_avg = (float)sum / 12.0;

    // ── Short-term ring ───────────────────────────────────────────────────
    // A box filter over the WHOLE slot, then one push. The slot index is a
    // free-running cursor and no longer derived from the wall clock: at 5 s
    // per slot there is nothing in the clock to derive it from. The chart
    // therefore reads "the last N minutes from now", which is what its x-axis
    // said all along.
    sml_st_acc = sml_st_acc + p;
    sml_st_n   = sml_st_n + 1;
    if (sml_st_n >= sml_st_step() / 5) {
        int cnt = sml_st_count();
        if (sml_s4h_pos < 0 || sml_s4h_pos >= cnt) sml_s4h_pos = 0;
        sml_s4h[sml_s4h_pos] = sml_chart_w16((float)sml_st_acc / (float)sml_st_n);
        // WebChart wants the NEXT write position, not the slot just written:
        // it draws arr[(pos+i) % count] and puts arr[(pos-1) % count] at
        // "now". Passing the written slot rotated the whole chart one slot to
        // the left and parked the newest sample at the left edge.
        sml_s4h_pos = (sml_s4h_pos + 1) % cnt;
        sml_st_acc = 0;
        sml_st_n   = 0;
    }

    // 24 h keeps its wall-clock slot - there the ring IS the time of day.
    int idx24 = tasm_hour * 60 + tasm_minute;
    if (idx24 >= 0 && idx24 < 1440) {
        sml_s24h[idx24] = sml_chart_w16(s24h_avg);
        sml_s24h_pos = (idx24 + 1) % 1440;      // next write position, see above
    }
}

// 60-s tick: daily / monthly counters + midnight rollover.
void sml_chart_60s_tick() {
    float ein = smlGet(2);
    int   d   = tasm_day;        // 1..31
    int   m   = tasm_month;      // 1..12
    int   cw  = tasm_cw;         // ISO week 1..53

    if (d >= 1 && d <= 31) sml_dcon[d - 1] = ein - sml_dval;
    if (m >= 1 && m <= 12) sml_mcon[m - 1] = ein - sml_mval;
    if (cw >= 1 && cw <= 53) sml_wcon[cw - 1] = ein - sml_wval;

    int hr = tasm_hour;
    if (sml_hr_last != hr && hr == 0) {
        if (tasm_wday == 2) sml_wval = ein;   // Monday: a new ISO week
        if (d > 1) {
            sml_da = d;
        } else {
            // Month-wrap — zero out days past the previous month's length.
            // sml_da still holds last-seen 1..31; zero indices [sml_da..30].
            int i = sml_da;
            while (i < 31) { sml_dcon[i] = 0.0; i = i + 1; }
            sml_mval = ein;
            sml_da = 1;
        }
        if (d == 1 && m == 1) sml_yval = ein;
        sml_dval = ein;
        sml_chart_save();
    }
    sml_hr_last = hr;
}

// ============================================================================
// Render helpers — chart + table blocks for the WebUI main page
// ============================================================================
// The live meter values, so the driver's own rows can be switched off - they
// prefix every value with the meter name, which reads badly. Split from the
// totals below so a per-phase row can go between them, where it belongs.
void sml_chart_render_meter() {
    if (ui_de) {
        sprintf(sml_buf, "{s}Leistung{m}%.0f W{e}", smlGet(1));      webSend(sml_buf);
        sprintf(sml_buf, "{s}Bezug{m}%.3f kWh{e}", smlGet(2));       webSend(sml_buf);
        sprintf(sml_buf, "{s}Einspeisung{m}%.3f kWh{e}", SML_PV_TOTAL); webSend(sml_buf);
    } else {
        sprintf(sml_buf, "{s}Power{m}%.0f W{e}", smlGet(1));         webSend(sml_buf);
        sprintf(sml_buf, "{s}Import{m}%.3f kWh{e}", smlGet(2));      webSend(sml_buf);
        sprintf(sml_buf, "{s}Export{m}%.3f kWh{e}", SML_PV_TOTAL);    webSend(sml_buf);
    }
}

void sml_chart_render_totals() {
    uiSep();

    float ein = smlGet(2);
    if (ui_de) {
        sprintf(sml_buf, "{s}Tagesverbrauch{m}%.2f kWh{e}",  ein - sml_dval); webSend(sml_buf);
        sprintf(sml_buf, "{s}Wochenverbrauch{m}%.2f kWh{e}", ein - sml_wval); webSend(sml_buf);
        sprintf(sml_buf, "{s}Monatsverbrauch{m}%.2f kWh{e}", ein - sml_mval); webSend(sml_buf);
        sprintf(sml_buf, "{s}Jahresverbrauch{m}%.2f kWh{e}", ein - sml_yval); webSend(sml_buf);
    } else {
        sprintf(sml_buf, "{s}Import day{m}%.2f kWh{e}",   ein - sml_dval); webSend(sml_buf);
        sprintf(sml_buf, "{s}Import week{m}%.2f kWh{e}",  ein - sml_wval); webSend(sml_buf);
        sprintf(sml_buf, "{s}Import month{m}%.2f kWh{e}", ein - sml_mval); webSend(sml_buf);
        sprintf(sml_buf, "{s}Import year{m}%.2f kWh{e}",  ein - sml_yval); webSend(sml_buf);
    }
}

// Script JS hook applied to both rolling charts: filled area (better
// readability) + DE date in the tooltip (dd.MM.yyyy), independent of the
// browser locale. WebChartJS runs in the chart's draw scope (dt/o/el) and
// o.done=1 takes over the draw so it renders as an AreaChart.
byte sml_chart_js[560];   // snippet incl. x-axis rebuild, format and o.done=1

void sml_chart_area_de() {
    strcpy(sml_chart_js,
        "var f=new google.visualization.DateFormat({pattern:'dd.MM.yyyy HH:mm'});f.format(dt,0);o.chartArea={left:58,right:16,top:30,height:'65%'};o.areaOpacity=0.3;new google.visualization.AreaChart(el).draw(dt,o);o.done=1");
    WebChartJS(sml_chart_js);
}

// The x axis is rebuilt here because WebChart's `interval` is in whole
// MINUTES ("Minutes between data points", TinyC_Reference) and four of the
// five ranges step faster than that. WebChartJS hands over the finished
// DataTable before the draw, which is the documented place for exactly this.
void sml_chart_area_st() {
    int stp = sml_st_step();
    int pad = stp * 1000;
    if (pad < 5000) pad = 5000;
    sprintf(sml_chart_js, "var N=new Date(),n=dt.getNumberOfRows(),i=0,S=%d", stp * 1000);
    sprintfAppend(sml_chart_js, ",P=%d;", pad);
    strcat(sml_chart_js, "for(;i<n;i++)dt.setValue(i,0,new Date(N.getTime()-(n-1-i)*S));");
    // The window has to be overwritten as well, not just the data: the
    // firmware pins o.hAxis.viewWindow from the ORIGINAL minute-spaced x
    // values, so rewriting dt alone left a 179-minute axis with 15 minutes of
    // data squeezed against its right edge.
    strcat(sml_chart_js, "o.hAxis={format:'HH:mm',viewWindow:{min:new Date(N.getTime()-(n-1)*S-P),max:new Date(N.getTime()+P)}};");
    // Seconds in the TOOLTIP where a slot is shorter than a minute; the axis
    // ticks stay at HH:mm, which is all they have room for.
    strcat(sml_chart_js, "new google.visualization.DateFormat({pattern:'");
    if (stp < 60) strcat(sml_chart_js, "HH:mm:ss");
    else          strcat(sml_chart_js, "dd.MM.yyyy HH:mm");
    strcat(sml_chart_js, "'}).format(dt,0);o.chartArea={left:58,right:16,top:30,height:'65%'};o.areaOpacity=0.3;new google.visualization.AreaChart(el).draw(dt,o);o.done=1");
    WebChartJS(sml_chart_js);
}

// Short-term chart. The title must be a string LITERAL - WebChart takes a
// const-pool index, so sprintf cannot build one; hence the ladder. The titles
// read the same in both languages, so there is only one.
void sml_chart_render_st() {
    int cnt = sml_st_count();
    WebChartSize(0, 280);   // 0 = card width (see #111)
    if (sml_stmin == 15)       WebChart(0, "15 min [W]", "W", 0x3498db, sml_s4h_pos, cnt, sml_s4h, 0, 1, 0.0, 0.0);
    else if (sml_stmin == 30)  WebChart(0, "30 min [W]", "W", 0x3498db, sml_s4h_pos, cnt, sml_s4h, 0, 1, 0.0, 0.0);
    else if (sml_stmin == 60)  WebChart(0, "1 h [W]",    "W", 0x3498db, sml_s4h_pos, cnt, sml_s4h, 0, 1, 0.0, 0.0);
    else if (sml_stmin == 120) WebChart(0, "2 h [W]",    "W", 0x3498db, sml_s4h_pos, cnt, sml_s4h, 0, 1, 0.0, 0.0);
    else                       WebChart(0, "4 h [W]",    "W", 0x3498db, sml_s4h_pos, cnt, sml_s4h, 0, 1, 0.0, 0.0);
    sml_chart_area_st();
}

void sml_chart_render_24h() {
    WebChartSize(0, 280);   // 0 = card width (see #111)
    WebChart(0, "24 h [W]", "W", 0x3498db, sml_s24h_pos, 1440, sml_s24h, 0, 1, 0.0, 0.0);
    sml_chart_area_de();
}

// The data buttons, identical in every chart wiring - so they live here once.
// Pass the already-resolved widget indices:
// The three reset buttons overwrite history and ask first. The CSV export sits
// on the charts page instead - it belongs to the data you are looking at.
//     sml_chart_data_panel(varIdx(do_base), varIdx(do_power), varIdx(do_bars));
//
// One reset button. Only the question and the icon differ between the three,
// so the markup around them is one literal instead of six. data-a is the text
// the button shows once done - a check mark reads the same in both languages.
void sml_chart_rbtn(byte q[], int idx, byte icon[]) {
    webSend("<button style='flex:1 1 90px' data-a='&#10003;' onclick='if(confirm(\"");
    sprintf(sml_buf, "%s\")){tcbtn(this,1,%d);fetch(\"?p=0&m=1&sv=%d_1\");setTimeout(function(){rfsh=1;la()},1500)}'>%s Reset</button>", q, idx, idx, icon);
    webSend(sml_buf);
}

void sml_chart_data_panel(int idx_base, int idx_power, int idx_bars) {
    uiHead("&#x1F4BE;", "Data", "Daten", "sml/#data");
    uiText("<div class='w'>&#9888; Overwrites history!</div>",
           "<div class='w'>&#9888; Löscht Verlaufsdaten!</div>");

    // One row. flex:1 1 90px so they share the width evenly and wrap onto a
    // second line rather than shrinking to nothing on a narrow phone.
    // Icon plus "Reset": the word reads the same in both languages, the icon
    // says which of the three it is, and the confirm() spells the consequence
    // out in full - that is the text that matters here.
    //
    // Each button re-reads the page 1.5 s after the click. The action itself
    // is immediate - tcbtn writes the flag and EverySecond() acts on it with
    // no Save involved, confirmed in the log - but the render triggered BY the
    // click runs before that tick, so it still paints the old figures. If the
    // 2 s refresh happens to be off (pr(0) leaves it off once a field has had
    // focus), nothing ever repaints them and it looks as though the reset
    // needed a Save. rfsh=1 because la() does nothing while it is 0.
    //
    // The write goes out a SECOND time through a plain fetch(), and that is
    // the one that actually lands. A native confirm() BLOCKS the JS thread,
    // so the 2 s refresh timer piles up behind it; the moment OK is pressed,
    // tcbtn sends through seva -> la(), and the queued la() runs right after
    // and kills it with its own `if(x)x.abort()` - one shared XMLHttpRequest
    // serves every caller. The button still turns green, because tcbtn does
    // that regardless of whether the request survived. Save has no dialog and
    // was therefore never affected, which is exactly what made this look like
    // "the reset only works with a Save". Same abort ui_common's rl() already
    // documents, sidestepped the same way. Writing the flag twice is harmless.
    webSend("<div style='display:flex;flex-wrap:wrap;gap:6px;margin:6px 0'>");
    if (ui_de) {
        sml_chart_rbtn("Zählerwerte zurücksetzen?", idx_base,  "&#x1F522;");
        sml_chart_rbtn("Verlauf leeren?",           idx_power, "&#x1F4C8;");
        sml_chart_rbtn("Balken löschen?",           idx_bars,  "&#x1F4CA;");
    } else {
        sml_chart_rbtn("Reset counters?", idx_base,  "&#x1F522;");
        sml_chart_rbtn("Clear history?",  idx_power, "&#x1F4C8;");
        sml_chart_rbtn("Clear bars?",     idx_bars,  "&#x1F4CA;");
    }
    webSend("</div>");
}

// class='tcc' matters: the firmware emits `.tcc div{padding:0}` with the chart
// library, which switches off Tasmota's blanket 5 px div padding INSIDE the
// chart - without it Google's nested divs push the drawing right and over the
// edge of the card. The divs also deliberately carry NO text-align:center. Google puts its
// SVG in an inline-block wrapper, so centring shifts the drawing 5 px to the
// right against the WebChart diagrams above it (gemu, 2026-08-19: svg left
// 43 instead of 38). Same width rule as the firmware emits, so all charts on
// the page line up exactly.
// ── Bar charts ──────────────────────────────────────────────────────────────
// One draw function for all five, sent once per page from
// sml_chart_render_all(). Before, every chart carried ~350 B of its own JS,
// twice over for DE and EN; now only the id, the title, the rows and what
// differs in the options remain. o.d=1 is the two-series layout (import and
// export side by side, each on its own axis) the week and month charts share.
// The loader is already on the page from the WebChart line charts above.
void sml_chart_bar_js() {
    webSend("<style>.smlc{width:100%;box-sizing:border-box;height:280px}</style><script>function _smlB(i,t,r,o){google.charts.setOnLoadCallback(function(){if(o.d){o.chartArea={left:60,right:60,top:30,height:'70%'};o.legend={position:'top'};o.series={0:{color:'#27ae60',targetAxisIndex:0},1:{color:'#f39c12',targetAxisIndex:1}};o.vAxes={0:{format:'#.## kWh'},1:{format:'#.## kWh'}}}o.title=t;o.chartArea=o.chartArea||{left:50,right:20,top:30,height:'70%'};o.chartArea.backgroundColor='#f0f2f5';o.legend=o.legend||'none';o.vAxis={format:'#.## kWh'};new google.visualization.ColumnChart(document.getElementById(i)).draw(google.visualization.arrayToDataTable(r),o)})}</script>");
}

// Opens one bar chart up to its header row; the caller sends the rows and
// closes it with sml_chart_bar_end().
// class='tcc' matters: the firmware emits `.tcc div{padding:0}` with the chart
// library, which switches off Tasmota's blanket 5 px div padding INSIDE the
// chart - without it Google's nested divs push the drawing right and over the
// edge of the card. No text-align:center either: Google puts its SVG in an
// inline-block wrapper, so centring shifts the drawing 5 px to the right
// against the WebChart diagrams above it (gemu, 2026-08-19).
void sml_chart_bar_open(byte id[], byte title[], byte head[]) {
    sprintf(sml_buf, "<div id='%s' class='tcc smlc'></div><script>_smlB('%s','%s',[", id, id, title);
    webSend(sml_buf);
    webSend(head);
}

void sml_chart_bar_end(byte opts[]) {
    webSend("],");
    webSend(opts);
    webSend(")</script>");
}

// Per-bar colour: past green, today red, days still ahead (last month) blue.
void sml_chart_render_days() {
    int today = tasm_day;
    if (today < 1) today = 1;
    if (ui_de) sml_chart_bar_open("sml_dch", "Bezug pro Tag",  "['','kWh',{role:'style'}]");
    else       sml_chart_bar_open("sml_dch", "Import per day", "['','kWh',{role:'style'}]");
    int i = 1;
    while (i <= 31) {
        if (i < today)        sprintf(sml_buf, ",[%d,%.2f,'green']", i, sml_dcon[i - 1]);
        else if (i == today)  sprintf(sml_buf, ",[%d,%.2f,'red']",   i, sml_dcon[i - 1]);
        else                  sprintf(sml_buf, ",[%d,%.2f,'blue']",  i, sml_dcon[i - 1]);
        webSend(sml_buf);
        i = i + 1;
    }
    sml_chart_bar_end("{hAxis:{ticks:[1,5,10,15,20,25,30]}}");
}

void sml_chart_render_months() {
    int thismon = tasm_month;
    if (thismon < 1) thismon = 1;
    // strToken needs the source as a resolvable char[] variable — string
    // literals fall through tc_resolve_ref and return empty (the earlier
    // version produced ['',12.3,...] with no month names on the x-axis).
    byte mn_names[64];
    if (ui_de) strcpy(mn_names, "Jan|Feb|Mär|Apr|Mai|Jun|Jul|Aug|Sep|Okt|Nov|Dez");
    else       strcpy(mn_names, "Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec");
    byte mn[6];
    if (ui_de) sml_chart_bar_open("sml_mch", "Bezug pro Monat",  "['','kWh',{role:'style'}]");
    else       sml_chart_bar_open("sml_mch", "Import per month", "['','kWh',{role:'style'}]");
    int i = 1;
    while (i <= 12) {
        strToken(mn, mn_names, '|', i);
        if (i < thismon)        sprintf(sml_buf, ",['%s',%.2f,'green']", mn, sml_mcon[i - 1]);
        else if (i == thismon)  sprintf(sml_buf, ",['%s',%.2f,'red']",   mn, sml_mcon[i - 1]);
        else                    sprintf(sml_buf, ",['%s',%.2f,'blue']",  mn, sml_mcon[i - 1]);
        webSend(sml_buf);
        i = i + 1;
    }
    sml_chart_bar_end("{hAxis:{showTextEvery:1}}");
}

// Settings panel renderer is in sml_descriptor.tc as
// `sml_render_settings_panel()` — including modules call that directly.

// ════ Feed-in side ═════════════════════════════════════════════════════════

// ── Production-side persist state ──────────────────────────────────────────
// Where the "energy fed back" total comes from: sml_export() in
// sml_descriptor.tc - the meter's export register (smlGet(3)), or, with the
// Bezugszaehler option on, the total integrated from negative power.
// A program may still point this elsewhere by defining it before the #include
// (gemu's separate sml_chart_bezug.tc does, and keeps working).
#ifndef SML_PV_TOTAL
#define SML_PV_TOTAL sml_export()
#endif

persist float sml_dval2;             // daily zero point for energy-out (kWh)
persist float sml_mval2;             // monthly zero point
persist float sml_yval2;             // yearly zero point
persist float sml_wval2;             // weekly zero point, Monday 00:00
persist int   sml_pv;                  // 1 = show feed-in rows and charts
persist float sml_dprod[31];         // 31 days of production totals
persist float sml_mprod[12];         // 12 months of production totals
persist float sml_wprod[53];         // ISO weeks, see sml_wcon

persist watch int sml_sndpwr;        // 1 = publish smoothed power via MQTT

// ── Runtime state ──────────────────────────────────────────────────────────
int   sml_pv_hr_last;                // PV-side midnight edge detector
byte  sml_pv_resp[64];               // tasmCmd response buffer

// Arrays and baselines go into the slot's .pvs, same as the consumption side.
void sml_chart_pv_save() {
    saveVars();
}

// One-time import of the old /sml_chart_pv.bin, then renamed. Each file
// carries its own rename, so the order of the two load() calls is free.
void sml_chart_pv_load() {
    int h = fileOpen("/sml_chart_pv.bin", "r");
    if (h < 0) return;
    fileReadBin(h, sml_dprod, 31);
    fileReadBin(h, sml_mprod, 12);
    // Optional baseline block, three more floats - see sml_chart_load().
    float base[3];
    if (fileReadBin(h, base, 3) == 3) {
        sml_dval2 = base[0];
        sml_mval2 = base[1];
        sml_yval2 = base[2];
        if (fileReadBin(h, base, 1) == 1) {     // optional week block
            sml_wval2 = base[0];
            fileReadBin(h, sml_wprod, 53);
        }
    }
    fileClose(h);
    saveVars();
    fileDelete("/sml_chart_pv.bin");            // see sml_chart_load()
    fileDelete("/sml_chart_pv.bin.done");
    addLog("pv: .bin imported");
}

// Readable export incl. baselines, see sml_chart_export_csv.
void sml_chart_pv_export_csv() {
    int h = fileOpen("/sml_chart_pv.csv", "w");
    if (h < 0) {
        addLog("pv: csv failed");
        return;
    }
    byte kopf[96];
    sprintf(kopf, "baselines\t%.3f\t%.3f\t%.3f\t%.3f\n", sml_dval2, sml_mval2, sml_yval2, sml_wval2);
    fileWrite(h, kopf, strlen(kopf));
    strcpy(kopf, "export_day_1_31\t");
    fileWrite(h, kopf, strlen(kopf));
    fileWriteArray(sml_dprod, h, 31, 0, CHART_CSV_DEC);
    strcpy(kopf, "export_month_1_12\t");
    fileWrite(h, kopf, strlen(kopf));
    fileWriteArray(sml_mprod, h, 12, 0, CHART_CSV_DEC);
    strcpy(kopf, "export_week_1_53\t");
    fileWrite(h, kopf, strlen(kopf));
    fileWriteArray(sml_wprod, h, 53, 0, CHART_CSV_DEC);
    fileClose(h);
    addLog("pv: csv ok");
}

void sml_chart_pv_init_baselines() {
    float eout = SML_PV_TOTAL;
    sml_dval2 = eout;
    sml_mval2 = eout;
    sml_yval2 = eout;
    sml_wval2 = eout;
    sml_chart_pv_save();
    addLog("pv: reset");
}

void sml_chart_pv_init_columns() {
    int i = 0;
    while (i < 31) { sml_dprod[i] = 0.0; i = i + 1; }
    i = 0;
    while (i < 12) { sml_mprod[i] = 0.0; i = i + 1; }
    i = 0;
    while (i < 53) { sml_wprod[i] = 0.0; i = i + 1; }
    sml_chart_pv_save();
}

// 5-s smoothing — first-order EMA on smlGet(1) with α=0.1 (heavy smoothing).
// MQTT-publishes the smoothed value when sml_sndpwr is enabled.
void sml_chart_pv_5s_tick() {
    sml_power2 = 0.9 * sml_power2 + 0.1 * smlGet(1);
    if (sml_sndpwr) {
        sprintf(sml_ftopic, "stat/%s/script/power2", sml_mtopic);
        sprintf(sml_buf, "%d", (int)sml_power2);
        smlPublish(sml_ftopic, sml_buf);
    }
}

// 60-s tick: production counters + midnight rollover of the PV baselines.
void sml_chart_pv_60s_tick() {
    // The Bezugszaehler option was switched: the export total now comes from
    // a different counter, so today, this week, month and year start over
    // from it. The bars already drawn keep their figures.
    if (sml_bezug_chg == 1) {
        sml_bezug_chg = 0;
        sml_chart_pv_init_baselines();
    }
    float eout = SML_PV_TOTAL;
    int   d    = tasm_day;
    int   m    = tasm_month;
    int   cw   = tasm_cw;

    if (d >= 1 && d <= 31) sml_dprod[d - 1] = eout - sml_dval2;
    if (m >= 1 && m <= 12) sml_mprod[m - 1] = eout - sml_mval2;
    if (cw >= 1 && cw <= 53) sml_wprod[cw - 1] = eout - sml_wval2;

    int hr = tasm_hour;
    if (sml_pv_hr_last != hr && hr == 0) {
        if (tasm_wday == 2) sml_wval2 = eout;   // Monday: a new ISO week
        if (d == 1) {
            // Month-wrap — zero days past previous month's length.
            int i = sml_da;
            while (i < 31) { sml_dprod[i] = 0.0; i = i + 1; }
            sml_mval2 = eout;
        }
        if (d == 1 && m == 1) sml_yval2 = eout;
        sml_dval2 = eout;
        sml_chart_pv_save();
    }
    sml_pv_hr_last = hr;
}

// ── Renderers. The 4 h / 24 h line charts and the consumption day chart
//    come from sml_chart_common. ─────────────────────────────────────────────

void sml_chart_pv_render_dayprod() {
    int today = tasm_day;
    if (today < 1) today = 1;
    if (ui_de) sml_chart_bar_open("sml_dpch", "Einspeisung pro Tag", "['','kWh',{role:'style'}]");
    else       sml_chart_bar_open("sml_dpch", "Export per day",      "['','kWh',{role:'style'}]");
    int i = 1;
    while (i <= 31) {
        if (i < today)        sprintf(sml_buf, ",[%d,%.2f,'green']", i, sml_dprod[i - 1]);
        else if (i == today)  sprintf(sml_buf, ",[%d,%.2f,'red']",   i, sml_dprod[i - 1]);
        else                  sprintf(sml_buf, ",[%d,%.2f,'blue']",  i, sml_dprod[i - 1]);
        webSend(sml_buf);
        i = i + 1;
    }
    sml_chart_bar_end("{hAxis:{ticks:[1,5,10,15,20,25,30]}}");
}

// Dual-series month chart, replaces sml_chart_common's single-series one:
// consumption and feed-in side by side, two y-axes so both ranges scale.
void sml_chart_pv_render_months_dual() {
    byte mn_names[64];
    if (ui_de) strcpy(mn_names, "Jan|Feb|Mär|Apr|Mai|Jun|Jul|Aug|Sep|Okt|Nov|Dez");
    else       strcpy(mn_names, "Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec");
    byte mn[6];
    if (ui_de) sml_chart_bar_open("sml_mch2", "Bezug/Einsp. pro Monat",  "['','Bezug','Einspeisung']");
    else       sml_chart_bar_open("sml_mch2", "Import/export per month", "['','Import','Export']");
    int i = 1;
    while (i <= 12) {
        strToken(mn, mn_names, '|', i);
        sprintf(sml_buf, ",['%s',%.2f,%.2f]", mn, sml_mcon[i - 1], sml_mprod[i - 1]);
        webSend(sml_buf);
        i = i + 1;
    }
    sml_chart_bar_end("{d:1,hAxis:{showTextEvery:1}}");
}

// Calendar weeks 1..53, import and - with PV on - export beside it on its own
// axis, like the month chart. Weeks still ahead this year hold LAST year's
// figures (nothing clears them, see sml_wcon) and are drawn faded; the
// current week gets a red outline. A style, not a colour: with two series a
// per-bar colour would paint import and export alike.
void sml_chart_render_weeks() {
    int cw = tasm_cw;
    byte st[40];
    byte t[40];
    if (ui_de) sprintf(t, "%s pro Woche (KW %d)", sml_pv > 0 ? "Bezug/Einsp." : "Bezug", cw);
    else       sprintf(t, "%s per week (week %d)", sml_pv > 0 ? "Import/export" : "Import", cw);
    if (sml_pv == 0)  sml_chart_bar_open("sml_wch", t, "['','kWh',{role:'style'}]");
    else if (ui_de)   sml_chart_bar_open("sml_wch", t, "['','Bezug',{role:'style'},'Einspeisung',{role:'style'}]");
    else              sml_chart_bar_open("sml_wch", t, "['','Import',{role:'style'},'Export',{role:'style'}]");
    int i = 1;
    while (i <= 53) {
        if (i == cw)     strcpy(st, "stroke-color:#c0392b;stroke-width:3");
        else if (i > cw) strcpy(st, "opacity:0.35");
        else             strcpy(st, "");
        sprintf(sml_buf, ",[%d,%.2f,'%s'", i, sml_wcon[i - 1], st);
        if (sml_pv > 0) sprintfAppend(sml_buf, ",%.2f,'%s'", sml_wprod[i - 1], st);
        strcat(sml_buf, "]");
        webSend(sml_buf);
        i = i + 1;
    }
    if (sml_pv > 0) sml_chart_bar_end("{d:1,hAxis:{ticks:[1,10,20,30,40,53]}}");
    else            sml_chart_bar_end("{series:{0:{color:'#27ae60'}},hAxis:{ticks:[1,10,20,30,40,53]}}");
}

// Export rows for the main page, day / week / month / year. Shared by every
// chart program; before, each carried its own copy of the block.
void sml_chart_pv_render_totals() {
    if (sml_pv == 0) return;
    float eout = SML_PV_TOTAL;
    if (ui_de) {
        sprintf(sml_buf, "{s}Tageseinspeisung{m}%.2f kWh{e}",  eout - sml_dval2); webSend(sml_buf);
        sprintf(sml_buf, "{s}Wocheneinspeisung{m}%.2f kWh{e}", eout - sml_wval2); webSend(sml_buf);
        sprintf(sml_buf, "{s}Monatseinspeisung{m}%.2f kWh{e}", eout - sml_mval2); webSend(sml_buf);
        sprintf(sml_buf, "{s}Jahreseinspeisung{m}%.2f kWh{e}", eout - sml_yval2); webSend(sml_buf);
    } else {
        sprintf(sml_buf, "{s}Export day{m}%.2f kWh{e}",   eout - sml_dval2); webSend(sml_buf);
        sprintf(sml_buf, "{s}Export week{m}%.2f kWh{e}",  eout - sml_wval2); webSend(sml_buf);
        sprintf(sml_buf, "{s}Export month{m}%.2f kWh{e}", eout - sml_mval2); webSend(sml_buf);
        sprintf(sml_buf, "{s}Export year{m}%.2f kWh{e}",  eout - sml_yval2); webSend(sml_buf);
    }
}

// Week baselines ride along with the others in tc_options.cfg (imp_week /
// exp_week), so the week survives a program change like day, month and year.
// From EverySecond, AFTER the program has read its own baselines: an older
// .pvs has no week baseline at all, and a 0 there would put the whole meter
// reading into this week's bar - it starts from today's zero point instead.
void sml_chart_week_opt() {
    sml_virt_ride = 1;          // our midnight write carries the Bezug total too
    if (tc_opt_first == 1) {
        sml_wval  = tcOptGetF(6, sml_wval);
        sml_wval2 = tcOptGetF(7, sml_wval2);
        if (sml_wval  == 0.0 && sml_dval  != 0.0) sml_wval  = sml_dval;
        if (sml_wval2 == 0.0 && sml_dval2 != 0.0) sml_wval2 = sml_dval2;
    }
    tcOptSetF(6, sml_wval);
    tcOptSetF(7, sml_wval2);
}

// ── Charts on their own TinyC page (/tc_ui?p=2) ────────────────────────────
// pr(0) kills the 2 s auto-refresh: redrawing ~1700 points every two seconds
// would be worse than the main page ever was. It runs while the page parses,
// so the window.onload call to la() already sees rfsh=0 and returns.
// WebChart works here because tc_chart_lib_sent is reset before every /tc_ui
// render - on a webOn endpoint it is not, and the loader would be sent once.
// Auto-reload button for whichever page shows the charts. Google Charts draws
// once when the page is built; Tasmota's la() only swaps the sensor block and
// never touches the chart divs, so a 15-minute chart goes stale on screen
// while the numbers above it keep moving.
//
// The state lives in the BROWSER (localStorage), because the thing it switches
// on reloads the page - a device-side flag would have to survive the reload it
// causes, and would then also apply to every other browser looking at the
// device. It skips a reload while a field has focus, so it cannot throw away
// something half-typed when the charts sit on the settings page.
void sml_chart_refresh_button() {
    webSend("<div style='margin:8px 0'><button id='smlar' style='padding:4px 10px' onclick='_arT()'>&#x21BB;</button></div>");
    webSend("<script>var _arOn=0;try{_arOn=localStorage.getItem('smlar')=='1'?1:0}catch(e){}");
    if (ui_de) webSend("var _arL=['↻ Auto aus','↻ Auto an'];");
    else       webSend("var _arL=['↻ Auto off','↻ Auto on'];");
    webSend("function _arU(){var b=document.getElementById('smlar');if(b)b.textContent=_arL[_arOn];}");
    webSend("function _arT(){_arOn=_arOn?0:1;try{localStorage.setItem('smlar',_arOn?'1':'0')}catch(e){}_arU();if(_arOn)_arS();}");
    webSend("function _arS(){setTimeout(function(){if(!_arOn)return;var a=document.activeElement;if(a&&/INPUT|SELECT|TEXTAREA/.test(a.tagName))return _arS();location.reload();},10000);}");
    webSend("_arU();if(_arOn)_arS();</script>");
}

// Every chart, in order. Shared by the dedicated page and the settings page.
void sml_chart_render_all() {
    // Plain wrapper. The old margin-left:-30px compensated Tasmota's 5 px div
    // padding stacking up inside Google's nested chart divs; the firmware now
    // switches that off with `.tcc div{padding:0}` (gemu, 1.6.55).
    webSend("<div>");
    sml_chart_refresh_button();
    sml_chart_bar_js();
    sml_chart_render_st();
    sml_chart_render_24h();
    sml_chart_render_days();
    if (sml_pv > 0) sml_chart_pv_render_dayprod();
    sml_chart_render_weeks();
    if (sml_pv > 0) sml_chart_pv_render_months_dual();
    else            sml_chart_render_months();
    webSend("</div>");
}

void sml_chart_page_render() {
    // No width rule here: since 1.6.55 the firmware pins the page container
    // itself (body>div{width:min(96vw,960px)}) next to the chart library, and a
    // second rule would fight it. The charts are width:100% of that container.
    //
    // pr(0) belongs to THIS page only. On the settings page it would stop the
    // live values, so sml_chart_render_all() is called there without it.
    webSend("<script>pr(0)</script>");
    sml_chart_render_all();
}

// ── Chart options ──────────────────────────────────────────────────────────
void sml_chart_opt_load() {
    sml_e_stmin  = sml_st_idx();
    sml_e_chmain = sml_chmain;
}

void sml_chart_opt_apply() {
    int m = sml_st_mins(sml_e_stmin);
    if (m != sml_stmin) {
        sml_stmin = m;
        sml_chart_clear_st();
        addLog("chart: range %d min", sml_stmin);
    }
    sml_chmain = sml_e_chmain;
    tcOptSet(30, sml_stmin);
    tcOptSet(31, sml_chmain);
}

// The range is an ordinary edit-buffer field: it takes effect on Save, and the
// warning stands next to it rather than in a confirm(). A native dialog blocks
// the JS thread and the queued refresh then aborts the request behind it -
// that is the bug the three reset buttons below had to be rewritten around,
// and this page has exactly the same refresh loop.
void sml_chart_options_panel() {
    uiHead("&#x1F4C8;", "Charts", "Diagramme", "sml/#charts");
    if (ui_de) webPulldown(sml_e_stmin, "Kurzzeit",   "15 min|30 min|1 h|2 h|4 h");
    else       webPulldown(sml_e_stmin, "Short-term", "15 min|30 min|1 h|2 h|4 h");
    // Always visible, not tied to the change and deliberately not a confirm():
    // a native dialog blocks the JS thread, and the queued refresh then aborts
    // the request behind it - the bug the three reset buttons below had to be
    // rewritten around, and this page carries the same refresh loop.
    uiText("<div class='w'>&#9888; Changing clears the chart!</div>",
           "<div class='w'>&#9888; Ändern leert das Diagramm!</div>");
    if (ui_de) webCheckbox(sml_e_chmain, "Charts Hauptseite");
    else       webCheckbox(sml_e_chmain, "Main Charts");
}

// One row on the main page, from WebCall().
void sml_chart_link() {
    if (ui_de) webSend("{s}Diagramme{m}<a href='/tc_ui?p=2' title='Diagramme' style='font-size:20px;text-decoration:none'>&#x1F4C8;</a>{e}");
    else       webSend("{s}Charts{m}<a href='/tc_ui?p=2' title='Charts' style='font-size:20px;text-decoration:none'>&#x1F4C8;</a>{e}");
}

// CSV export, last thing on the settings page. Reads only, so no confirm().
// Language-neutral: the button says CSV either way.
void sml_chart_csv_button(int idx_csv) {
    sprintf(sml_buf, "<div><button style='width:100%%' data-a='&#10003;' onclick='tcbtn(this,1,%d)'>&#x1F4BE; CSV</button></div>", idx_csv);
    webSend(sml_buf);
}

// Date and uptime, last rows on the main page. They are context, not readings -
// between the meter values and the totals they read like measurements and
// pushed the interesting numbers down.
void sml_chart_datetime_rows() {
    if (ui_de) sprintf(sml_buf, "{s}Datum{m}%02d.%02d.%04d %02d:%02d{e}", tasm_day, tasm_month, tasm_year, tasm_hour, tasm_minute);
    else       sprintf(sml_buf, "{s}Date{m}%02d.%02d.%04d %02d:%02d{e}", tasm_day, tasm_month, tasm_year, tasm_hour, tasm_minute);
    webSend(sml_buf);
    int up_d = tasm_uptime / 86400;
    int up_h = (tasm_uptime / 3600) % 24;
    int up_m = (tasm_uptime / 60) % 60;
    sprintf(sml_buf, "{s}Uptime{m}%d d %d h %d min{e}", up_d, up_h, up_m);
    webSend(sml_buf);
}

// ── /pwr?v=: the chart names ────────────────────────────────────────────────
// smlVars() in sml_descriptor.tc does the request, the sml names, power2 and
// cpwr; this adds the baselines and the bar arrays. 1 = the name was ours.
// mcon is 12 months of import only - the Scripter's months 13..24 are mprod.
void sml_vars_a(float a[], int n) {
    sml_vars_send("[");
    int i = 0;
    while (i < n) {
        if (i > 0) sprintf(sml_buf, ",%.3f", a[i]);
        else       sprintf(sml_buf, "%.3f", a[i]);
        sml_vars_send(sml_buf);
        i = i + 1;
    }
    sml_vars_send("]");
}

int sml_chart_var(byte t[]) {
    if      (strcmp(t, "dval")   == 0) sml_vars_f(sml_dval);
    else if (strcmp(t, "wval")   == 0) sml_vars_f(sml_wval);
    else if (strcmp(t, "mval")   == 0) sml_vars_f(sml_mval);
    else if (strcmp(t, "yval")   == 0) sml_vars_f(sml_yval);
    else if (strcmp(t, "dval2")  == 0) sml_vars_f(sml_dval2);
    else if (strcmp(t, "wval2")  == 0) sml_vars_f(sml_wval2);
    else if (strcmp(t, "mval2")  == 0) sml_vars_f(sml_mval2);
    else if (strcmp(t, "yval2")  == 0) sml_vars_f(sml_yval2);
    else if (strcmp(t, "dcon")   == 0) sml_vars_a(sml_dcon,  31);
    else if (strcmp(t, "wcon")   == 0) sml_vars_a(sml_wcon,  53);
    else if (strcmp(t, "mcon")   == 0) sml_vars_a(sml_mcon,  12);
    else if (strcmp(t, "dprod")  == 0) sml_vars_a(sml_dprod, 31);
    else if (strcmp(t, "wprod")  == 0) sml_vars_a(sml_wprod, 53);
    else if (strcmp(t, "mprod")  == 0) sml_vars_a(sml_mprod, 12);
    else return 0;
    return 1;
}
