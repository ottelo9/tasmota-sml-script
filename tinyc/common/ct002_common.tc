// ct002_common.tc — Marstek CT002 / CT003 emulator on UDP 12345, as a
// building block. Defines no callbacks; the including program owns them and
// calls ctInit/ctPoll/ctTick/ctTask/ctRows/ctPanel/ctWebOn/ctCmd/ctJson.
// Feeds a Venus / Jupiter / B2500 from the SML meter. Relay mode only.
// Docs: https://ottelo9.github.io/tasmota-sml-script/ct002/
//
// Frame:    SOH STX <total-len> |f1|..|fN ETX <xor-hex>
// Length:   whole packet incl. length digits and checksum
// Checksum: XOR over SOH..ETX, 2 lowercase hex chars
// Request:  |batt-type|batt-mac|ct-type|ct-mac|phase|power[|participate]
// Response: |ct-type|ct-mac|batt-type|batt-mac| 20 numbers (+4 on CT003)
// Protocol source: tomquist/AstraMeter, docs/ct002-ct003-protocol.md
//
// Not implemented: the app's MQTT frames (cd=1/cd=4). The HTTP cloud push was
// built and measured — accepted, but the app still showed "--", so it is gone.
// The app's live view comes over MQTT only; a fake CT there is always offline.

#include "ui_common.tc"

#define CT_NSLOT     9        // consumer slots — the real CT keeps 9
#define CT_RXMAX   192        // request buffer  (a request is ~55 B)
#define CT_TXMAX   256        // response buffer (worst case ~190 B incl. CT003)

// char[] not #define: a #define stays an Identifier in the AST, which
// syscalls taking a const-pool string must not be handed.
byte ct_host[] = "eu.hamedata.com";


// ─── Persistent settings ───────────────────────────────────────────────────
persist int  ct_kind;          // 0 = CT002 (HME-4), 1 = CT003 (HME-3)
persist int  ct_port;          // UDP listen port (12345)
persist int  ct_rssi;          // Wi-Fi RSSI reported to the batteries [dBm]
persist int  ct_ttl;           // consumer timeout [s], 0 = adaptive (~2 polls)
persist int  ct_offset;        // zero-feed offset [W]
persist int  ct_tweak;          // 1 = active control (was: regulator shaping)
persist int  ct_trim;           // steady-import trim [W], 0 = off
persist int  ct_pace;           // ramp step per cycle [W], 0 = off
persist int  ct_mindc;          // minimum reported import [W], 0 = off
persist int  ct_fair;           // 1 = split the load across batteries
// Balance gain, rotation interval and the efficiency threshold used to be
// three more settings. They are constants now, at AstraMeter's field-tested
// values - on tomquist's own advice: "ich bereue mittlerweile ein bisschen,
// dass es so viele Einstellmoeglichkeiten gibt, da das den Support-Aufwand
// doch um einiges erschwert". The efficiency threshold went entirely: for a
// B2500 the physical 80 W start floor now applies by itself, and for an AC
// battery it was polish.
#define CT_BGAIN     0.2      // balance gain
#define CT_ROT_S     900      // seconds between rotations
persist int  ct_sat;            // 1 = saturation detection
persist byte ct_mac[16];       // CT MAC, 12 hex lowercase. Empty = answer all
persist byte ct_mail[64];      // Marstek account mail (registration only)

// ─── Edit buffer ───────────────────────────────────────────────────────────
// The panel writes here; Save copies it onto the settings above. ct_mac and
// ct_mail are not in here - those are handled on /ctreg.
int ct_e_kind; int ct_e_port; int ct_e_rssi; int ct_e_ttl;
int ct_e_offset; int ct_e_tweak;
int ct_e_trim; int ct_e_pace; int ct_e_mindc;
int ct_e_fair; int ct_e_sat;

void ctCommit() {
    ct_kind = ct_e_kind;
    ct_port = ct_e_port;
    ct_rssi = ct_e_rssi;
    ct_ttl = ct_e_ttl;
    ct_offset = ct_e_offset;
    ct_tweak = ct_e_tweak;
    ct_trim = ct_e_trim;
    ct_pace = ct_e_pace;
    ct_mindc = ct_e_mindc;
    ct_fair = ct_e_fair;
    ct_sat = ct_e_sat;
    tcOptSet(19, ct_kind);
    tcOptSet(20, ct_offset);
    tcOptSet(21, ct_port);
    tcOptSet(22, ct_rssi);
    tcOptSet(23, ct_ttl);
    tcOptSet(24, ct_tweak);
    tcOptSet(26, ct_trim);
    tcOptSet(27, ct_pace);
    tcOptSet(28, ct_mindc);
    tcOptSet(29, ct_fair);
    tcOptSet(33, ct_sat);
}
void ctEditLoad() {
    ct_e_kind = ct_kind;
    ct_e_port = ct_port;
    ct_e_rssi = ct_rssi;
    ct_e_ttl = ct_ttl;
    ct_e_offset = ct_offset;
    ct_e_tweak = ct_tweak;
    ct_e_trim = ct_trim;
    ct_e_pace = ct_pace;
    ct_e_mindc = ct_mindc;
    ct_e_fair = ct_fair;
    ct_e_sat = ct_sat;
}

// ─── Consumer table (one row per battery, keyed by its MAC) ────────────────
byte ct_smac[CT_NSLOT][16];
int  ct_sused[CT_NSLOT];
int  ct_sph[CT_NSLOT];              // 0 = '0'/unassigned, 1=A, 2=B, 3=C, 4=D(combined)
int  ct_spwr[CT_NSLOT];             // last reported power [W], + = discharge
int  ct_spart[CT_NSLOT];            // participate flag (field 7, default 1)
int  ct_slast[CT_NSLOT];            // millis() of the last request
int  ct_siv[CT_NSLOT];              // measured poll interval [ms]

// ─── Per-battery control state (fair share, balancing, saturation) ─────────
// Only touched while the corresponding option is on; with everything off the
// emulator behaves exactly as before, which is why the defaults are 0.
float ct_ssat[CT_NSLOT];            // saturation score 0..1, EMA
int   ct_sprev[CT_NSLOT];           // previous reported power, to spot movement
int   ct_starg[CT_NSLOT];           // last target handed to this battery
float ct_sfade[CT_NSLOT];           // 1..0 while fading out after a handoff
int   ct_sdc[CT_NSLOT];             // 1 = B2500 family: DC only, 80 W start floor
int   ct_rotms;                     // millis() of the last rotation
int   ct_rotoff;                    // rotation offset into the slot table
float ct_dem;                       // smoothed demand, for the battery count

// ─── Runtime ───────────────────────────────────────────────────────────────
int  ct_pa; int ct_pb; int ct_pc; int ct_ptot;   // grid power reported to the batteries [W]
int  ct_ra; int ct_rb; int ct_rc; int ct_rtot;   // the same, raw - for inspection mode
int  ct_idx;                       // response index 0..255, wraps

// Filled by ctAgg(), read by the response builder.
int  ct_nbA; int ct_nbB; int ct_nbC; int ct_nbD; int ct_live;
int  ct_cx; int ct_cA; int ct_cB; int ct_cC; int ct_cD;    // charge    (< 0)
int  ct_dx; int ct_dA; int ct_dB; int ct_dC; int ct_dD;    // discharge (> 0)
int  ct_once;                       // UDP socket bound once
int  ct_rxc; int ct_txc; int ct_badc;

byte ct_hexd[] = "0123456789abcdef";
byte ct_type[8];                      // "HME-4" or "HME-3"

byte ct_rxb[CT_RXMAX];                     // UDP receive buffer
byte ct_txb[CT_TXMAX];                     // outgoing frame
byte ct_innb[CT_TXMAX];                    // frame body ("|f1|f2|...")

// Parsed request fields (globals, not locals — keeps the VM stack small)
byte ct_qbtype[16];                    // battery type, e.g. "HMG-50"
byte ct_qbmac[16];                     // battery MAC
byte ct_qtype[16];                   // CT type the battery asks for
byte ct_qmac[16];                    // CT MAC the battery asks for
byte ct_qph[8];                        // phase char
byte ct_qpwr[16];                      // signed power
byte ct_qpart[8];                      // participate (optional field 7)

// ─── Marstek cloud registration ────────────────────────────────────────────
byte ct_pass[64];                    // NOT persisted — cleared after use
byte ct_msg[128];                   // status line shown in the web UI
byte ct_tok[96];                     // session token
byte ct_umail[96];                      // url-encoded mailbox
byte ct_req[384];                       // URL; code rejects >250, worst unguarded build ~373
byte ct_buf[320];                     // scratch for parsing
byte ct_resp[1024];                // API response body; measured 555 chars for one CT
byte ct_fnd[6][16];                     // distinct fake-CT MACs seen while scanning
int  ct_rreq;                        // 0 idle, 1 = login+scan, 2 = create
int  ct_busy;
int  ct_savemail;                     // mail write deferred past the cloud call
int  ct_okflag;                         // 1 = last action succeeded (green status)
int  ct_pts;                        // millis() when the password was set

// ─── CT protocol ───────────────────────────────────────────────────────────

// Total frame length. The length digits count towards the length, so the
// digit count is resolved iteratively (as AstraMeter's compute_length).
int ctLen(int innerlen) {
    int base = innerlen + 5;          // SOH + STX + ETX + 2 checksum chars
    if (base + 1 < 10)  return base + 1;
    if (base + 2 < 100) return base + 2;
    return base + 3;
}

// Wrap `innerbuf` (must start with '|') into a complete CT frame in `out`.
void ctFrame(byte out[], byte innerbuf[]) {
    int total = ctLen(strlen(innerbuf));
    sprintf(out, "..%d%s", total, innerbuf);   // ".." reserves SOH/STX
    out[0] = 1;                                // SOH
    out[1] = 2;                                // STX
    int n = strlen(out);
    out[n] = 3;                                // ETX
    int x = 0;
    int i = 0;
    for (i = 0; i <= n; i = i + 1) {           // XOR over SOH..ETX inclusive
        x = x ^ out[i];
    }
    out[n + 1] = ct_hexd[(x >> 4) & 15];
    out[n + 2] = ct_hexd[x & 15];
    out[n + 3] = 0;
}

// Verify the request checksum. Real CTs emit uppercase hex and sometimes a
// leading space for small values, so the comparison stays tolerant.
int ctCheck(int n) {
    if (n < 8) return 0;
    if (ct_rxb[n - 3] != 3) return 0;             // ETX where it belongs
    int x = 0;
    int i = 0;
    for (i = 0; i <= n - 3; i = i + 1) {
        x = x ^ ct_rxb[i];
    }
    int hi = ct_hexd[(x >> 4) & 15];
    int lo = ct_hexd[x & 15];
    int ghi = ct_rxb[n - 2];
    int glo = ct_rxb[n - 1];
    if (ghi >= 65 && ghi <= 70) ghi = ghi + 32;   // 'A'-'F' -> lowercase
    if (glo >= 65 && glo <= 70) glo = glo + 32;
    if (glo != lo) return 0;
    if (ghi == hi) return 1;
    if (ghi == 32 && hi == 48) return 1;          // ' ' instead of '0'
    return 0;
}

// Copy token `n` (1-based, '|' separated) of the request into dst and cut it
// at the first control character — the last field carries the ETX + checksum.
// ⚠️ `byte dst[]`, nicht `char dst[]`: jeder Aufrufer übergibt einen
// gepackten Puffer, und die Schleife unten INDIZIERT ihn. Mit einem
// char[]-Parameter lief sie mit int32-Schrittweite — sie prüfte jedes
// vierte Byte und schrieb ihre Null vier Byte breit über die Nachbarn.
// Die Syscalls (strToken) waren nie betroffen, die Packung reist in der
// Referenz mit; nur der direkte Index nimmt den Typ des PARAMETERS.
int ctTok(byte dst[], int n) {
    int l = strToken(dst, ct_rxb, '|', n);
    int i = 0;
    for (i = 0; i < l; i = i + 1) {
        if (dst[i] < 32) {
            dst[i] = 0;
            return i;
        }
    }
    return l;
}

int ctFind(byte macbuf[]) {
    int i = 0;
    for (i = 0; i < CT_NSLOT; i = i + 1) {
        if (ct_sused[i] == 1) {
            if (strcmp(ct_smac[i], macbuf) == 0) return i;
        }
    }
    return -1;
}

int ctAlloc(byte macbuf[]) {
    int i = 0;
    for (i = 0; i < CT_NSLOT; i = i + 1) {
        if (ct_sused[i] == 0) {
            ct_sused[i]  = 1;
            ct_sph[i]    = 0;
            ct_spwr[i]   = 0;
            ct_spart[i]  = 1;
            ct_siv[i]    = 1000;
            ct_slast[i]  = millis();
            strcpy(ct_smac[i], macbuf);
            addLog("CT002: slot %d new: %s", i, macbuf);
            return i;
        }
    }
    return -1;
}

// Drop consumers that stopped polling — the real CT evicts after ~1-2 cycles.
void ctAge() {
    int now = millis();
    int i = 0;
    for (i = 0; i < CT_NSLOT; i = i + 1) {
        if (ct_sused[i] == 1) {
            int ttl = ct_ttl * 1000;
            if (ttl <= 0) {
                ttl = ct_siv[i] * 2 + 500;
                if (ttl < 5000) ttl = 5000;
            }
            if (now - ct_slast[i] > ttl) {
                ct_sused[i] = 0;
                addLog("CT002: slot %d (%s) expired", i, ct_smac[i]);
            }
        }
    }
}

// Build the buckets over all live, participating slots.
void ctAgg() {
    ct_nbA = 0; ct_nbB = 0; ct_nbC = 0; ct_nbD = 0; ct_live = 0;
    ct_cx = 0; ct_cA = 0; ct_cB = 0; ct_cC = 0; ct_cD = 0;
    ct_dx = 0; ct_dA = 0; ct_dB = 0; ct_dC = 0; ct_dD = 0;
    int i = 0;
    for (i = 0; i < CT_NSLOT; i = i + 1) {
        if (ct_sused[i] == 1) {
            ct_live = ct_live + 1;
            if (ct_spart[i] != 0) {
                int p = ct_spwr[i];
                int f = ct_sph[i];
                if (f == 1) {
                    ct_nbA = ct_nbA + 1;
                    if (p < 0) ct_cA = ct_cA + p; else ct_dA = ct_dA + p;
                } else if (f == 2) {
                    ct_nbB = ct_nbB + 1;
                    if (p < 0) ct_cB = ct_cB + p; else ct_dB = ct_dB + p;
                } else if (f == 3) {
                    ct_nbC = ct_nbC + 1;
                    if (p < 0) ct_cC = ct_cC + p; else ct_dC = ct_dC + p;
                } else if (f == 4) {
                    ct_nbD = ct_nbD + 1;
                    if (p < 0) ct_cD = ct_cD + p; else ct_dD = ct_dD + p;
                } else {
                    // '0'/unassigned: answered, but never aggregated into a
                    // committed phase — the battery is still detecting its phase.
                    if (p < 0) ct_cx = ct_cx + p; else ct_dx = ct_dx + p;
                }
            }
        }
    }
}

// ─── Distribution across several batteries ─────────────────────────────────
// Everything below follows AstraMeter's CT002 loop (docs/ct002.md); the
// constants are its field-tested defaults and are deliberately not exposed:
//   deadband 25 W, max correction 80 W/step, boost above 150 W (x1.5),
//   gentler below 20 W, saturation EMA 0.15, min target 20 W, decay 0.995,
//   count hysteresis 1.2, fade 0.15 per cycle.
//
// The crucial part is the fair share, and it fixes a real fault rather than
// tuning one: today every battery is told the WHOLE phase error, so two of
// them each pull the full amount and the pair overshoots by a factor of two.

// How many participating batteries sit on this phase bucket.
int ctCount(int f) {
    if (f == 1) return ct_nbA;
    if (f == 2) return ct_nbB;
    if (f == 3) return ct_nbC;
    if (f == 4) return ct_nbD;
    return 1;
}

// Sum of the power the batteries on this bucket report.
int ctSum(int f) {
    int s = 0;
    int i = 0;
    for (i = 0; i < CT_NSLOT; i = i + 1) {
        if (ct_sused[i] == 1 && ct_sph[i] == f && ct_spart[i] == 1) s = s + ct_spwr[i];
    }
    return s;
}

// Rotation: which slots are allowed to run when the load is concentrated.
// Called once per second from ctTick().
void ctRotate() {
    int iv = CT_ROT_S;
    int now = millis();
    if (now - ct_rotms < iv * 1000) return;
    ct_rotms = now;
    ct_rotoff = ct_rotoff + 1;
    if (ct_rotoff >= CT_NSLOT) ct_rotoff = 0;
    int i = 0;
    for (i = 0; i < CT_NSLOT; i = i + 1) ct_sfade[i] = 1.0;   // hand over gently
    addLog("CT002: efficiency rotation, offset %d", ct_rotoff);
}

// Rank of this slot within its bucket, counted from the rotation offset.
// Gives every battery its turn at being first without keeping a sorted list.
int ctRank(int idx, int f) {
    int r = 0;
    int k = 0;
    int i = 0;
    for (k = 0; k < CT_NSLOT; k = k + 1) {
        i = (k + ct_rotoff) % CT_NSLOT;
        if (ct_sused[i] == 1 && ct_sph[i] == f && ct_spart[i] == 1) {
            if (i == idx) return r;
            r = r + 1;
        }
    }
    return r;
}

// Keep a DC battery's inverter awake. A Marstek B2500 switches it off at 0 W
// and falls asleep under high PV surplus. We cannot command a battery\'s output
// the way AstraMeter does - we only report grid power - so the equivalent is to
// never tell it less than this much import. That costs exactly this many watts
// of export while the sun is out; it is the price of keeping it awake.
//
// Skipped for a saturated battery: one that is empty cannot discharge anyway,
// so holding the floor there only feeds the grid for nothing. That is the
// complaint in AstraMeter issue #634.
int ctFloor(int idx, int v) {
    if (ct_mindc <= 0) return v;
    // Only a battery whose inverter is external can fall asleep at 0 W. A
    // Venus or a Jupiter carries its own and does not need to be held awake -
    // pushing it there would just export for nothing.
    if (ct_sdc[idx] == 0) return v;
    if (ct_sat == 1 && ct_ssat[idx] > 0.4) return v;
    if (v < ct_mindc) return ct_mindc;
    return v;
}

// The value this one battery is told, derived from its bucket total.
int ctShare(int idx, int f, int base) {
    int n = ctCount(f);
    if (n < 1) n = 1;

    // ── Saturation ────────────────────────────────────────────────────────
    // Did it move in the direction it was asked to? A battery that is full or
    // empty stops following; its score rises and its share shrinks, which the
    // others pick up through the balance term below.
    if (ct_sat == 1) {
        // Below what the battery can physically act on, "it did not move" says
        // nothing - scoring it there is self-reinforcing and eventually pushes
        // a healthy B2500 out of the pool (AstraMeter issue #624).
        int floorw = 20;
        if (ct_sdc[idx] == 1) floorw = 80;
        int want = ct_starg[idx];
        if (want > floorw || want < 0 - floorw) {
            int d = ct_spwr[idx] - ct_sprev[idx];
            int moved = 0;
            if (d * want > 0) moved = 1;
            if (d > 5 || d < -5) moved = 1;
            if (moved == 1) ct_ssat[idx] = ct_ssat[idx] + 0.15 * (0.0 - ct_ssat[idx]);
            else            ct_ssat[idx] = ct_ssat[idx] + 0.15 * (1.0 - ct_ssat[idx]);
        } else {
            ct_ssat[idx] = ct_ssat[idx] * 0.995;
        }
    }
    ct_sprev[idx] = ct_spwr[idx];

    if (ct_fair == 0 || n <= 1) {
        int one = ctFloor(idx, base);
        ct_starg[idx] = one;
        return one;
    }

    float fair = (float)base / (float)n;

    // ── Efficiency: concentrate a small load on fewer batteries ───────────
    // Below the efficient minimum a DC-DC converter wastes the difference as
    // heat, so it is better to run one battery properly than three badly.
    // The threshold is the LARGER of what the user asked for and what the
    // hardware can do at all. A B2500 that is handed 50 W does nothing, so
    // splitting 100 W across two of them leaves both asleep - the pair has to
    // be concentrated on one whether or not the efficiency option is set.
    float minw = 0.0;
    if (ct_sdc[idx] == 1) minw = 80.0;
    if (minw > 0.0) {
        float dem = (float)base;
        if (dem < 0.0) dem = 0.0 - dem;
        ct_dem = ct_dem + 0.1 * (dem - ct_dem);         // EMA, meter noise out
        int need = (int)(ct_dem / (minw * 1.2)) + 1;    // 1.2 = hysteresis
        if (need < 1) need = 1;
        if (need > n) need = n;
        int rank = ctRank(idx, f);
        if (rank >= need) {
            // Deprioritised. Fade instead of dropping to zero at once, so a
            // handoff does not leave a hole while the promoted one ramps.
            ct_sfade[idx] = ct_sfade[idx] * 0.85;
            if (ct_sfade[idx] < 0.02) ct_sfade[idx] = 0.0;
            int outv = (int)(fair * ct_sfade[idx]);
            outv = ctFloor(idx, outv);
            ct_starg[idx] = outv;
            return outv;
        }
        ct_sfade[idx] = 1.0;
        fair = (float)base / (float)need;               // the active ones share it
    }

    // ── Balancing ─────────────────────────────────────────────────────────
    // Push the battery that is doing less than its peers, hold back the one
    // doing more. The gain is boosted while the imbalance is large and eased
    // as they converge, so the pair settles instead of ringing.
    int    sum = ctSum(f);
    float  avg = (float)sum / (float)n;
    float  e   = avg - (float)ct_spwr[idx];
    float  corr = 0.0;
    float  ae = e;
    if (ae < 0.0) ae = 0.0 - ae;
    if (ae >= 25.0) {
        float g = CT_BGAIN;
        if (ae > 150.0) g = g * 1.5;
        corr = g * e;
        if (corr > 80.0) corr = 80.0;
        if (corr < -80.0) corr = -80.0;
        // A correction has to be FELT. An HMJ-2 ignores less than about 10 W
        // per channel, so a 8 W nudge changes nothing while the balancer
        // believes it acted - AstraMeter issue #600, where a battery sat at
        // 4 W for hours while "receiving positive corrections". Below the
        // imbalance threshold we send nothing at all; above it we send at
        // least enough to clear the deadband.
        if (corr > 0.0 && corr < 20.0) corr = 20.0;
        if (corr < 0.0 && corr > -20.0) corr = -20.0;
    }
    // Deliberately NO gentler correction below the threshold. That is
    // AstraMeter\'s ERROR_REDUCE_THRESHOLD, and it is what produces the
    // sub-deadband nudges above: they cost a round trip and achieve nothing.

    float v = fair + corr;
    if (ct_sat == 1 && ct_ssat[idx] > 0.4) v = v * (1.0 - ct_ssat[idx]);

    int out = (int)v;
    out = ctFloor(idx, out);
    ct_starg[idx] = out;
    return out;
}

// Slot of the battery currently being answered, -1 = unknown. Set by the
// request handler right before ctBuild(); the frame builder needs it to hand
// out a per-battery share.
int ct_slot;

// Build the response for one requesting battery into ct_txb.
void ctBuild(byte btype[], byte bmac[], byte reqctmac[]) {
    ctAgg();

    // Identity: CT first, battery second — the reverse of the request order.
    if (strlen(ct_mac) == 12) {
        sprintf(ct_innb, "|%s|%s", ct_type, ct_mac);
    } else {
        sprintf(ct_innb, "|%s|%s", ct_type, reqctmac);
    }
    sprintfAppend(ct_innb, "|%s|%s", btype, bmac);
    // Per battery, not global: the response is unicast, so each one can be
    // told its own share. With every option off ctShare() returns the bucket
    // value unchanged and the frame is byte-identical to before.
    int va = ct_pa; int vb = ct_pb; int vc = ct_pc; int vd = ct_ptot;
    if (ct_slot >= 0) {
        if (ct_sph[ct_slot] == 0) {
            // Inspection mode: the battery has no phase yet and is finding it
            // by swinging its own output and watching which phase moves. The
            // regulator is built to HIDE exactly that - the predictor credits
            // the swing before the meter shows it, the clamp caps what is left
            // - so the battery could open up to 800 W, still read 0 W and never
            // conclude. Send the raw meter until it has decided. AstraMeter does
            // the same (ct002.py _resolve_target: the balancer runs only when
            // "not request.in_inspection_mode").
            va = ct_ra; vb = ct_rb; vc = ct_rc; vd = ct_rtot;
        } else {
            if (ct_sph[ct_slot] == 1) va = ctShare(ct_slot, 1, ct_pa);
            if (ct_sph[ct_slot] == 2) vb = ctShare(ct_slot, 2, ct_pb);
            if (ct_sph[ct_slot] == 3) vc = ctShare(ct_slot, 3, ct_pc);
            if (ct_sph[ct_slot] == 4) vd = ctShare(ct_slot, 4, ct_ptot);
        }
    }
    sprintfAppend(ct_innb, "|%d|%d|%d|%d", va, vb, vc, vd);                  // 5..8
    sprintfAppend(ct_innb, "|%d|%d|%d|%d", ct_nbA, ct_nbB, ct_nbC, ct_nbD);        // 9..12
    sprintfAppend(ct_innb, "|%d|%d", ct_rssi, ct_idx);                       // 13..14
    sprintfAppend(ct_innb, "|%d|%d|%d|%d|%d", ct_cx, ct_cA, ct_cB, ct_cC, ct_cD);   // 15..19
    sprintfAppend(ct_innb, "|%d|%d|%d|%d|%d", ct_dx, ct_dA, ct_dB, ct_dC, ct_dD);   // 20..24
    if (ct_kind == 1) {
        // CT003 only: 4 tariff registers, everything on the peak tariff.
        // Wh assumed - the exact scaling is unconfirmed.
        int ein  = (int)(smlGet(2) * 1000.0);
        int eout = (int)(smlGet(3) * 1000.0);
        sprintfAppend(ct_innb, "|0|%d|0|%d", ein, eout);           // 25..28
    }
    ctFrame(ct_txb, ct_innb);
}

// Handle one received datagram (already in ct_rxb, `n` bytes).
void ctHandle(int n) {
    if (n < 12)  return;
    if (ct_rxb[0] != 1) return;                   // SOH
    if (ct_rxb[1] != 2) return;                   // STX
    if (ctCheck(n) == 0) {
        ct_badc = ct_badc + 1;
        return;
    }

    ctTok(ct_qbtype,  2);
    ctTok(ct_qbmac,   3);
    ctTok(ct_qtype, 4);
    ctTok(ct_qmac,  5);
    ctTok(ct_qph,     6);
    ctTok(ct_qpwr,    7);
    int havepart = ctTok(ct_qpart, 8);

    if (strlen(ct_qbmac) < 6) return;

    // Only answer for our own CT MAC (or the wildcard) once one is configured.
    strToLower(ct_qmac);
    if (strlen(ct_mac) == 12) {
        if (strcmp(ct_qmac, ct_mac) != 0) {
            if (strcmp(ct_qmac, "000000000000") != 0) return;
        }
    }

    int f = 0;                                  // phase bucket
    int c = ct_qph[0];
    if (c == 'A' || c == 'a') f = 1;
    if (c == 'B' || c == 'b') f = 2;
    if (c == 'C' || c == 'c') f = 3;
    if (c == 'D' || c == 'd') f = 4;            // D = combined (合相), not a 4th phase

    int idx = ctFind(ct_qbmac);
    if (idx < 0) idx = ctAlloc(ct_qbmac);
    if (idx < 0) return;                        // table full — real CT holds 9 too

    int now = millis();
    int dt  = now - ct_slast[idx];
    if (dt > 100 && dt < 30000) ct_siv[idx] = dt;
    ct_slast[idx] = now;
    // Phase changes are worth a line: a battery reporting '0' is still
    // diagnosing which phase it sits on and gets the raw meter (ctBuild).
    if (ct_sph[idx] != f) {
        if (f == 0) addLog("CT002: %s in inspection mode, raw meter sent", ct_qbmac);
        else        addLog("CT002: %s settled on phase %s", ct_qbmac, ct_qph);
    }
    ct_sph[idx]   = f;
    ct_spwr[idx]  = strToInt(ct_qpwr);
    // Device family, from the type the battery sends with every request.
    // HMA/HMJ/HMK is the B2500 line: DC into a SEPARATE inverter, each channel
    // a hard on/off below ~40 W - so the unit cannot answer a command under
    // about 80 W at all. HMG/VNS (Venus) and HMN/HMM/JPLS (Jupiter) carry their
    // own inverter and have no such floor. Classification and the 80 W figure
    // are AstraMeter's (balancer.py, DC_MIN_ACTIONABLE_OUTPUT_W).
    ct_sdc[idx] = 0;
    if (strFind(ct_qbtype, "HMA") == 0) ct_sdc[idx] = 1;
    if (strFind(ct_qbtype, "HMJ") == 0) ct_sdc[idx] = 1;
    if (strFind(ct_qbtype, "HMK") == 0) ct_sdc[idx] = 1;
    if (havepart > 0) {
        ct_spart[idx] = strToInt(ct_qpart);
    } else {
        ct_spart[idx] = 1;                        // absent field means "participating"
    }

    ct_idx = (ct_idx + 1) & 255;
    ct_slot = idx;
    ctBuild(ct_qbtype, ct_qbmac, ct_qmac);
    udp(2, ct_txb);                                // unicast back to the sender
    ct_txc = ct_txc + 1;
}

// ─── Meter ─────────────────────────────────────────────────────────────────

// ─── Regulator ─────────────────────────────────────────────────────────────
// One control loop per phase - each battery nulls the phase it sits on - plus
// a fourth for the combined total that phase D reads. Slot 0..2 = A/B/C, 3 = D.
//
// The previous version paced the reported VALUE against an anchor: the change
// per cycle was capped, so the anchor lagged the error by many seconds. That
// puts a rate limiter in SERIES with the battery's own integrator - the grid
// could already be exporting while we still reported import, and the battery
// kept adding to it. AstraMeter clamps the command absolutely instead
// (balancer.py _pace_reading: out = clamp(reading, +/-limit)), and the parts
// below now follow it: predictor, trim, damper, clamp.
float ct_pg[4];         // predicted grid error [W], latency compensated
int   ct_pgi[4];        // 1 = predictor seeded
float ct_ppool[4];      // pool output at the last call [W]
float ct_ptrust[4];     // meter trust 0.15..0.9, self-adapting
int   ct_pinv[4];       // sign of the last innovation
float ct_rawprev[4];    // last meter value, to spot a repeated sample
int   ct_dwell[4];      // consecutive fresh samples inside the trim gate
float ct_osc[4];        // oscillation score 0..1
int   ct_osign[4];      // sign of the last residual
int   ct_step[4];       // current pacing cap [W]
int   ct_psign[4];      // sign of the last paced command

// Predictor / pacing constants, at AstraMeter's field-tested values.
#define CT_TRUST_MIN  0.15
#define CT_TRUST_MAX  0.9
#define CT_TRUST_UP   0.2
#define CT_TRUST_DN   0.5
#define CT_INNOV_W    40.0    // innovation below this does not adapt the trust
#define CT_TRIM_GATE  120.0   // trim only inside (0, this) - excludes an empty pack
#define CT_TRIM_DWELL 6       // fresh samples the gate must hold
#define CT_OSC_MAX    0.95    // maximum damping
#define CT_OSC_ALPHA  0.3     // score per sign reversal
#define CT_OSC_DECAY  0.05    // bled off otherwise
#define CT_OSC_STEP   300.0   // above this it is a load step, not hunting
#define CT_PACE_MOVE  5.0     // pool movement that counts as "it followed"

// Output the batteries of this loop have already delivered. Phase A/B/C see
// only their own bucket; the saldierend total sees every battery.
int ctPool(int ph) {
    if (ph < 3) return ctSum(ph + 1);
    int s = 0;
    int i = 0;
    for (i = 0; i < CT_NSLOT; i = i + 1) {
        if (ct_sused[i] == 1 && ct_spart[i] == 1) s = s + ct_spwr[i];
    }
    return s;
}

int ctCtrl(float raw, int ph) {
    float off = (float)ct_offset;
    float err = raw - off;              // this is what the battery nulls

    if (ct_tweak == 0) {                // active control off: relay as before
        ct_pgi[ph] = 0;                 // re-seed when it is switched back on
        ct_rawprev[ph] = raw;
        return (int)err;
    }

    // A repeated meter value carries no new information. Everything that
    // integrates - the trust update and the trim dwell - is gated on this, or
    // a slow meter would be counted several times over.
    int fresh = 1;
    if (raw == ct_rawprev[ph]) fresh = 0;
    ct_rawprev[ph] = raw;

    // --- Grid predictor ---------------------------------------------------
    // The meter shows a correction only seconds after the battery delivered
    // it. Until then the raw error still asks for it, and the loop issues it
    // a second time - that is the hunt. So advance the estimate by what the
    // batteries report having changed, and let only a fresh meter sample pull
    // it back, weighted by a trust that learns: a run of same-sign
    // innovations is a real load step and raises it, a sign flip is latency
    // and halves it. AstraMeter balancer.py _predict_control_grid.
    int   pool  = ctPool(ph);
    float dpool = 0.0;
    if (ct_pgi[ph] == 0) {
        ct_pg[ph] = err;
        ct_ptrust[ph] = 0.5;
        ct_pinv[ph] = 0;
        ct_pgi[ph] = 1;
    } else {
        dpool = (float)pool - ct_ppool[ph];
        ct_pg[ph] = ct_pg[ph] - dpool;
        if (fresh == 1) {
            float innov = err - ct_pg[ph];
            float ai = innov;
            if (ai < 0.0) ai = 0.0 - ai;
            int sg = 0;
            if (innov > 0.0) sg = 1;
            if (innov < 0.0) sg = 0 - 1;
            if (ai >= CT_INNOV_W && sg != 0) {
                if (ct_pinv[ph] == 0 || sg == ct_pinv[ph]) {
                    ct_ptrust[ph] = ct_ptrust[ph] + CT_TRUST_UP;
                    if (ct_ptrust[ph] > CT_TRUST_MAX) ct_ptrust[ph] = CT_TRUST_MAX;
                } else {
                    ct_ptrust[ph] = ct_ptrust[ph] * CT_TRUST_DN;
                    if (ct_ptrust[ph] < CT_TRUST_MIN) ct_ptrust[ph] = CT_TRUST_MIN;
                }
                ct_pinv[ph] = sg;
            }
            ct_pg[ph] = ct_pg[ph] + ct_ptrust[ph] * innov;
        }
    }
    ct_ppool[ph] = (float)pool;
    float v = ct_pg[ph];

    // --- Steady-import trim -----------------------------------------------
    // Every Marstek firmware parks the grid a few watts to the import side of
    // zero - its own input deadband. A FIXED nudge once the grid has held in a
    // small import band for a few fresh samples; not an integrator, which
    // would be a second one behind the battery's and only add phase lag. The
    // upper gate keeps it away from the large steady import an empty or
    // saturated pack leaves.
    if (ct_trim > 0 && fresh == 1) {
        if (v > 0.0 && v < CT_TRIM_GATE) {
            if (ct_dwell[ph] < 1000) ct_dwell[ph] = ct_dwell[ph] + 1;
        } else {
            ct_dwell[ph] = 0;
        }
        if (ct_dwell[ph] >= CT_TRIM_DWELL) v = v + (float)ct_trim;
    }

    // --- Oscillation damping ----------------------------------------------
    // A real load step keeps its sign; a latency-driven limit cycle flips it
    // nearly every cycle. Count the flips and bleed the gain that sustains
    // them - without slowing a genuine step, which passes at full gain above
    // CT_OSC_STEP. AstraMeter balancer.py _damp_oscillation (issue #473).
    int vs = 0;
    if (v > 0.0) vs = 1;
    if (v < 0.0) vs = 0 - 1;
    float av = v;
    if (av < 0.0) av = 0.0 - av;
    if (av > CT_OSC_STEP) {
        ct_osc[ph] = ct_osc[ph] * (1.0 - CT_OSC_DECAY);
    } else {
        if (vs != 0 && ct_osign[ph] != 0 && vs != ct_osign[ph]) {
            ct_osc[ph] = ct_osc[ph] + CT_OSC_ALPHA;
            if (ct_osc[ph] > 1.0) ct_osc[ph] = 1.0;
        } else {
            ct_osc[ph] = ct_osc[ph] * (1.0 - CT_OSC_DECAY);
        }
    }
    if (vs != 0) ct_osign[ph] = vs;
    v = v * (1.0 - CT_OSC_MAX * ct_osc[ph]);

    // --- Ramp pacing ------------------------------------------------------
    // An absolute clamp around zero, never a step away from the last value.
    // The cap starts at ct_pace, doubles toward three times that only while
    // the batteries demonstrably follow, falls back with the error and resets
    // on a direction reversal.
    //
    // AstraMeter's stall escape for a B2500 that cannot execute a small
    // command is not here: this loop serves a whole phase and does not know
    // which family sits on it. The 80 W start floor for those is handled per
    // battery in ctShare().
    if (ct_pace > 0) {
        int cap = ct_step[ph];
        if (cap < ct_pace) cap = ct_pace;
        int sg = 0;
        if (v > 0.0) sg = 1;
        if (v < 0.0) sg = 0 - 1;
        float ap = v;
        if (ap < 0.0) ap = 0.0 - ap;
        if (sg == 0 || sg != ct_psign[ph]) {
            cap = ct_pace;              // reversal - nothing learned carries over
        } else if (ap > (float)cap) {
            if (dpool * (float)sg >= CT_PACE_MOVE) cap = cap * 2;
        } else {
            cap = (int)ap;              // follow the error back down
            if (cap < ct_pace) cap = ct_pace;
        }
        if (cap > ct_pace * 3) cap = ct_pace * 3;
        ct_step[ph] = cap;
        ct_psign[ph] = sg;
        if (v > (float)cap) v = (float)cap;
        if (v < (float)(0 - cap)) v = (float)(0 - cap);
    }

    // The minimum-output floor used to sit here. It moved into ctShare(),
    // which is per battery: at this level the fair split would halve it, and
    // half of 20 W lands inside the HMJ's own +/-10 W per-channel deadband -
    // the lock-in described in AstraMeter issue #600.
    return (int)v;
}

void ctPower() {
    if (sml_ph3 == 1) {
        ct_ra = (int)smlGet(4);
        ct_rb = (int)smlGet(5);
        ct_rc = (int)smlGet(6);
        ct_pa = ctCtrl(smlGet(4), 0);
        ct_pb = ctCtrl(smlGet(5), 1);
        ct_pc = ctCtrl(smlGet(6), 2);
    } else {
        // Single-value meter: everything on L1, like the Shelly emulation.
        // Set every battery to phase A (or all to D, which reads the total).
        ct_ra = (int)smlGet(1);
        ct_rb = 0;
        ct_rc = 0;
        ct_pa = ctCtrl(smlGet(1), 0);
        ct_pb = 0;
        ct_pc = 0;
    }
    ct_rtot = (int)smlGet(1);
    ct_ptot = ctCtrl(smlGet(1), 3);    // the saldierend total — phase D reads this
}

// ─── Marstek cloud registration (HTTPS via httpGet + md5) ──────────────────

// Ebenfalls beide gepackt und beide indiziert — siehe ctTok().
void ctUrlMail(byte dst[], byte src[]) {
    int n = strlen(src);
    int i = 0;
    int j = 0;
    for (i = 0; i < n; i = i + 1) {
        int c = src[i];
        if (c == '@') {
            dst[j] = '%'; dst[j + 1] = '4'; dst[j + 2] = '0'; j = j + 3;
        } else if (c == '+') {
            dst[j] = '%'; dst[j + 1] = '2'; dst[j + 2] = 'B'; j = j + 3;
        } else {
            dst[j] = c; j = j + 1;
        }
    }
    dst[j] = 0;
}

// GET /app/Solar/v2_get_device.php — returns a token plus the device list.
// Fills ct_tok and leaves the body in ct_resp. Returns 1 on success.
int ctLogin() {
    if (strlen(ct_mail) < 5) { strcpy(ct_msg, "Mail missing"); return 0; }
    if (strlen(ct_pass) < 1) { strcpy(ct_msg, "Password missing"); return 0; }

    byte dig[20];
    byte dighex[40];
    if (md5(ct_pass, strlen(ct_pass), dig) != 1) {
        strcpy(ct_msg, "MD5 not available in this firmware");
        return 0;
    }
    bin2hex(dig, 16, dighex);
    ctUrlMail(ct_umail, ct_mail);

    // Short enough for httpGet's 256-char URL limit, and httpGet de-chunks
    // the reply for us — which the raw TLS path below would not.
    strcpy(ct_req, "https://");
    strcat(ct_req, ct_host);
    strcat(ct_req, "/app/Solar/v2_get_device.php?mailbox=");
    strcat(ct_req, ct_umail);
    strcat(ct_req, "&pwd=");
    strcat(ct_req, dighex);

    // The TLS handshake wants one large contiguous block. On a fragmented
    // heap it fails to allocate and httpGet just returns 0, so log what was
    // available - that is the difference between "no network" and "no RAM".
    addLog("CT002: login, heap %d, largest block %d", tasm_heap, tasm_maxblock);
    int n = httpGet(ct_req, ct_resp);
    if (n >= 1000) addLog("CT002: WARNING login reply %d chars, ct_resp holds 1023 - may be truncated", n);
    else           addLog("CT002: login reply %d chars", n);
    if (n <= 0) {
        // BearSSL wants one contiguous 16 kB record buffer. Measured on an
        // ESP32-C3: the handshake went through at ~12.7 kB largest block and
        // failed at ~9.1 kB. It is fragmentation, not the total - switching
        // TinyC programs at runtime leaves the heap in pieces (60 kB free,
        // largest block 10 kB), a reboot restores it.
        if (tasm_maxblock < 13000) {
            sprintf(ct_msg, "Not enough contiguous RAM (%d B) - restart the device, then log in right away", tasm_maxblock);
        } else {
            sprintf(ct_msg, "No reply from Marstek (rc=%d, free block %d B)", n, tasm_maxblock);
        }
        return 0;
    }
    int p = strFind(ct_resp, "\"token\":\"");
    if (p < 0) {
        // The API answers 200 with code=4 on a wrong password.
        if (strFind(ct_resp, "\"code\":4") >= 0) {
            strcpy(ct_msg, "Login refused - wrong password?");
        } else {
            strcpy(ct_msg, "No token in reply - login failed");
        }
        return 0;
    }
    strSub(ct_tok, ct_resp, p + 9, 0);
    int q = strFind(ct_tok, "\"");
    if (q > 0) ct_tok[q] = 0;
    return 1;
}

// Scan the device list for managed fake CTs (devid = mac = 02b250xxxxxx, the
// prefix AstraMeter uses). The scan is destructive — ct_resp is scratch.
// One device yields TWO hits (devid and mac carry the same value), so the
// results are deduplicated - otherwise one CT would be counted as two.
int ctScan() {
    int found = 0;      // distinct CTs
    int nfnd  = 0;      // entries stored in ct_fnd[]
    int guard = 0;
    while (guard < 16) {
        int m = strFind(ct_resp, "02b250");
        if (m < 0) break;
        strSub(ct_buf, ct_resp, m, 12);
        ct_resp[m] = 'X';                 // don't match the same spot again
        guard = guard + 1;
        if (strlen(ct_buf) == 12) {
            strToLower(ct_buf);
            int dup = 0;
            int k = 0;
            for (k = 0; k < nfnd; k = k + 1) {
                if (strcmp(ct_fnd[k], ct_buf) == 0) dup = 1;
            }
            if (dup == 0) {
                if (nfnd < 6) {
                    strcpy(ct_fnd[nfnd], ct_buf);
                    nfnd = nfnd + 1;
                }
                // Never overwrite a CT MAC that is already set - with two fake
                // CTs in the account this would silently switch the device to
                // the other one.
                if (found == 0 && strlen(ct_mac) != 12) {
                    strcpy(ct_mac, ct_buf);
                    addLog("CT002: fake CT adopted: %s", ct_buf);
                } else {
                    addLog("CT002: fake CT found: %s (not adopted)", ct_buf);
                }
                found = found + 1;
            }
        }
    }
    return found;
}

void ctDoLogin() {
    ct_okflag = 0;
    strcpy(ct_msg, "Login running ...");
    if (ctLogin() == 0) return;
    int found = ctScan();
    if (found > 0) {
        saveVars();
        ct_okflag = 1;
        sprintf(ct_msg, "OK - %d fake CT(s) found, CT MAC = ", found);
        strcat(ct_msg, ct_mac);
    } else {
        strcpy(ct_msg, "Login OK, no CT found");
    }
}

// GET /app/Solar/v2_add_device.php — creates the managed CT record.
void ctDoCreate() {
    ct_okflag = 0;
    if (strlen(ct_mac) == 12) {
        strcpy(ct_msg, "CT MAC already set - clear it first");
        return;
    }
    strcpy(ct_msg, "Creating ...");
    if (ctLogin() == 0) return;
    if (ctScan() > 0) {
        saveVars();
        ct_okflag = 1;
        strcpy(ct_msg, "Fake CT already exists - adopted instead");
        return;
    }

    // devid = mac = 02b250 + 6 random hex, like AstraMeter's _generate_new_id
    byte nm[16];
    byte one[4];
    strcpy(nm, "02b250");
    int i = 0;
    for (i = 0; i < 6; i = i + 1) {
        int r = random(0, 16);
        if (r > 15) r = 15;            // guard: ct_hexd[16] is the NUL terminator
        if (r < 0)  r = 0;
        one[0] = ct_hexd[r];
        one[1] = 0;
        strcat(nm, one);
    }
    if (strlen(nm) != 12) {
        strcpy(ct_msg, "MAC generation failed");
        return;
    }
    byte sfx[8];
    strSub(sfx, nm, -4, 4);

    // httpGet, not the raw TLS socket: tlsConnect() (BearSSL) fails against
    // this host on the ESP32-C3, while httpGet (mbedtls) reaches it - the
    // login above proves it. Price: httpGet cuts the URL at 256 chars, so
    // mandatory fields go first and the rest only while it fits.

    strcpy(ct_req, "https://");
    strcat(ct_req, ct_host);
    strcat(ct_req, "/app/Solar/v2_add_device.php?mailbox=");
    strcat(ct_req, ct_umail);
    strcat(ct_req, "&devid=");
    strcat(ct_req, nm);
    strcat(ct_req, "&mac=");
    strcat(ct_req, nm);
    strcat(ct_req, "&type=");
    strcat(ct_req, ct_type);
    strcat(ct_req, "&token=");
    strcat(ct_req, ct_tok);
    strcat(ct_req, "&access=1&name=CT002&bluetooth_name=MST-SMR_");
    strcat(ct_req, sfx);
    if (strlen(ct_req) + 25 <= 250) strcat(ct_req, "&timeZone=Europe%2FBerlin");
    if (strlen(ct_req) + 12 <= 250) strcat(ct_req, "&version=121");
    if (strlen(ct_req) + 16 <= 250) strcat(ct_req, "&position=%7B%7D");
    int ulen = strlen(ct_req);
    addLog("CT002: add_device URL %d chars", ulen);
    if (ulen > 250) {
        sprintf(ct_msg, "URL too long (%d chars) - mail address too long?", ulen);
        return;
    }

    httpHeader("User-Agent", "Dart/2.19 (dart:io)");
    httpHeader("Accept", "application/json");
    httpHeader("token", ct_tok);

    int rn = httpGet(ct_req, ct_resp);
    if (rn >= 1000) addLog("CT002: WARNING create reply %d chars, ct_resp holds 1023 - may be truncated", rn);
    else            addLog("CT002: create reply %d chars", rn);
    if (rn <= 0) {
        sprintf(ct_msg, "No reply on create (rc=%d)", rn);
        return;
    }
    int good = 0;
    if (strFind(ct_resp, "\"code\":1")   >= 0) good = 1;
    if (strFind(ct_resp, "\"code\":2")   >= 0) good = 1;
    if (strFind(ct_resp, "\"code\":\"1\"") >= 0) good = 1;
    if (strFind(ct_resp, "\"code\":\"2\"") >= 0) good = 1;
    if (good == 0) {
        strcpy(ct_msg, "Create refused: ");
        strcat(ct_msg, ct_resp);
        return;
    }
    strcpy(ct_mac, nm);
    saveVars();
    strcpy(ct_pass, "");            // done - drop the password now
    ct_okflag = 1;
    strcpy(ct_msg, "Fake CT created, CT MAC = ");
    strcat(ct_msg, ct_mac);
    addLog("CT002: fake CT created in Marstek cloud: %s (%s)", nm, ct_type);
}


// ─── Building-block API ────────────────────────────────────────────────────
// This file defines no callbacks - the including program owns them and calls
// the functions below. Meter setup (descriptor, pins, filter) belongs to
// sml_descriptor.tc, telemetry (power2, /pwr) to the base program.

int ct_webnum;                       // webOn handler number for /ctreg

// From main(). `webnum` is the webOn handler id the wiring reserves for
// /ctreg - only slot 0 can serve it at all.
void ctInit(int webnum) {
    ctEditLoad();
    ct_once = 0;
    ct_idx  = 0;
    ct_rxc  = 0;
    ct_txc  = 0;
    ct_badc = 0;
    ct_rreq = 0;
    ct_busy = 0;
    ct_okflag = 0;
    ct_pts = 0;
    strcpy(ct_pass, "");
    strcpy(ct_msg, "ready");

    int i = 0;
    for (i = 0; i < CT_NSLOT; i = i + 1) {
        ct_sused[i] = 0;
        ct_sph[i]   = 0;
        ct_spwr[i]  = 0;
        ct_spart[i] = 1;
        ct_siv[i]   = 1000;
        ct_slast[i] = 0;
        strcpy(ct_smac[i], "");
    }
    ctAgg();

    if (ct_port < 1)  ct_port = 12345;
    if (ct_rssi == 0) ct_rssi = -50;
    if (ct_rssi > 0)  ct_rssi = 0 - ct_rssi;
    if (ct_kind == 1) {
        strcpy(ct_type, "HME-3");
    } else {
        strcpy(ct_type, "HME-4");
    }
    strToLower(ct_mac);

    ct_webnum = webnum;
    webOn(webnum, "/ctreg");
}

// From Every100ms(). A few datagrams per tick so a burst from several
// batteries drains without waiting 100 ms each.
void ctPoll() {
    if (ct_once == 0) return;
    int guard = 0;
    while (guard < 4) {
        int n = udp(1, ct_rxb);
        if (n <= 0) return;
        ct_rxc = ct_rxc + 1;
        ctHandle(n);
        guard = guard + 1;
    }
}

// From EverySecond().
void ctTick() {
    if (tc_opt_first == 1) {
        ct_kind   = tcOptGet(19, ct_kind);
        ct_offset = tcOptGet(20, ct_offset);
        ct_port   = tcOptGet(21, ct_port);
        ct_rssi   = tcOptGet(22, ct_rssi);
        ct_ttl    = tcOptGet(23, ct_ttl);
        ct_tweak  = tcOptGet(24, ct_tweak);
        ct_trim   = tcOptGet(26, ct_trim);
        ct_pace   = tcOptGet(27, ct_pace);
        ct_mindc  = tcOptGet(28, ct_mindc);
        ct_fair   = tcOptGet(29, ct_fair);
        ct_sat    = tcOptGet(33, ct_sat);
        tcOptSet(19, ct_kind);
        tcOptSet(20, ct_offset);
        tcOptSet(21, ct_port);
        tcOptSet(22, ct_rssi);
        tcOptSet(23, ct_ttl);
        tcOptSet(24, ct_tweak);
        tcOptSet(26, ct_trim);
        tcOptSet(27, ct_pace);
        tcOptSet(28, ct_mindc);
        tcOptSet(29, ct_fair);
        tcOptSet(33, ct_sat);
        ctEditLoad();
    }
    if (ui_reloading) ctEditLoad();
    if (ui_applying) ctCommit();
    if (tasm_wifi == 1 && ct_once == 0) {
        if (ct_port < 1) ct_port = 12345;
        if (udp(0, ct_port) == 1) {
            // The firmware re-binds the socket after 60 s without a packet.
            // Harmless under load, noisy when idle - 300 s keeps recovery.
            udp(8, 1, 300);
            ct_once = 1;
            addLog("CT002: %s listening on UDP %d (CT MAC %s)", ct_type, ct_port, ct_mac);
        }
    }

    ctPower();
    ctRotate();
    ctAge();
    strToLower(ct_mac);          // the web field may have been typed upper case

    if (strlen(ct_pass) > 0 && ct_busy == 0) {
        if (millis() - ct_pts > 600000) {
            strcpy(ct_pass, "");
            addLog("CT002: cached Marstek password discarded after 10 min");
        }
    }
}

// From TaskLoop(). Cloud calls block for seconds, so they must not run in
// EverySecond - there they would stall the Tasmota main loop.
void ctTask() {
    if (ct_rreq > 0) {
        int what = ct_rreq;
        ct_rreq  = 0;
        ct_busy  = 1;
        if (what == 1) {
            ctDoLogin();
        } else {
            ctDoCreate();
        }
        // Password stays in RAM for step 2 (both steps need a token) and is
        // dropped on success or by timeout in ctTick(). Never on flash.
        ct_busy = 0;
        if (ct_savemail) {          // deferred by ctWebOn - see there
            ct_savemail = 0;
            saveVars();
        }
    }
}

// From WebCall(): rows for the main sensor page.
void ctRows() {
    sprintf(ct_buf, "{s}Emulation{m}%s{e}", ct_type);
    webSend(ct_buf);
    if (strlen(ct_mac) == 12) {
        sprintf(ct_buf, "{s}CT MAC{m}%s{e}", ct_mac);
    } else {
        if (ui_de) strcpy(ct_buf, "{s}CT MAC{m}(alle){e}");
        else       strcpy(ct_buf, "{s}CT MAC{m}(any){e}");
    }
    webSend(ct_buf);

    int i = 0;
    int live = 0;
    byte pn[4];
    for (i = 0; i < CT_NSLOT; i = i + 1) {
        if (ct_sused[i] == 1) {
            live = live + 1;
            strcpy(pn, "x");
            if (ct_sph[i] == 1) strcpy(pn, "A");
            if (ct_sph[i] == 2) strcpy(pn, "B");
            if (ct_sph[i] == 3) strcpy(pn, "C");
            if (ct_sph[i] == 4) strcpy(pn, "D");
            if (ui_de) sprintf(ct_buf, "{s}Akku %s{m}", ct_smac[i]);
            else       sprintf(ct_buf, "{s}Battery %s{m}", ct_smac[i]);
            sprintfAppend(ct_buf, "Ph %s &middot; %d W", pn, ct_spwr[i]);
            if (ct_spart[i] == 0) strcat(ct_buf, " (passiv)");
            sprintfAppend(ct_buf, " &middot; %d ms{e}", ct_siv[i]);
            webSend(ct_buf);
        }
    }
    if (ui_de) {
        sprintf(ct_buf, "{s}Akkus{m}%d{e}", live);            webSend(ct_buf);
        sprintf(ct_buf, "{s}CT meldet{m}%d W{e}", ct_ptot);   webSend(ct_buf);
    } else {
        sprintf(ct_buf, "{s}Batteries{m}%d{e}", live);        webSend(ct_buf);
        sprintf(ct_buf, "{s}CT sees{m}%d W{e}", ct_ptot);     webSend(ct_buf);
    }
}

// From WebUI(): emitted inside an already-open settings panel, so no <div>
// and no styles of its own beyond the help-link class.
void ctPanel() {
    webSend("<style>a.i{text-decoration:none;margin-left:6px}</style>");

    uiHead("&#x1F50C;", "CT", "CT", "ct002/#ct");
    // CT MAC read-only: webText writes through a broken sv= path in the
    // firmware and corrupted the neighbouring settings. It is set on /ctreg.
    if (ct_mac[0]) sprintf(ct_buf, "<div style='font-size:12px;color:#444'>CT MAC: <b>%s</b></div>", ct_mac);
    else           strcpy(ct_buf, "<div style='font-size:12px;color:#444'>CT MAC: &mdash;</div>");
    webSend(ct_buf);
    if (ui_de) {
        webPulldown(ct_e_kind, "Typ (Neustart)", "CT002 (HME-4)|CT003 (HME-3)");
        webNumber(ct_e_port, 1024, 65535, "UDP-Port");
        webNumber(ct_e_rssi, -90, -20, "RSSI [dBm]");
        webNumber(ct_e_ttl, 0, 300, "Akku-Timeout [s]");
    } else {
        webPulldown(ct_e_kind, "Type (restart)", "CT002 (HME-4)|CT003 (HME-3)");
        webNumber(ct_e_port, 1024, 65535, "UDP port");
        webNumber(ct_e_rssi, -90, -20, "RSSI [dBm]");
        webNumber(ct_e_ttl, 0, 300, "Battery timeout [s]");
    }
    sprintf(ct_buf, "<div style='font-size:12px;color:#444'>UDP rx/tx/bad: %d / %d / ", ct_rxc, ct_txc);
    sprintfAppend(ct_buf, "%d</div>", ct_badc);
    webSend(ct_buf);

    uiHead("&#x1F50B;", "Battery", "Akku", "ct002/#battery");
    if (ui_de) {
        webNumber(ct_e_offset, -200, 200, "Offset [W]");
        webCheckbox(ct_e_tweak, "Aktive Regelung");
        webNumber(ct_e_trim, 0, 100, "Import-Trim [W]");
        webNumber(ct_e_pace, 0, 300, "Schrittweite [W]");
        webNumber(ct_e_mindc, 0, 200, "Mindestabgabe DC [W]");

        uiHead("&#x2696;&#xFE0F;", "Several batteries", "Mehrere Akkus", "ct002/#multi");
        webCheckbox(ct_e_fair, "Last verteilen");
        webCheckbox(ct_e_sat, "Sättigung erkennen");
    } else {
        webNumber(ct_e_offset, -200, 200, "Offset [W]");
        webCheckbox(ct_e_tweak, "Active control");
        webNumber(ct_e_trim, 0, 100, "Import trim [W]");
        webNumber(ct_e_pace, 0, 300, "Ramp step [W]");
        webNumber(ct_e_mindc, 0, 200, "Min DC output [W]");

        uiHead("&#x2696;&#xFE0F;", "Several batteries", "Mehrere Akkus", "ct002/#multi");
        webCheckbox(ct_e_fair, "Share the load");
        webCheckbox(ct_e_sat, "Saturation detection");
    }

    // No Marstek block here - the account lives on /ctreg, reachable from the
    // main menu button. Having it twice only invites editing the stale copy.
}

// From JsonCall(): appended to the SENSOR telemetry.
// ─── The emulator's own settings page ──────────────────────────────────────
// Page 4 and the link that leads to it. Both belong here rather than in the
// two programs: only the program's own name and version differ, and those come
// in as arguments because ct002_common.tc is included before the programs
// declare them.
//
// The version parameter is char[] and BOTH programs must declare sml_vers as
// char[] too. TinyC decides the packing from the declared PARAMETER type, so a
// byte[] handed to this would be read four bytes per character - silently.
void ctPageLink() {
    if (ui_de) webSend("<div style='margin:8px 0'>&#x1F50B; <a href='/tc_ui?p=4'>CT &amp; Akku &ndash; Emulator und Regelung</a></div>");
    else       webSend("<div style='margin:8px 0'>&#x1F50B; <a href='/tc_ui?p=4'>CT &amp; battery &ndash; emulator and control</a></div>");
}

void ctPage4(char prog[], char vers[]) {
    sml_panel_open("&#x1F50B;", "CT &amp; battery", "CT &amp; Akku");
    ctPanel();
    // Credit, deliberately English in both languages - it names a project and
    // a person. Same size and colour as the version footer below.
    webSend("<div style='text-align:center;font-size:10px;color:#555;line-height:1.5;margin-top:10px'>CT/battery control optimisations/options taken from the AstraMeter project. Thanks to tomquist.</div>");
    webSend("<hr>");
    uiSaveButton();
    uiUptime();
    sprintf(sml_buf, "%s &middot; Version %s<br>", prog, vers);
    webSend(sml_buf);
    webSend("by <a href='https://ottelo.jimdofree.com' target='_blank'>ottelo.jimdofree.com</a> &amp; gemu2015 (TinyC <span id='tcv'>...</span>)</div></div>");
}

void ctJson() {
    int live = 0;
    int i = 0;
    for (i = 0; i < CT_NSLOT; i = i + 1) {
        if (ct_sused[i] == 1) live = live + 1;
    }
    // "Power", not "Total": Home Assistant's Tasmota integration maps key
    // names, and "Total" is its energy key - the watts showed up as kWh.
    sprintf(ct_buf, ",\"CT002\":{\"Power\":%d", ct_ptot);
    sprintfAppend(ct_buf, ",\"L1\":%d,\"L2\":%d,\"L3\":%d", ct_pa, ct_pb, ct_pc);
    sprintfAppend(ct_buf, ",\"Slaves\":%d}", live);
    responseAppend(ct_buf);
}

int ctWebOn(int h) {
    if (h != ct_webnum) return 0;


    // byte[]: needs firmware >= 1.6.64. webArg() wrote int32 slots into it until
    // then - the mail arrived as "o" - and the compiler now stamps abi_rev 28
    // for this argument, so an older device refuses the .tcb instead of
    // corrupting its heap.
    byte a[96];

    // Poller status query: text only, no side effects.
    // Format "<status>|<ct-mac>|<busy>"
    if (webArg("st", a) > 0) {
        strcpy(ct_buf, ct_msg);
        strcat(ct_buf, "|");
        if (strlen(ct_mac) == 12) {
            strcat(ct_buf, ct_mac);
        } else {
            strcat(ct_buf, "(none yet)");
        }
        if (ct_busy == 1) {
            strcat(ct_buf, "|1");
        } else {
            strcat(ct_buf, "|0");
        }
        if (ct_okflag == 1) {
            strcat(ct_buf, "|1");
        } else {
            strcat(ct_buf, "|0");
        }
        webSend(ct_buf);
        return 1;
    }

    int act = 0;
    if (webArg("do", a) > 0) {
        if (strcmp(a, "login")  == 0) act = 1;
        if (strcmp(a, "create") == 0) act = 2;
        if (strcmp(a, "clear")  == 0) act = 3;
    }
    if (webArg("mail", a) > 0) {
        strcpy(ct_mail, a);
        // Deferred when a cloud job follows: saveVars() writes the whole .pvs
        // through LittleFS, and that buffer costs the contiguous block the TLS
        // handshake needs moments later. Measured: maxblk 11164 -> 9116, 16 ms
        // before the login. ctTask() saves once the job is done.
        if (act > 0) ct_savemail = 1;
        else         saveVars();
    }
    // An empty field keeps the cached password, so step 2 does not need it
    // typed again.
    if (webArg("pw", a) > 0) {
        strcpy(ct_pass, a);
        ct_pts = millis();
    }
    if (act == 3) {                     // clear the local CT MAC, cloud untouched
        strcpy(ct_mac, "");
        strcpy(ct_msg, "CT MAC cleared (cloud device remains)");
        ct_okflag = 0;
        saveVars();
        webSend("<html><head><meta charset='utf-8'></head><body><script>location.replace('/ctreg');</script></body></html>");
        return 1;
    }
    if (act > 0) {
        if (ct_busy == 1) {
            strcpy(ct_msg, "Another job is running");
        } else {
            ct_rreq = act;
            strcpy(ct_msg, "requested, running ...");
        }
        // Post/Redirect/Get - without it every reload asks to resubmit the
        // form and keeps showing the stale answer.
        webSend("<html><head><meta charset='utf-8'></head><body><script>location.replace('/ctreg');</script></body></html>");
        return 1;
    }

    webSend("<html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Marstek account</title>");
    webSend("<style>body{font-family:sans-serif;background:#252525;color:#eaeaea;margin:0;padding:16px}");
    webSend(".p{max-width:360px;margin:0 auto;background:#f0f0f0;color:#000;padding:18px;border:2px solid #ccc;border-radius:6px}");
    webSend("h3{margin:0 0 10px;font-size:16px}label{display:block;margin:10px 0 4px;font-size:13px}");
    webSend("input[type=text],input[type=password]{width:100%;box-sizing:border-box;padding:6px}");
    webSend("button{padding:8px 12px;border-radius:4px;margin:8px 0;width:100%}");
    webSend(".n{font-size:12px;color:#444;line-height:1.35;margin:8px 0}.w{font-size:12px;color:#a00;line-height:1.35;margin:8px 0}");
    webSend("a.i{text-decoration:none;margin-left:6px}");
    webSend(".s{background:#fff;border:1px solid #bbb;padding:8px;font-size:13px;margin-top:10px}");
    webSend(".s.ok{background:#e6f6e6;border-color:#5f9e5f;color:#155f15}</style></head><body><div class='p'>");
    webSend("<h3>&#x2601;&#xFE0F; Marstek</h3>");
    uiI("ct002/#marstek");
    uiText("<div class='n'>The battery only talks to a CT that exists in your Marstek account.</div>",
           "<div class='n'>Der Akku spricht nur mit einem CT, das im Marstek-Konto existiert.</div>");

    webSend("<form method='post' action='/ctreg'>");
    sprintf(ct_buf, "<label>Mail</label><input type='text' name='mail' value='%s'>", ct_mail);
    webSend(ct_buf);
    uiText("<label>Password</label>", "<label>Passwort</label>");
    webSend("<input type='password' name='pw' value=''>");
    if (strlen(ct_pass) > 0) {
        uiText("<div class='n'>Password kept for 10 min. Leave empty to reuse.</div>",
               "<div class='n'>Passwort 10 min gemerkt. Leer lassen zum Wiederverwenden.</div>");
    }
    uiText("<div class='w'>&#x26A0;&#xFE0F; Plain text over your LAN. Never stored on flash.</div>",
           "<div class='w'>&#x26A0;&#xFE0F; Klartext im LAN. Wird nie auf Flash gespeichert.</div>");
    uiText("<button type='submit' name='do' value='login'>1. Log in</button>",
           "<button type='submit' name='do' value='login'>1. Anmelden</button>");
    // Create stays out of reach while a MAC is set - ctDoCreate() refuses too,
    // but a disabled button says so before the click, not after.
    if (strlen(ct_mac) == 12) {
        uiText("<button type='submit' name='do' value='create' disabled>2. Create fake CT</button><div class='n'>A CT MAC is set. Clear it below first.</div>",
               "<button type='submit' name='do' value='create' disabled>2. Fake-CT anlegen</button><div class='n'>CT-MAC ist gesetzt. Unten erst loeschen.</div>");
    } else {
        uiText("<button type='submit' name='do' value='create' onclick='return confirm(\"Create a new CT in your Marstek account?\")'>2. Create fake CT</button>",
               "<button type='submit' name='do' value='create' onclick='return confirm(\"Neues CT im Marstek-Konto anlegen?\")'>2. Fake-CT anlegen</button>");
    }
    webSend("</form>");

    if (ct_okflag == 1) {
        sprintf(ct_buf, "<div class='s ok' id='stbox'><b>Status:</b> <span id='st'>%s</span></div>", ct_msg);
    } else {
        sprintf(ct_buf, "<div class='s' id='stbox'><b>Status:</b> <span id='st'>%s</span></div>", ct_msg);
    }
    webSend(ct_buf);
    if (strlen(ct_mac) == 12) {
        sprintf(ct_buf, "<div class='s'><b>CT MAC:</b> <span id='mc'>%s</span></div>", ct_mac);
    } else {
        if (ui_de) strcpy(ct_buf, "<div class='s'><b>CT MAC:</b> <span id='mc'>(noch keine)</span></div>");
        else       strcpy(ct_buf, "<div class='s'><b>CT MAC:</b> <span id='mc'>(none yet)</span></div>");
    }
    webSend(ct_buf);
    if (strlen(ct_mac) == 12) {
        uiText("<form method='post' action='/ctreg'><button type='submit' name='do' value='clear' onclick='return confirm(\"Clear the CT MAC here? The CT in your account stays.\")'>&#x274C; Clear CT MAC</button></form>",
               "<form method='post' action='/ctreg'><button type='submit' name='do' value='clear' onclick='return confirm(\"CT-MAC hier loeschen? Das CT im Konto bleibt.\")'>&#x274C; CT-MAC loeschen</button></form>");
    }
    uiText("<div><a href='/'><button type='button'>&#x2B05;&#xFE0F; Main menu</button></a></div>",
           "<div><a href='/'><button type='button'>&#x2B05;&#xFE0F; Hauptmenue</button></a></div>");
    // The cloud call runs in TaskLoop and is unfinished when this renders.
    // Chained setTimeout, not setInterval, so slow answers cannot stack.
    webSend("<script>function pl(){fetch('/ctreg?st=1',{cache:'no-store'}).then(function(r){return r.text();}).then(function(t){var p=t.split('|');");
    webSend("document.getElementById('st').textContent=p[0];document.getElementById('mc').textContent=p[1];");
    webSend("document.getElementById('stbox').className=(p[3]=='1')?'s ok':'s';})");
    webSend(".catch(function(){}).then(function(){setTimeout(pl,1500);});}setTimeout(pl,800);</script>");
    webSend("</div></body></html>");
    return 1;
}

int ctCmd(char cmd[]) {
    if (strcmp(cmd, "STAT") == 0) {
        sprintf(ct_buf, "rx=%d tx=%d bad=%d idx=%d", ct_rxc, ct_txc, ct_badc, ct_idx);
        responseCmnd(ct_buf);
        int i = 0;
        for (i = 0; i < CT_NSLOT; i = i + 1) {
            if (ct_sused[i] == 1) {
                addLog("CT002: slot %d %s ph=%d p=%d part=%d iv=%d",
                       i, ct_smac[i], ct_sph[i], ct_spwr[i], ct_spart[i], ct_siv[i]);
            }
        }
    } else if (strcmp(cmd, "CLR") == 0) {
        int i = 0;
        for (i = 0; i < CT_NSLOT; i = i + 1) {
            ct_sused[i] = 0;
        }
        responseCmnd("slots cleared");
    } else if (strStartsWith(cmd, "MAC ") == 1) {
        strSub(ct_buf, cmd, 4, 0);
        strTrim(ct_buf);
        strToLower(ct_buf);
        if (strlen(ct_buf) == 12 || strlen(ct_buf) == 0) {
            strcpy(ct_mac, ct_buf);
            saveVars();
            responseCmnd(ct_mac);
        } else {
            responseCmnd("12 hex chars expected (or empty for any)");
        }
    } else if (strStartsWith(cmd, "MAIL ") == 1) {
        strSub(ct_buf, cmd, 5, 0);
        strcpy(ct_mail, ct_buf);
        saveVars();
        responseCmnd(ct_mail);
    } else if (strStartsWith(cmd, "PASS ") == 1) {
        strSub(ct_buf, cmd, 5, 0);
        strcpy(ct_pass, ct_buf);
        responseCmnd("password set (not stored)");
    } else if (strcmp(cmd, "LOGIN") == 0) {
        ct_rreq = 1;
        responseCmnd("login requested");
    } else if (strcmp(cmd, "CREATE JA") == 0) {
        ct_rreq = 2;
        responseCmnd("create requested");
    } else {
        return 0;      // not ours - the wiring answers
    }
    return 1;
}
