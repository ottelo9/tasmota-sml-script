>D 180
;CT002 Emulator V1.1
cm=""
rx=""
r=""
tx=""
;d1-15 Summen, d16-55 Slots, d56-61 MAC
M:d=0 61
i=0
j=0
k=0
b=0
c=0
n=0
cs=0
v=0
ok=0
sg=1
a=0
f=0
p=0
e=0
ix=0
up=0
t=0
g=0
cl=0
mt=-30
>B
->SetOption57 0
->sensor53 r
smlj=9

;Fehler max. alle 30s per MQTT
#perr
g=upsecs-mt
if g>=30 {
mt=upsecs
=>Publish2 stat/%topic%/CTDiag {"error":"invalid_power","uptime":%0upsecs%}
}

>F
;UDP-Rahmen pruefen
if up==0 {
break
}
rx=udp(1)
n=sl(rx)
if n==0 {
break
}
if n<12 {
break
}
if n>=179 {
break
}
c=asc(rx)
j=asc(sb(rx 1 1))
b=asc(sb(rx -3 1))
if c!=1 {
break
}
if j!=2 {
break
}
if b!=3 {
break
}
j=ins(rx "|")
if j<3 {
break
}
r=sb(rx 2 j-2)
if r!=s(0n) {
break
}
r=sb(rx 0 n-2)
cs=0
for i 0 (sl(r)-1) 1
cs=cs^asc(sb(r i 1))
next
r=sb(rx -2 2)
if sb(r 0 1)==" " {
if cs>=16 {
break
}
r="0"+sb(r 1 1)
}
for i 0 1 1
if ins("0123456789abcdefABCDEF" sb(r i 1))<0 {
return 0
}
next
if hd(r)!=cs {
break
}
rx=sb(rx j+1 (n-j-4))+"|"
;Felder ohne Stringkopien lesen
r=st(rx '|' 1)
tx=r
if sl(tx)<1 {
break
}
if sl(tx)>10 {
break
}
r=st(rx '|' 2)
if sl(r)!=12 {
break
}
for i 1 6 1
j=(i-1)*2
d[55+i]=hd(sb(r j 2))
next
r=st(rx '|' 3)
if r!="HME-4" {
break
}
cm=st(rx '|' 4)
;CT-MAC klein schreiben
cl=sl(cm)
if cl!=12 {
break
}
r=""
for i 0 (cl-1) 1
c=asc(sb(cm i 1))
if c>=65 {
if c<=70 {
c+=32
}
}
r+=tc(c)
next
cm=r
;Modus x/A/B/C/Total
r=st(rx '|' 5)
f=1
if sl(r)==1 {
c=ins("ABCDabcd" r)
if c>=0 {
f=c%4
f+=2
}
}
;Leistung mit Vorzeichen
r=st(rx '|' 6)
v=0
sg=1
a=0
ok=1
if sb(r 0 1)=="-" {
sg=-1
a=1
}
if sl(r)<=a {
=#perr
break
}
for i a (sl(r)-1) 1
c=asc(sb(r i 1))
if c<48 {
ok=0
}
if c>57 {
ok=0
}
v=v*10+c-48
next
if ok==0 {
=#perr
break
}
p=v*sg
if p<-32768 {
=#perr
break
}
if p>32767 {
=#perr
break
}
;Teilnahme, leer=aktiv
r=st(rx '|' 7)
e=1
if r!="" {
e=0
ok=1
for i 0 (sl(r)-1) 1
c=asc(sb(r i 1))
if c<48 {
ok=0
}
if c>57 {
ok=0
}
e=e*10+c-48
next
if ok==0 {
break
}
if e>255 {
break
}
}
t=upsecs
;4 Akkus nach MAC
k=0
v=0
for j 1 4 1
b=16+((j-1)*10)
g=t-d[b+3]
if g>30 {
d[b]=0
}
if d[b]==0 {
v=j
}
ok=1
if d[b]==0 {
ok=0
}
if d[b+4]!=d[56] {
ok=0
}
if d[b+5]!=d[57] {
ok=0
}
if d[b+6]!=d[58] {
ok=0
}
if d[b+7]!=d[59] {
ok=0
}
if d[b+8]!=d[60] {
ok=0
}
if d[b+9]!=d[61] {
ok=0
}
if ok==1 {
k=j
}
next
if k==0 {
k=v
}
if k==0 {
break
}
b=16+((k-1)*10)
for i 1 6 1
d[b+3+i]=d[55+i]
next
d[b]=f
d[b+1]=p
d[b+2]=e
d[b+3]=t
;Teilnehmer und Leistungen summieren
for i 1 15 1
d[i]=0
next
for k 1 4 1
b=16+((k-1)*10)
if d[b]>0 {
if d[b+2]!=0 {
f=d[b]
d[f]+=1
g=d[b+1]
if g<0 {
d[5+f]+=g
}
if g>=0 {
d[10+f]+=g
}
}
}
next
;Saldo als A und Total
r=tx
tx="|HME-4|"+cm+"|"+r+"|"
for i 1 6 1
tx+=hn(d[55+i])
next
ix=(ix+1)%256
tx+="|"+s(0sml[1])+"|0|0|"+s(0sml[1])
for i 2 5 1
tx+="|"+s(0d[i])
next
tx+="|-50|"+s(0ix)
for i 1 5 1
if d[5+i]<-32768 {
d[5+i]=-32768
}
tx+="|"+s(0d[5+i])
next
for i 1 5 1
if d[10+i]>32767 {
d[10+i]=32767
}
tx+="|"+s(0d[10+i])
next
;Antwort bilden
n=sl(tx)+5
n=sl(tx)+5+sl(s(0n))
n=sl(tx)+5+sl(s(0n))
if n>=179 {
break
}
rx=tc(1)
rx+=tc(2)
rx+=s(0n)
rx+=tx
rx+=tc(3)
cs=0
for i 0 (sl(rx)-1) 1
cs=cs^asc(sb(rx i 1))
next
rx+=hn(cs)
udp(2 rx)
>S
;UDP-Port oeffnen
if wifis==0 {
up=0
} else {
if up==0 {
up=udp(0 12345)
}
}
>W
CT Type{m}CT002
CT MAC{m}%cm%
Mode A/B/C/D{m}%0d[2]%/%0d[3]%/%0d[4]%/%0d[5]%
$<small>CT-Emu V1.1 Script: %0slen% / 4096</small>

>M 1
+1,3,s,0,9600,DTZ541,1
1,77070100100700ff@1,Leistung,W,curr_w,0
1,77070100010800ff@1000,Verbrauch,kWh,total_kwh,2
1,77070100020800ff@1000,Einspeisung,kWh,export_total_kwh,2
#
